<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spotify Basic Pitch note-detection model (Apache 2.0), copied next to the app as Models\basic-pitch.onnx. -->
    <None Include="Sounds\Models\basic-pitch.onnx" Link="Models\basic-pitch.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Sounds\Models\NOTICE-basic-pitch.txt" Link="Models\NOTICE-basic-pitch.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The field registry: what the app knows about each DAW's file format (see Formats/FormatRegistry.cs). -->
    <EmbeddedResource Include="Formats\Registry\*.json" LogicalName="MusicOrganiser.Formats.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scripts that link the app with Bitwig and FL Studio, copied next to the app; Settings installs them in each DAW. -->
    <None Include="..\..\extensions\bitwig\MusicOrganiser.control.js" Link="Extensions\Bitwig\MusicOrganiser.control.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\extensions\fl-studio\device_MusicOrganiser.py" Link="Extensions\FL Studio\device_MusicOrganiser.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The plugin scanner (C++), built with CMake and copied next to the app. -->
  <Import Project="..\..\native\MusicOrganiser.Native.targets" />
  <!-- The Bitwig extension (Java), built with Maven when there's a JDK and copied next to the app. -->
  <Import Project="..\..\extensions\bitwig-java\MusicOrganiser.BitwigExtension.targets" />

</Project>
