<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spotify Basic Pitch note-detection model (Apache 2.0), copied next to the app as Models\basic-pitch.onnx. -->
    <None Include="Sounds\Models\basic-pitch.onnx" Link="Models\basic-pitch.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Sounds\Models\NOTICE-basic-pitch.txt" Link="Models\NOTICE-basic-pitch.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The plugin scanner (C++), built with CMake and copied next to the app. -->
  <Import Project="..\..\native\MusicOrganiser.Native.targets" />

</Project>
