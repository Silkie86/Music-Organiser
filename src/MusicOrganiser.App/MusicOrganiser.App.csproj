<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MusicOrganiser</AssemblyName>
    <RootNamespace>MusicOrganiser.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lets the project build on non-Windows machines too (it only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicOrganiser.Core\MusicOrganiser.Core.csproj" />
  </ItemGroup>

</Project>
