<ui:FluentWindow x:Class="MusicOrganiser.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:MusicOrganiser.ViewModels;assembly=MusicOrganiser.ViewModels"
                 xmlns:views="clr-namespace:MusicOrganiser.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="Music Organiser" Width="1440" Height="900" MinWidth="1080" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{StaticResource AppBackgroundBrush}"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><views:ProjectsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PluginsViewModel}"><views:PluginsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SamplesViewModel}"><views:SamplesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SoundsViewModel}"><views:SoundsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,44,14,16">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="30" Height="30" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFA394FF" Offset="0" />
                                <GradientStop Color="#FF6B5BE6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Music Organiser" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Bitwig · FL Studio · Studio One" FontSize="11" Foreground="{StaticResource FaintBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Library status and scanning -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="LIBRARY" Style="{StaticResource FilterLabel}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ScanStatus}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        <ProgressBar Height="4" Margin="0,8,0,0" Value="{Binding ScanPercent}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Stop" Command="{Binding CancelScanCommand}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:Button Content="Scan for changes" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RescanCommand}"
                                       Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                       ToolTip="Look for new and changed projects in your folders" />
                            <ui:Button Content="Rescan everything" Appearance="Transparent" Command="{Binding FullRescanCommand}"
                                       Margin="0,4,0,0" HorizontalAlignment="Stretch" FontSize="12"
                                       Foreground="{StaticResource FaintBrush}"
                                       ToolTip="Re-read every project, even unchanged ones" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Column="1" Margin="28,40,28,20" Content="{Binding SelectedNav.Page}" />

        <ui:TitleBar Grid.ColumnSpan="2" Title="" VerticalAlignment="Top" />
    </Grid>
</ui:FluentWindow>
