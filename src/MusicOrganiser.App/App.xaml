<Application x:Class="MusicOrganiser.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:MusicOrganiser.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibility x:Key="BoolToVisibility" />
            <conv:BoolToVisibility x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:NullToVisibility x:Key="NullToVisibility" />
            <conv:NullToVisibility x:Key="NullToCollapsedInverse" Invert="True" />
            <conv:BoolToStar x:Key="BoolToStar" />
            <conv:RatingText x:Key="RatingText" />
            <conv:ZeroToVisibility x:Key="NonZeroToVisibility" />
            <conv:Stars x:Key="Stars" />
            <conv:FileSize x:Key="FileSize" />
            <conv:WaveformGeometry x:Key="WaveformGeometry" />
            <conv:Seconds x:Key="Seconds" />
            <conv:IndexToBool x:Key="IndexToBool" />

            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="2,0,0,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,16,0,8" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <SolidColorBrush x:Key="WarningBrush" Color="#FFE0A030" />
            <SolidColorBrush x:Key="MissingBrush" Color="#FFE05A5A" />
            <SolidColorBrush x:Key="OkBrush" Color="#FF5AC77A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
