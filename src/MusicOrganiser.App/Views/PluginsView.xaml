<UserControl x:Class="MusicOrganiser.App.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MusicOrganiser.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PluginsViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="FormatPill">
            <Border Style="{StaticResource Pill}">
                <TextBlock Text="{Binding Format}" Style="{StaticResource PillText}" Foreground="{StaticResource MutedBrush}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Width="260" Margin="0,0,12,0"
                          ItemsSource="{Binding Source={x:Static vm:PluginsViewModel.ShowChoices}}"
                          SelectedItem="{Binding Show}" />
                <ui:TextBox Width="300" PlaceholderText="Search plugins or vendors…" Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Plugins" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- The plugin lists -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,10,8,8">
            <Grid>
                <DataGrid x:Name="UsedGrid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                          SelectionChanged="OnSelectionChanged"
                          Visibility="{Binding ShowingUnused, Converter={StaticResource InverseBoolToVisibility}}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ShowProjectsCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Plugin" Width="2*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vendor" Width="*" SortMemberPath="Vendor">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Vendor}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Format" Width="80" SortMemberPath="Format"
                                                CellTemplate="{StaticResource FormatPill}" />
                        <DataGridTextColumn Header="Projects" Width="80" Binding="{Binding Projects}" />
                        <DataGridTemplateColumn Header="Used in" Width="*" SortMemberPath="Daws">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Daws}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="210" SortMemberPath="Installed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding Installed, Converter={StaticResource InverseBoolToVisibility}}">
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource MissingSoftBrush}" Margin="0,0,8,0">
                                            <TextBlock Text="Not installed" Style="{StaticResource PillText}" Foreground="{StaticResource MissingBrush}" />
                                        </Border>
                                        <ui:Button Content="Search online" Padding="9,3" FontSize="12"
                                                   Command="{Binding DataContext.SearchOnlineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid x:Name="UnusedGrid" ItemsSource="{Binding UnusedView}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                          Visibility="{Binding ShowingUnused, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Plugin" Width="1.5*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Format" Width="100" SortMemberPath="FormatsText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding FormatsText}" Style="{StaticResource PillText}" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Projects" Width="1.2*" Binding="{Binding UsageText}" />
                        <DataGridTemplateColumn Header="Where" Width="2*" SortMemberPath="Location">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Location}" Foreground="{StaticResource FaintBrush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Margin="2,10,0,0" FontSize="12" Style="{StaticResource Muted}" Text="{Binding Hint}" />

        <!-- What breaks if these go -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="400" Margin="12,0,0,0" Style="{StaticResource Card}"
                Visibility="{Binding HasImpact, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="IF YOU UNINSTALL" Style="{StaticResource FilterLabel}" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Impact.Headline}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Impact.Detail}" FontSize="12" Style="{StaticResource Muted}"
                           Margin="0,0,0,14" />

                <TextBlock DockPanel.Dock="Top" Text="INSTALLED COPIES" Style="{StaticResource FilterLabel}" />
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Impact.Copies}" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <ui:Button DockPanel.Dock="Right" Content="Show" Padding="9,3" FontSize="12" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Command="{Binding DataContext.RevealCopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <StackPanel>
                                    <WrapPanel>
                                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding File.Format}" Style="{StaticResource PillText}"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding UsageText}" FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Unused}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding File.Path}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding File.Path}" Foreground="{StaticResource FaintBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Button DockPanel.Dock="Bottom" Content="Show these songs in the library" Margin="0,12,0,0"
                           HorizontalAlignment="Stretch" Command="{Binding ShowImpactProjectsCommand}"
                           Visibility="{Binding Impact.Songs.Count, Converter={StaticResource NonZeroToVisibility}}" />
                <TextBlock DockPanel.Dock="Top" Text="SONGS" Style="{StaticResource FilterLabel}"
                           Visibility="{Binding Impact.Songs.Count, Converter={StaticResource NonZeroToVisibility}}" />
                <ListBox ItemsSource="{Binding Impact.Songs}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource QuietListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Background="Transparent" ToolTip="Double-click to show it in the library">
                                <StackPanel.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding DataContext.OpenImpactSongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </StackPanel.InputBindings>
                                <TextBlock Text="{Binding Song}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DetailText}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MutedBrush}" ToolTip="{Binding Latest.Path}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
