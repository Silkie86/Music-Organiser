<ui:FluentWindow x:Class="MusicOrganiser.App.Views.PresetsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:MusicOrganiser.App.ViewModels"
                 xmlns:views="clr-namespace:MusicOrganiser.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:PresetsViewModel}"
                 Title="{Binding Title, StringFormat='Presets in {0}'}" Width="680" Height="600" MinWidth="480" MinHeight="360"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, StringFormat='Presets in {0}'}" />

        <DockPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
            <ui:Button DockPanel.Dock="Right" Content="Export these" Appearance="Primary"
                       Icon="{ui:SymbolIcon ArrowExportLtr24}" Command="{Binding ExportShownCommand}"
                       IsEnabled="{Binding HasPresets}" ToolTip="Export every preset in the list as it's filtered now" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding FormatNote}" Margin="16,8,16,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding FormatNote, Converter={StaticResource NullToVisibility}}" />
        <WrapPanel DockPanel.Dock="Top" Margin="16,4,16,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,32,6"
                        Visibility="{Binding HasNative, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Plugins" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <RadioButton GroupName="Maker" Content="{Binding AllMakersText}" MinWidth="0" Margin="0,0,8,0"
                             IsChecked="{Binding Maker, Converter={StaticResource IndexToBool}, ConverterParameter=0}" />
                <RadioButton GroupName="Maker" Content="{Binding ThirdPartyText}" MinWidth="0" Margin="0,0,8,0"
                             IsChecked="{Binding Maker, Converter={StaticResource IndexToBool}, ConverterParameter=1}" />
                <RadioButton GroupName="Maker" Content="{Binding NativeText}" MinWidth="0"
                             IsChecked="{Binding Maker, Converter={StaticResource IndexToBool}, ConverterParameter=2}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                        Visibility="{Binding HasKinds, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <RadioButton GroupName="Type" Content="{Binding AllTypesText}" MinWidth="0" Margin="0,0,8,0"
                             IsChecked="{Binding Type, Converter={StaticResource IndexToBool}, ConverterParameter=0}" />
                <RadioButton GroupName="Type" Content="{Binding SynthsText}" MinWidth="0" Margin="0,0,8,0"
                             IsChecked="{Binding Type, Converter={StaticResource IndexToBool}, ConverterParameter=1}" />
                <RadioButton GroupName="Type" Content="{Binding EffectsText}" MinWidth="0"
                             IsChecked="{Binding Type, Converter={StaticResource IndexToBool}, ConverterParameter=2}" />
            </StackPanel>
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Margin="16,4,16,8"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ListBox ItemsSource="{Binding Presets}" SelectionMode="Extended" Margin="12,0,8,0"
                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DragRow}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                 views:FileDrag.Source="{Binding}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PresetRow}">
                        <DockPanel ToolTip="{Binding LoadHint}">
                            <ui:Button DockPanel.Dock="Right" Content="Export" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Command="{Binding ExportCommand}" ToolTip="Save just this preset" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Plugin}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding Plugin, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Details}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</ui:FluentWindow>
