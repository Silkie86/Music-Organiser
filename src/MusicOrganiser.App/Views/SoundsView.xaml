<UserControl x:Class="MusicOrganiser.App.Views.SoundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MusicOrganiser.App.ViewModels"
             xmlns:views="clr-namespace:MusicOrganiser.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SoundsViewModel}">
    <UserControl.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Border VerticalAlignment="Center" Margin="0,0,12,0" Padding="12,8" CornerRadius="8" Width="300"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <ProgressBar Height="4" Margin="0,6,0,0" Value="{Binding BusyPercent}" />
                    </StackPanel>
                </Border>
                <ui:Button Content="Stop" Command="{Binding CancelCommand}" Margin="0,0,6,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Deep listen" Icon="{ui:SymbolIcon BrainCircuit24}" Command="{Binding DeepListenCommand}" Margin="0,0,6,0"
                           ToolTip="Let the sound-understanding model hear every sound (unlocks search by description)"
                           Visibility="{Binding ClapInstalled, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Scan sample folders" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding ScanCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Sound Lab" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="{StaticResource AccentFaintBrush}"
                Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <TabControl Grid.Row="2" Margin="0,14,0,0">
            <!-- ============ Library ============ -->
            <TabItem Header="Library">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Filters -->
                    <Border Style="{StaticResource Card}" Padding="12,14" Margin="0,0,16,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="TYPE" Style="{StaticResource FilterLabel}" />
                            <ListBox ItemsSource="{Binding TypeCounts}" SelectedItem="{Binding SelectedType}" MaxHeight="320"
                                     ItemContainerStyle="{StaticResource QuietListItem}" Background="Transparent" BorderThickness="0" />
                            <TextBlock Text="LENGTH" Style="{StaticResource FilterLabel}" Margin="2,16,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="All" IsChecked="{Binding LoopFilter, Converter={StaticResource IndexToBool}, ConverterParameter=0}" MinWidth="0" Margin="0,0,8,0" />
                                <RadioButton Content="Hits" IsChecked="{Binding LoopFilter, Converter={StaticResource IndexToBool}, ConverterParameter=1}" MinWidth="0" Margin="0,0,8,0" />
                                <RadioButton Content="Loops" IsChecked="{Binding LoopFilter, Converter={StaticResource IndexToBool}, ConverterParameter=2}" MinWidth="0" />
                            </StackPanel>
                            <TextBlock Text="KEY" Style="{StaticResource FilterLabel}" Margin="2,16,0,6" />
                            <ComboBox ItemsSource="{x:Static vm:SoundsViewModel.KeyChoices}" SelectedItem="{Binding KeyFilter}" />
                            <CheckBox Content="Include keys that mix well" IsChecked="{Binding CompatibleKeys}" Margin="0,4,0,0" />
                            <TextBlock Text="BPM" Style="{StaticResource FilterLabel}" Margin="2,16,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox PlaceholderText="from" Text="{Binding BpmFrom, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1" Text="–" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" />
                                <ui:TextBox Grid.Column="2" PlaceholderText="to" Text="{Binding BpmTo, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <CheckBox Content="Never used in a project" IsChecked="{Binding OnlyUnused}" Margin="0,12,0,0" />
                            <CheckBox Content="Favourites" IsChecked="{Binding OnlyFavourites}" />
                            <TextBlock Text="TAG" Style="{StaticResource FilterLabel}" Margin="2,16,0,6" />
                            <ui:TextBox PlaceholderText="any tag" Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Content="Clear filters" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                                       Command="{Binding ClearFiltersCommand}" Margin="0,14,0,0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </ScrollViewer>
                    </Border>

                    <!-- List -->
                    <DockPanel Grid.Column="1">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <ToggleButton DockPanel.Dock="Right" Content="Describe it" IsChecked="{Binding DescribeMode}" Margin="8,0,0,0"
                                          ToolTip="Search by describing the sound, e.g. “dusty vinyl snare” or “dark gritty reese”. Press Enter to search." />
                            <ui:TextBox PlaceholderText="Search names, types and tags… or switch on Describe it" Icon="{ui:SymbolIcon Search24}"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="8,10,8,8">
                        <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Extended" views:FileDrag.Source="{Binding}"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Space" Command="{Binding PlayCommand}" />
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PlayCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="32" SortMemberPath="Favourite">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Favourite, Converter={StaticResource BoolToStar}}" Foreground="{StaticResource WarningBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Sound" Width="2*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Type" Width="100" Binding="{Binding Type}" />
                                <DataGridTextColumn Header="Key" Width="55" Binding="{Binding Key}" />
                                <DataGridTextColumn Header="BPM" Width="58" Binding="{Binding Bpm, StringFormat={}{0:0.#}}" />
                                <DataGridTextColumn Header="Note" Width="55" Binding="{Binding RootNote}" />
                                <DataGridTextColumn Header="Length" Width="60" Binding="{Binding Seconds, Converter={StaticResource Seconds}}" SortMemberPath="Seconds" />
                                <DataGridTemplateColumn Header="Character" Width="*" SortMemberPath="Character">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Character}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Used" Width="50" Binding="{Binding UsedIn}" />
                                <DataGridTemplateColumn Header="Folder" Width="*" SortMemberPath="Folder">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Folder}" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                    </DockPanel>

                    <!-- Selected sound -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="0">
                    <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                                Visibility="{Binding Selected, Converter={StaticResource NullToCollapsedInverse}}">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36"
                                   Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Pick a sound" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Press Space or double-click to play. Its key, notes, tags and sound-alikes show up here."
                                   Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="260" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}}">
                        <StackPanel Margin="20,18,20,20">
                            <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Selected.Path}" Style="{StaticResource Muted}" FontSize="12" />
                            <Border Height="84" Margin="0,12,0,4" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}">
                                <views:WaveformView Peaks="{Binding Selected.Analysis.Waveform}" Duration="{Binding WaveSeconds}"
                                                    Position="{Binding PlayPosition}" SeekCommand="{Binding SeekCommand}" Margin="8" />
                            </Border>
                            <TextBlock Text="Click the waveform to play from any point. Drag the sound from the list into your DAW."
                                       Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,10" />
                            <WrapPanel>
                                <ui:Button Content="Play" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding PlayCommand}" Margin="0,0,6,6" />
                                <ui:Button Icon="{ui:SymbolIcon Star24}" Command="{Binding ToggleFavouriteCommand}" ToolTip="Favourite" Margin="0,0,6,6" />
                                <ui:Button Content="Show file" Command="{Binding RevealCommand}" Margin="0,0,6,6" />
                                <ui:Button Content="Projects using it" Command="{Binding ShowProjectsCommand}" Margin="0,0,6,6"
                                           Visibility="{Binding Selected.UsedIn, Converter={StaticResource NonZeroToVisibility}}" />
                            </WrapPanel>

                            <TextBlock Text="What it is" Style="{StaticResource SectionHeader}" Margin="0,8,0,4" />
                            <DockPanel>
                                <TextBlock Text="This is a" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{x:Static vm:SoundsViewModel.AllTypes}" SelectedItem="{Binding SelectedTypeLabel}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0">
                                <Run Text="Type from:" />
                                <Run Text="{Binding Selected.TypeSource, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Selected.Character, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="Pitch, key and chords" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding KeyDetail}" TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap" Visibility="{Binding Selected.RootNote, Converter={StaticResource NullToVisibility}}">
                                <Run Text="Root note:" /> <Run Text="{Binding Selected.RootNote, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Visibility="{Binding Selected.Chord, Converter={StaticResource NullToVisibility}}">
                                <Run Text="Chord:" /> <Run Text="{Binding Selected.Chord, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Selected.Analysis.Chords}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,4,4" Padding="6,2" CornerRadius="3" Background="{StaticResource SurfaceRaisedBrush}"
                                                ToolTip="{Binding Start, StringFormat='from {0:0.0}s'}">
                                            <TextBlock Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,6,0,0">
                                <ui:Button Content="Detect notes" Icon="{ui:SymbolIcon MusicNote224}" Command="{Binding DetectNotesCommand}" Margin="0,0,6,0"
                                           ToolTip="Transcribe the notes with the Basic Pitch model (runs on this PC)" />
                                <ui:Button Content="Save as MIDI" Command="{Binding ExportMidiCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding NotesMessage}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Visibility="{Binding NotesMessage, Converter={StaticResource NullToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Notes}" MaxHeight="140">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,10,2" FontFamily="Consolas">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Start, StringFormat=' @{0:0.00}s', Mode=OneWay}"
                                                                                                                 Foreground="{StaticResource MutedBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Tags" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Selected.Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,4,4" Padding="8,2,2,2" CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                <ui:Button Content="✕" Padding="4,0" Margin="4,0,0,0" Appearance="Transparent"
                                                           Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,4,0,0">
                                <ui:Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddTagCommand}" Margin="6,0,0,0" />
                                <ui:TextBox PlaceholderText="Add a tag (e.g. dusty, signature)" Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddTagCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                            </DockPanel>

                            <TextBlock Text="Sounds like this" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Similar}" views:FileDrag.Source="{Binding}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <ui:Button DockPanel.Dock="Left" Padding="6,2" Icon="{ui:SymbolIcon Play24}" ToolTip="Play / stop" Margin="0,0,6,0"
                                                       Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Sound}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Score, StringFormat={}{0:P0}}" Style="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Sound.Name, Mode=OneWay}" /> <Run Text="{Binding Sound.Type, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Rediscover ============ -->
            <TabItem Header="Rediscover" DataContext="{Binding Rediscover}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Sounds you haven't used much, picked to fit your taste and kept varied." Style="{StaticResource Muted}" />
                            <WrapPanel Margin="0,8,0,8">
                                <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Width="170" Margin="0,0,12,0" />
                                <TextBlock Text="Safe" VerticalAlignment="Center" />
                                <Slider Width="140" Minimum="0" Maximum="1" Value="{Binding Adventure}" Margin="8,0" VerticalAlignment="Center"
                                        ToolTip="How adventurous: left sticks close to what you already use, right goes further afield" />
                                <TextBlock Text="Adventurous" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <CheckBox Content="Include sounds used once" IsChecked="{Binding IncludeRarelyUsed}" Margin="0,0,12,0" />
                                <ui:Button Content="Shuffle" Appearance="Primary" Icon="{ui:SymbolIcon ArrowShuffle24}" Command="{Binding ShuffleCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Intro}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                        </StackPanel>
                        <Border Style="{StaticResource Card}" Padding="8">
                        <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Suggestions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE8B1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36"
                                       Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Find sounds you've forgotten" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="Pick a type and how adventurous to be, then press Shuffle." Style="{StaticResource Muted}" TextAlignment="Center" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Suggestions}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource QuietListItem}" SelectionMode="Extended"
                                 views:FileDrag.Source="{Binding Parent}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <ui:Button DockPanel.Dock="Left" Padding="6,2" Icon="{ui:SymbolIcon Play24}" ToolTip="Play / stop" Margin="0,0,10,0"
                                                   Command="{Binding DataContext.Parent.PlayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   CommandParameter="{Binding Sound}" />
                                        <ui:Button DockPanel.Dock="Right" Content="Open" Padding="8,2" Margin="8,0,0,0"
                                                   Command="{Binding DataContext.Parent.RevealCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   CommandParameter="{Binding Sound}" />
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Sound.Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Sound.Type, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                                <Run Text="{Binding Sound.Key, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                        </Border>
                    </DockPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Forgotten folders" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Text="Sample folders by how much of them your projects use." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding Folders}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource QuietListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                                            <Run Text="{Binding Used, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding Sounds, Mode=OneWay}" /> <Run Text="sounds used" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Kit builder ============ -->
            <TabItem Header="Kit builder" DataContext="{Binding Kit}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <ui:Button Content="Roll a kit" Appearance="Primary" Icon="{ui:SymbolIcon ArrowShuffle24}" Command="{Binding RollCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Export kit" Icon="{ui:SymbolIcon FolderArrowRight24}" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                            <Border Style="{StaticResource DragChip}" views:FileDrag.Source="{Binding}"
                                    views:FileDrag.AllOf="{Binding ElementName=KitSlots}" Margin="0,0,12,0"
                                    ToolTip="Drag the whole kit into your DAW or sampler, pads in order (exported with the options on the right)">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Drag kit" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                        </WrapPanel>
                        <ItemsControl x:Name="KitSlots" ItemsSource="{Binding Slots}" views:FileDrag.Source="{Binding}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="110" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ui:Button DockPanel.Dock="Left" Padding="6,2" Icon="{ui:SymbolIcon Play24}" ToolTip="Play / stop" Margin="0,0,10,0"
                                                       Command="{Binding DataContext.PlaySlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button DockPanel.Dock="Right" Content="✕" Padding="6,2" Margin="6,0,0,0" ToolTip="Remove this pad"
                                                       Command="{Binding DataContext.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowSync24}" Padding="6,2" Margin="6,0,0,0" ToolTip="Re-roll just this pad"
                                                       Command="{Binding DataContext.RollOneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <CheckBox DockPanel.Dock="Right" Content="Lock" IsChecked="{Binding Locked}" MinWidth="0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SoundName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="How to pick" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                            <CheckBox Content="Favour sounds I haven't used" IsChecked="{Binding PreferUnused}" />
                            <CheckBox Content="Keep it to one pack" IsChecked="{Binding SamePack}" />
                            <TextBlock Text="Vibe (needs deep listening)" Style="{StaticResource FilterLabel}" Margin="2,10,0,4" />
                            <ui:TextBox PlaceholderText="e.g. dusty lo-fi, hard techno, 90s boom bap" Text="{Binding Vibe, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Key for bass and 808 pads" Style="{StaticResource FilterLabel}" Margin="2,10,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:SoundsViewModel.KeyChoices}" SelectedItem="{Binding Key}" />
                            <TextBlock Text="Randomness" Style="{StaticResource FilterLabel}" Margin="2,10,0,4" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Randomness}" />

                            <TextBlock Text="Add a pad" Style="{StaticResource FilterLabel}" Margin="2,12,0,4" />
                            <ComboBox x:Name="PadType" ItemsSource="{x:Static vm:SoundsViewModel.AllTypes}" SelectedIndex="0" />
                            <ui:Button Content="Add pad" Margin="0,4,0,0" Command="{Binding AddSlotCommand}" CommandParameter="{Binding SelectedItem, ElementName=PadType}" />

                            <TextBlock Text="Export" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
                            <CheckBox Content="Elektron ready (48 kHz, 16-bit WAV)" IsChecked="{Binding ElektronReady}"
                                      ToolTip="For Digitakt II and Analog Rytm MKII: drag the folder into Elektron Transfer" />
                            <CheckBox Content="Mono" IsChecked="{Binding Mono}" />
                            <CheckBox Content="Normalise" IsChecked="{Binding Normalise}" />
                            <TextBlock Text="Kits go to your export folder (Settings), under Kits, with a kit.txt listing the original files."
                                       Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Teach ============ -->
            <TabItem Header="Teach">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Margin="0,16,16,16">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Retrain now" Icon="{ui:SymbolIcon BrainCircuit24}"
                                           Command="{Binding RetrainCommand}" Margin="16,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="Sound types, learned from your library" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="The Sound Lab learns what kicks, snares, pads and the rest sound like from your own folders and file names, and from every label you correct. It then sorts the sounds whose names don't say. Your corrections count three times as much as folder names."
                                               Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding ModelSummary}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Worth a listen" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Sounds where what it hears disagrees with the name. Tell it which is right; it learns from your answer."
                                           Style="{StaticResource Muted}" Margin="0,4,0,10" />
                                <TextBlock Text="Nothing to check right now." Foreground="{StaticResource FaintBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Disagreements.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Disagreements}" views:FileDrag.Source="{Binding}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" CornerRadius="6" Margin="0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <ui:Button DockPanel.Dock="Left" Padding="6,2" Icon="{ui:SymbolIcon Play24}" ToolTip="Play / stop" Margin="0,0,10,0"
                                                               Appearance="Transparent"
                                                               Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding Sound}" />
                                                    <ui:Button DockPanel.Dock="Right" Content="{Binding Thinks}" ContentStringFormat="It's a {0}" Padding="8,2" Margin="6,0,0,0"
                                                               Command="{Binding DataContext.ConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button DockPanel.Dock="Right" Content="Name is right" Padding="8,2" Margin="6,0,0,0"
                                                               Command="{Binding DataContext.KeepNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Sound.Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Your own tags" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Tag at least five sounds with any word you like (dusty, signature, too clean…). On the next retrain it learns what they share and suggests the tag for other sounds."
                                           Style="{StaticResource Muted}" Margin="0,4,0,10" />
                                <TextBlock Text="No tags yet. Add one from a sound in the Library tab." Foreground="{StaticResource FaintBrush}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TagSummaries.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding TagSummaries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <ui:Button DockPanel.Dock="Right" Content="Show" Padding="8,2" Appearance="Transparent"
                                                           Command="{Binding DataContext.FilterByTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding Tag}" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource Pill}" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Tag}" Style="{StaticResource PillText}" Foreground="{StaticResource TextBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Sound-understanding model (CLAP)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="An open neural network from LAION trained on music and sound with descriptions. It lets you search by describing a sound, matches a kit to a vibe, and makes sound-alikes and type guesses sharper. It runs on this PC."
                                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ClapStatus}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding DownloadText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                    <ProgressBar Height="6" Margin="0,6,0,0" Maximum="100" Value="{Binding DownloadPercent}"
                                                 IsIndeterminate="{Binding DownloadSizeUnknown}" />
                                    <ui:Button Content="Stop" Command="{Binding CancelCommand}" Margin="0,8,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding ModelMessage}" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           Visibility="{Binding ModelMessage, Converter={StaticResource NullToVisibility}}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <ui:Button Content="Download model" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadModelCommand}" Margin="0,0,6,0"
                                               Appearance="Primary" IsEnabled="{Binding CanStartDownload}"
                                               Visibility="{Binding ClapInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ui:Button Content="Deep listen" Icon="{ui:SymbolIcon BrainCircuit24}" Command="{Binding DeepListenCommand}" Appearance="Primary"
                                               Visibility="{Binding ClapInstalled, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Note detection (Basic Pitch)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Spotify's open Basic Pitch model is built in. Use Detect notes on any sound in the Library tab to see its notes and chords and save them as MIDI."
                                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
