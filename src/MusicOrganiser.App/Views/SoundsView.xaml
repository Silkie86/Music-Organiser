<UserControl x:Class="MusicOrganiser.App.Views.SoundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MusicOrganiser.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SoundsViewModel}">
    <UserControl.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" MaxWidth="320" />
                    <ProgressBar Height="4" Margin="0,4,0,0" Value="{Binding BusyPercent}" />
                </StackPanel>
                <ui:Button Content="Stop" Command="{Binding CancelCommand}" Margin="0,0,6,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Deep listen" Icon="{ui:SymbolIcon BrainCircuit24}" Command="{Binding DeepListenCommand}" Margin="0,0,6,0"
                           ToolTip="Let the sound-understanding model hear every sound (unlocks search by description)"
                           Visibility="{Binding ClapInstalled, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Scan sample folders" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding ScanCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Sound Lab" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding Message}" Margin="0,6,0,0" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                   Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />

        <TabControl Grid.Row="2" Margin="0,10,0,0">
            <!-- ============ Library ============ -->
            <TabItem Header="Library">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="370" />
                    </Grid.ColumnDefinitions>

                    <!-- Filters -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Type" Style="{StaticResource FilterLabel}" />
                            <ListBox ItemsSource="{Binding TypeCounts}" SelectedItem="{Binding SelectedType}" MaxHeight="300" />
                            <TextBlock Text="Length" Style="{StaticResource FilterLabel}" Margin="2,12,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="All" IsChecked="{Binding LoopFilter, Converter={StaticResource IndexToBool}, ConverterParameter=0}" MinWidth="0" Margin="0,0,8,0" />
                                <RadioButton Content="Hits" IsChecked="{Binding LoopFilter, Converter={StaticResource IndexToBool}, ConverterParameter=1}" MinWidth="0" Margin="0,0,8,0" />
                                <RadioButton Content="Loops" IsChecked="{Binding LoopFilter, Converter={StaticResource IndexToBool}, ConverterParameter=2}" MinWidth="0" />
                            </StackPanel>
                            <TextBlock Text="Key" Style="{StaticResource FilterLabel}" Margin="2,12,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:SoundsViewModel.KeyChoices}" SelectedItem="{Binding KeyFilter}" />
                            <CheckBox Content="Include keys that mix well" IsChecked="{Binding CompatibleKeys}" Margin="0,4,0,0" />
                            <TextBlock Text="BPM" Style="{StaticResource FilterLabel}" Margin="2,12,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox Width="80" PlaceholderText="from" Text="{Binding BpmFrom, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center" />
                                <ui:TextBox Width="80" PlaceholderText="to" Text="{Binding BpmTo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox Content="Never used in a project" IsChecked="{Binding OnlyUnused}" Margin="0,12,0,0" />
                            <CheckBox Content="Favourites" IsChecked="{Binding OnlyFavourites}" />
                            <TextBlock Text="Tag" Style="{StaticResource FilterLabel}" Margin="2,12,0,4" />
                            <ui:TextBox PlaceholderText="any tag" Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- List -->
                    <DockPanel Grid.Column="1">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <ToggleButton DockPanel.Dock="Right" Content="Describe it" IsChecked="{Binding DescribeMode}" Margin="8,0,0,0"
                                          ToolTip="Search by describing the sound, e.g. “dusty vinyl snare” or “dark gritty reese”. Press Enter to search." />
                            <ui:TextBox PlaceholderText="Search names, types and tags… or switch on Describe it" Icon="{ui:SymbolIcon Search24}"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Space" Command="{Binding PlayCommand}" />
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PlayCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="★" Width="28" Binding="{Binding Favourite, Converter={StaticResource BoolToStar}}" />
                                <DataGridTextColumn Header="Sound" Width="2*" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Type" Width="100" Binding="{Binding Type}" />
                                <DataGridTextColumn Header="Key" Width="55" Binding="{Binding Key}" />
                                <DataGridTextColumn Header="BPM" Width="55" Binding="{Binding Bpm}" />
                                <DataGridTextColumn Header="Note" Width="55" Binding="{Binding RootNote}" />
                                <DataGridTextColumn Header="Length" Width="60" Binding="{Binding Seconds, Converter={StaticResource Seconds}}" SortMemberPath="Seconds" />
                                <DataGridTextColumn Header="Character" Width="*" Binding="{Binding Character}" />
                                <DataGridTextColumn Header="Used" Width="50" Binding="{Binding UsedIn}" />
                                <DataGridTextColumn Header="Folder" Width="*" Binding="{Binding Folder}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Selected sound -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0"
                                  Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Selected.Path}" Style="{StaticResource Muted}" FontSize="12" />
                            <Border Height="70" Margin="0,8" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Path Data="{Binding Selected.Analysis.Waveform, Converter={StaticResource WaveformGeometry}}"
                                      Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="1.2"
                                      Stretch="Fill" Margin="6" />
                            </Border>
                            <WrapPanel>
                                <ui:Button Content="Play" Icon="{ui:SymbolIcon Play24}" Command="{Binding PlayCommand}" Margin="0,0,6,6" />
                                <ui:Button Icon="{ui:SymbolIcon Star24}" Command="{Binding ToggleFavouriteCommand}" ToolTip="Favourite" Margin="0,0,6,6" />
                                <ui:Button Content="Show file" Command="{Binding RevealCommand}" Margin="0,0,6,6" />
                                <ui:Button Content="Projects using it" Command="{Binding ShowProjectsCommand}" Margin="0,0,6,6"
                                           Visibility="{Binding Selected.UsedIn, Converter={StaticResource NonZeroToVisibility}}" />
                            </WrapPanel>

                            <TextBlock Text="What it is" Style="{StaticResource SectionHeader}" Margin="0,8,0,4" />
                            <DockPanel>
                                <TextBlock Text="This is a" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{x:Static vm:SoundsViewModel.AllTypes}" SelectedItem="{Binding SelectedTypeLabel}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0">
                                <Run Text="Type from:" />
                                <Run Text="{Binding Selected.TypeSource, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Selected.Character, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="Pitch, key and chords" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding KeyDetail}" TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap" Visibility="{Binding Selected.RootNote, Converter={StaticResource NullToVisibility}}">
                                <Run Text="Root note:" /> <Run Text="{Binding Selected.RootNote, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Visibility="{Binding Selected.Chord, Converter={StaticResource NullToVisibility}}">
                                <Run Text="Chord:" /> <Run Text="{Binding Selected.Chord, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Selected.Analysis.Chords}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,4,4" Padding="6,2" CornerRadius="3" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                ToolTip="{Binding Start, StringFormat='from {0:0.0}s'}">
                                            <TextBlock Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,6,0,0">
                                <ui:Button Content="Detect notes" Icon="{ui:SymbolIcon MusicNote224}" Command="{Binding DetectNotesCommand}" Margin="0,0,6,0"
                                           ToolTip="Transcribe the notes with the Basic Pitch model (runs on this PC)" />
                                <ui:Button Content="Save as MIDI" Command="{Binding ExportMidiCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding NotesMessage}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Visibility="{Binding NotesMessage, Converter={StaticResource NullToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Notes}" MaxHeight="140">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,10,2" FontFamily="Consolas">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Start, StringFormat=' @{0:0.00}s', Mode=OneWay}"
                                                                                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Tags" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Selected.Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,4,4" Padding="8,2,2,2" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                <ui:Button Content="✕" Padding="4,0" Margin="4,0,0,0" Appearance="Transparent"
                                                           Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,4,0,0">
                                <ui:Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddTagCommand}" Margin="6,0,0,0" />
                                <ui:TextBox PlaceholderText="Add a tag (e.g. dusty, signature)" Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddTagCommand}" />
                                    </ui:TextBox.InputBindings>
                                </ui:TextBox>
                            </DockPanel>

                            <TextBlock Text="Sounds like this" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding Similar}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <ui:Button DockPanel.Dock="Left" Padding="6,2" Icon="{ui:SymbolIcon Play24}" ToolTip="Play / stop" Margin="0,0,6,0"
                                                       Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Sound}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Score, StringFormat={}{0:P0}}" Style="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Sound.Name, Mode=OneWay}" /> <Run Text="{Binding Sound.Type, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ Rediscover ============ -->
            <TabItem Header="Rediscover" DataContext="{Binding Rediscover}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Sounds you haven't used much, picked to fit your taste and kept varied." Style="{StaticResource Muted}" />
                            <WrapPanel Margin="0,8,0,8">
                                <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Width="170" Margin="0,0,12,0" />
                                <TextBlock Text="Safe" VerticalAlignment="Center" />
                                <Slider Width="140" Minimum="0" Maximum="1" Value="{Binding Adventure}" Margin="8,0" VerticalAlignment="Center"
                                        ToolTip="How adventurous: left sticks close to what you already use, right goes further afield" />
                                <TextBlock Text="Adventurous" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <CheckBox Content="Include sounds used once" IsChecked="{Binding IncludeRarelyUsed}" Margin="0,0,12,0" />
                                <ui:Button Content="Shuffle" Appearance="Primary" Icon="{ui:SymbolIcon ArrowShuffle24}" Command="{Binding ShuffleCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Intro}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Suggestions}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <ui:Button DockPanel.Dock="Left" Padding="6,2" Icon="{ui:SymbolIcon Play24}" ToolTip="Play / stop" Margin="0,0,10,0"
                                                   Command="{Binding DataContext.Parent.PlayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   CommandParameter="{Binding Sound}" />
                                        <ui:Button DockPanel.Dock="Right" Content="Open" Padding="8,2" Margin="8,0,0,0"
                                                   Command="{Binding DataContext.Parent.RevealCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                   CommandParameter="{Binding Sound}" />
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Sound.Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Sound.Type, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{Binding Sound.Key, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Forgotten folders" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Text="Sample folders by how much of them your projects use." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding Folders}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Used, Mode=OneWay}" /> <Run Text="of" /> <Run Text="{Binding Sounds, Mode=OneWay}" /> <Run Text="sounds used" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============ Kit builder ============ -->
            <TabItem Header="Kit builder" DataContext="{Binding Kit}">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <ui:Button Content="Roll a kit" Appearance="Primary" Icon="{ui:SymbolIcon ArrowShuffle24}" Command="{Binding RollCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Export kit" Icon="{ui:SymbolIcon FolderArrowRight24}" Command="{Binding ExportCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,6" Padding="10,6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="110" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ui:Button DockPanel.Dock="Left" Padding="6,2" Icon="{ui:SymbolIcon Play24}" ToolTip="Play / stop" Margin="0,0,10,0"
                                                       Command="{Binding DataContext.PlaySlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button DockPanel.Dock="Right" Content="✕" Padding="6,2" Margin="6,0,0,0" ToolTip="Remove this pad"
                                                       Command="{Binding DataContext.RemoveSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowSync24}" Padding="6,2" Margin="6,0,0,0" ToolTip="Re-roll just this pad"
                                                       Command="{Binding DataContext.RollOneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <CheckBox DockPanel.Dock="Right" Content="Lock" IsChecked="{Binding Locked}" MinWidth="0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SoundName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="How to pick" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                            <CheckBox Content="Favour sounds I haven't used" IsChecked="{Binding PreferUnused}" />
                            <CheckBox Content="Keep it to one pack" IsChecked="{Binding SamePack}" />
                            <TextBlock Text="Vibe (needs deep listening)" Style="{StaticResource FilterLabel}" Margin="2,10,0,4" />
                            <ui:TextBox PlaceholderText="e.g. dusty lo-fi, hard techno, 90s boom bap" Text="{Binding Vibe, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Key for bass and 808 pads" Style="{StaticResource FilterLabel}" Margin="2,10,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:SoundsViewModel.KeyChoices}" SelectedItem="{Binding Key}" />
                            <TextBlock Text="Randomness" Style="{StaticResource FilterLabel}" Margin="2,10,0,4" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Randomness}" />

                            <TextBlock Text="Add a pad" Style="{StaticResource FilterLabel}" Margin="2,12,0,4" />
                            <ComboBox x:Name="PadType" ItemsSource="{x:Static vm:SoundsViewModel.AllTypes}" SelectedIndex="0" />
                            <ui:Button Content="Add pad" Margin="0,4,0,0" Command="{Binding AddSlotCommand}" CommandParameter="{Binding SelectedItem, ElementName=PadType}" />

                            <TextBlock Text="Export" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
                            <CheckBox Content="Elektron ready (48 kHz, 16-bit WAV)" IsChecked="{Binding ElektronReady}"
                                      ToolTip="For Digitakt II and Analog Rytm MKII: drag the folder into Elektron Transfer" />
                            <CheckBox Content="Mono" IsChecked="{Binding Mono}" />
                            <CheckBox Content="Normalise" IsChecked="{Binding Normalise}" />
                            <TextBlock Text="Kits go to your export folder (Settings), under Kits, with a kit.txt listing the original files."
                                       Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ Teach ============ -->
            <TabItem Header="Teach">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Margin="0,8,16,16">
                        <TextBlock Text="Sound types, learned from your library" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="The Sound Lab learns what kicks, snares, pads and the rest sound like from your own folders and file names, and from every label you correct. It then sorts the sounds whose names don't say. Your corrections count three times as much as folder names."
                                   Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ModelSummary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <ui:Button Content="Retrain now" Icon="{ui:SymbolIcon BrainCircuit24}" Command="{Binding RetrainCommand}" Margin="0,8,0,0" />

                        <TextBlock Text="Worth a listen" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Sounds where what it hears disagrees with the name. Tell it which is right; it learns from your answer."
                                   Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Disagreements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <ui:Button DockPanel.Dock="Left" Padding="6,2" Icon="{ui:SymbolIcon Play24}" ToolTip="Play / stop" Margin="0,0,10,0"
                                                   Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding Sound}" />
                                        <ui:Button DockPanel.Dock="Right" Content="{Binding Thinks}" ContentStringFormat="It's a {0}" Padding="8,2" Margin="6,0,0,0"
                                                   Command="{Binding DataContext.ConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button DockPanel.Dock="Right" Content="Name is right" Padding="8,2" Margin="6,0,0,0"
                                                   Command="{Binding DataContext.KeepNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Sound.Name}" />
                                            <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Your own tags" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Tag at least five sounds with any word you like (dusty, signature, too clean…). On the next retrain it learns what they share and suggests the tag for other sounds."
                                   Style="{StaticResource Muted}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding TagSummaries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <ui:Button DockPanel.Dock="Right" Content="Show" Padding="8,2"
                                                   Command="{Binding DataContext.FilterByTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding Tag}" />
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding Tag, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Sound-understanding model (CLAP)" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="An open neural network from LAION trained on music and sound with descriptions. It lets you search by describing a sound, matches a kit to a vibe, and makes sound-alikes and type guesses sharper. It runs on this PC."
                                   Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ClapStatus}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding DownloadText}" TextWrapping="Wrap" />
                            <ProgressBar Height="6" Margin="0,6,0,0" Maximum="100" Value="{Binding DownloadPercent}"
                                         IsIndeterminate="{Binding DownloadSizeUnknown}" />
                            <ui:Button Content="Stop" Command="{Binding CancelCommand}" Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModelMessage}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Visibility="{Binding ModelMessage, Converter={StaticResource NullToVisibility}}" />
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button Content="Download model" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadModelCommand}" Margin="0,0,6,0"
                                       IsEnabled="{Binding CanStartDownload}"
                                       Visibility="{Binding ClapInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:Button Content="Deep listen" Icon="{ui:SymbolIcon BrainCircuit24}" Command="{Binding DeepListenCommand}"
                                       Visibility="{Binding ClapInstalled, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>

                        <TextBlock Text="Note detection (Basic Pitch)" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Spotify's open Basic Pitch model is built in. Use Detect notes on any sound in the Library tab to see its notes and chords and save them as MIDI."
                                   Style="{StaticResource Muted}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
