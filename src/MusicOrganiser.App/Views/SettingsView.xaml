<UserControl x:Class="MusicOrganiser.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MusicOrganiser.ViewModels;assembly=MusicOrganiser.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="CardIntro" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="20,18" />
        </Style>
        <Style x:Key="FolderList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MaxHeight" Value="190" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left" Margin="0,0,16,16">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Where your projects, samples and plugins live, and how projects open."
                       Style="{StaticResource PageSubtitle}" Margin="0,2,0,20" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Project folders" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardIntro}"
                               Text="Folders to search for Bitwig (.bwproject), FL Studio (.flp) and Studio One (.song) projects. Subfolders are included. DAW autosave and backup folders are skipped, and so are the demo songs, tutorials and templates that came with the DAW (folders named Cool stuff, Demo songs, Product demos, Templates or Tutorial)." />
                    <ListBox ItemsSource="{Binding ProjectFolders}" SelectedItem="{Binding SelectedProjectFolder}" Style="{StaticResource FolderList}" />
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Content="Add folder" Appearance="Primary" Icon="{ui:SymbolIcon FolderAdd24}"
                                   Command="{Binding AddProjectFolderCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Remove" Command="{Binding RemoveProjectFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Sample folders" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardIntro}"
                               Text="Your sample libraries (Splice, packs, recordings). These are indexed so missing samples can be matched by name, and they're what the Sound Lab browses." />
                    <ListBox ItemsSource="{Binding SampleFolders}" SelectedItem="{Binding SelectedSampleFolder}" Style="{StaticResource FolderList}" />
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Content="Add folder" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddSampleFolderCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Remove" Command="{Binding RemoveSampleFolderCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Re-index samples" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding IndexSamplesCommand}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding SampleIndexText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Plugin folders" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardIntro}"
                               Text="Where your VST3, CLAP and VST2 plugins are installed. Used to tell which plugins in a project are missing on this PC, and to recognise plugin names inside Bitwig projects." />
                    <ListBox ItemsSource="{Binding PluginFolders}" SelectedItem="{Binding SelectedPluginFolder}" Style="{StaticResource FolderList}" />
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Content="Add folder" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddPluginFolderCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Remove" Command="{Binding RemovePluginFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Opening projects" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardIntro}"
                               Text="By default projects open in whatever program Windows uses for that file type. Pick a program here to override it, e.g. if you have more than one version installed." />
                    <ItemsControl ItemsSource="{Binding Daws}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DawSetting}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Fill="{Binding Daw, Converter={StaticResource DawBrush}}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Daw}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Extensions}" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ui:TextBox Grid.Column="1" Text="{Binding ExePath, Mode=OneWay}" IsReadOnly="True"
                                                PlaceholderText="Windows default" />
                                    <ui:Button Grid.Column="2" Content="Choose…" Command="{Binding ChooseCommand}" Margin="6,0,0,0" />
                                    <ui:Button Grid.Column="3" Content="Reset" Appearance="Transparent" Command="{Binding ClearCommand}" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Exports" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardIntro}" Text="Where MIDI, presets and kits are saved. Each project gets its own folder inside." />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding ChooseExportFolderCommand}" Margin="6,0,0,0" />
                        <ui:TextBox Text="{Binding ExportFolder, Mode=OneWay}" IsReadOnly="True"
                                    PlaceholderText="Documents\Music Organiser Exports" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="FL Studio to Bitwig" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardIntro}"
                               Text="Open in Bitwig builds each converted song from a template: a project saved in Bitwig with a Sampler track, a VST3 synth with a Note Transpose before it and a clip of notes, and a VST2 synth. Its tracks are copied and filled in, and its own tracks are left out. The app keeps its own copy of the template, so it always knows where it is. To change it, use Edit in Bitwig and save." />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Replace…" Command="{Binding ChooseBitwigTemplateCommand}" Margin="6,0,0,0"
                                   ToolTip="Copy another Bitwig project in as the template" />
                        <ui:Button DockPanel.Dock="Right" Content="Show file" Command="{Binding ShowBitwigTemplateCommand}" Margin="6,0,0,0" />
                        <ui:Button DockPanel.Dock="Right" Content="Edit in Bitwig" Command="{Binding EditBitwigTemplateCommand}" Margin="6,0,0,0"
                                   ToolTip="Open the app's copy of the template in Bitwig, to change it and save" />
                        <ui:TextBox Text="{Binding BitwigTemplate, Mode=OneWay}" IsReadOnly="True"
                                    PlaceholderText="Asked for the first time you convert" />
                    </DockPanel>
                    <TextBlock Text="{Binding BitwigTemplateNote}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding BitwigTemplateNote, Converter={StaticResource NullToVisibility}}" />
                    <CheckBox Content="Steps play until the next note or the end of the clip" IsChecked="{Binding StepsUntilNextNote}" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Notes from FL's step sequencer have no length. Plugin tracks always play them until the next note on the same key or the end of the clip. On a Sampler they also stop where the sample ends, unless this is ticked." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="DAW links" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardIntro}"
                               Text="Small scripts the app installs in Bitwig and FL Studio, so it can ask them what they show for the open project. The Check with Bitwig and Check with FL Studio buttons on a project then compare that with what the app read from its file." />
                    <ui:Button Content="Set up both" Icon="{ui:SymbolIcon PlugConnected24}" Appearance="Primary"
                               Command="{Binding SetUpBothCommand}" Margin="0,0,0,8" HorizontalAlignment="Left"
                               ToolTip="Installs the script for each DAW on this computer, makes FL Studio's MIDI port the way chosen below, then checks each link" />
                    <TextBlock Text="{Binding SetUpResult}" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,14"
                               Visibility="{Binding SetUpResult, Converter={StaticResource NullToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DawLinkSetting}">
                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Fill="{Binding Daw, Converter={StaticResource DawBrush}}" />
                                        <TextBlock Text="{Binding Daw}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" Margin="18,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Live}" Margin="18,2,0,0" TextWrapping="Wrap" FontSize="12.5"
                                               Visibility="{Binding Live, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAnswering}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Steps}" Margin="18,4,0,0" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Margin="18,10,0,0" Visibility="{Binding CanChoosePort, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="The MIDI port for the script" FontSize="12.5" Margin="0,0,0,6" />
                                        <RadioButton MinWidth="0" Margin="0,0,0,4"
                                                     IsChecked="{Binding MidiPort.Choice, Converter={StaticResource IndexToBool}, ConverterParameter=0}">
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                                       Text="loopMIDI: a free app you install, then make the port in. Works on any Windows." />
                                        </RadioButton>
                                        <RadioButton MinWidth="0"
                                                     IsChecked="{Binding MidiPort.Choice, Converter={StaticResource IndexToBool}, ConverterParameter=1}">
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                                       Text="Windows' own MIDI system: Install makes the port, with nothing else to install. Needs Windows 11 25H2 or later, fully updated." />
                                        </RadioButton>
                                        <TextBlock Text="{Binding MidiPort.Note}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                                                   Visibility="{Binding MidiPort.Note, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                    <WrapPanel Margin="18,10,0,0">
                                        <ui:Button Content="Install" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding InstallCommand}" Margin="0,0,6,0" />
                                        <ui:Button Content="Get loopMIDI" Icon="{ui:SymbolIcon Globe24}" Command="{Binding MidiPort.GetLoopMidiCommand}" Margin="0,0,6,0"
                                                   Visibility="{Binding ShowGetLoopMidi, Converter={StaticResource BoolToVisibility}}"
                                                   ToolTip="Opens loopMIDI's page in your browser, to download it" />
                                        <ui:Button Content="Choose folder…" Command="{Binding ChooseFolderCommand}" Margin="0,0,6,0"
                                                   Visibility="{Binding CanChooseFolder, Converter={StaticResource BoolToVisibility}}"
                                                   ToolTip="Pick FL Studio's user data folder, if it's somewhere the app didn't find" />
                                        <ui:Button Content="Check connection" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding CheckCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Result}" Margin="18,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                                               Visibility="{Binding Result, Converter={StaticResource NullToVisibility}}" />
                                    <StackPanel Margin="18,14,0,0" Visibility="{Binding HasLiveTests, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Live tests" FontSize="12.5" Margin="0,0,0,4" />
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                                   Text="Tries out what the app does with Bitwig, in the Bitwig open now, and writes a report. It only reads, unless Bitwig lets the app make changes and the open project's name starts with “MO Live Test”: then it adds a few tracks to that project and saves it, so your own projects are never touched." />
                                        <WrapPanel Margin="0,10,0,0">
                                            <ui:Button Content="Run live tests" Icon="{ui:SymbolIcon Beaker24}" Command="{Binding LiveTests.RunCommand}" Margin="0,0,6,0"
                                                       ToolTip="Runs the live tests while Bitwig is answering. They take about a minute, a few more with MO Probe installed." />
                                            <ui:Button Content="Stop" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding LiveTests.StopCommand}" Margin="0,0,6,0"
                                                       Visibility="{Binding LiveTests.Running, Converter={StaticResource BoolToVisibility}}"
                                                       ToolTip="Stops after the test running now, which puts back anything it was in the middle of. The report is still written." />
                                            <ui:Button Content="Open report" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding LiveTests.OpenReportCommand}"
                                                       ToolTip="Opens the newest run's report. The reports are kept in %LOCALAPPDATA%\MusicOrganiser\reports\live." />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding LiveTests.ProgressLine}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Visibility="{Binding LiveTests.ProgressLine, Converter={StaticResource NullToVisibility}}" />
                                        <TextBlock Text="{Binding LiveTests.Summary}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                                                   Visibility="{Binding LiveTests.Summary, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel DataContext="{Binding Probe}">
                    <TextBlock Text="MO Probe" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardIntro}"
                               Text="A test plugin for learning how each DAW saves things. Put it on a track and use it: it reports what the DAW tells it, and Format Lab finds its knobs and saved settings in the project file." />
                    <TextBlock Text="Running now" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding RunningNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,8"
                               Visibility="{Binding RunningNote, Converter={StaticResource NullToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Running}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RunningProbeRow}">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" ToolTip="{Binding Tip}" />
                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding Knobs}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <ui:Button Content="Beep" Icon="{ui:SymbolIcon Speaker224}" Padding="9,3" FontSize="12" Margin="0,0,6,0"
                                                   Command="{Binding BeepCommand}" ToolTip="Plays a short tone on its track, so you can hear which one it's on" />
                                        <ui:Button Content="Ping" Icon="{ui:SymbolIcon Pulse24}" Padding="9,3" FontSize="12" Margin="0,0,6,0"
                                                   Command="{Binding PingCommand}" ToolTip="Checks that it answers the app, and how quickly" />
                                        <ui:Button Content="Check knobs through Bitwig" Icon="{ui:SymbolIcon Options24}" Padding="9,3" FontSize="12" Margin="0,0,6,0"
                                                   Command="{Binding CheckKnobsCommand}"
                                                   Visibility="{Binding CanCheckKnobs, Converter={StaticResource BoolToVisibility}}"
                                                   ToolTip="Turns each knob through Bitwig and reads what the probe got, then the other way round, and puts them back as they were. It takes about half a minute." />
                                        <ui:Button Content="Stop the check" Icon="{ui:SymbolIcon Dismiss24}" Padding="9,3" FontSize="12"
                                                   Command="{Binding StopCheckCommand}"
                                                   Visibility="{Binding Checking, Converter={StaticResource BoolToVisibility}}"
                                                   ToolTip="Stops the check, and puts the knobs back as they were" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Reply}" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0"
                                               Visibility="{Binding Reply, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Text="{Binding CheckResult}" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0"
                                               Visibility="{Binding CheckResult, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,8" />
                    <ItemsControl ItemsSource="{Binding Reports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProbeReportRow}">
                                <DockPanel Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" Content="Show" Padding="9,3" FontSize="12" VerticalAlignment="Center"
                                               Command="{Binding RevealCommand}" ToolTip="Shows the report file" />
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock>
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,6,0,0">
                        <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                        <ui:Button Content="Open reports folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Your library" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12.5">
                        <Run Text="Your tags, ratings and notes are stored on this PC in" />
                        <Run Text="{Binding LibraryLocation, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                        <Run Text=". Nothing is uploaded; online search only opens your browser when you ask it to." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
