<ui:FluentWindow x:Class="MusicOrganiser.App.Views.MidiWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:MusicOrganiser.App.ViewModels"
                 xmlns:views="clr-namespace:MusicOrganiser.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MidiPreviewViewModel}"
                 Title="{Binding Title, StringFormat='MIDI in {0}'}" Width="760" Height="620" MinWidth="520" MinHeight="360"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{Binding Title, StringFormat='MIDI in {0}'}" />

        <DockPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
            <ui:Button DockPanel.Dock="Right" Content="Export all channels" Appearance="Primary"
                       Icon="{ui:SymbolIcon ArrowExportLtr24}" Command="{Binding ExportAllCommand}"
                       IsEnabled="{Binding HasChannels}" />
            <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                             Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Margin="16,4,16,8"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- Listen to the whole song, and carry every channel out at once. -->
        <WrapPanel DockPanel.Dock="Top" Margin="16,0,16,10"
                   Visibility="{Binding HasChannels, Converter={StaticResource BoolToVisibility}}">
            <ui:Button Command="{Binding PlayAllCommand}" Margin="0,0,12,0" Padding="10,5"
                       ToolTip="Hear every channel together. Click along any channel to jump.">
                <StackPanel Orientation="Horizontal">
                    <Grid Margin="0,0,6,0">
                        <ui:SymbolIcon Symbol="Play24" Visibility="{Binding IsPlayingAll, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:SymbolIcon Symbol="Stop24" Visibility="{Binding IsPlayingAll, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Text="Play all" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
            <Border Style="{StaticResource DragChip}" views:FileDrag.Source="{Binding}"
                    views:FileDrag.AllOf="{Binding ElementName=ChannelList}"
                    ToolTip="Drag into your DAW: one MIDI file per channel, landing as tracks in this order">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="Drag all as tracks" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource DragChip}" views:FileDrag.Source="{Binding AsOneFile}"
                    views:FileDrag.AllOf="{Binding ElementName=ChannelList}"
                    ToolTip="Drag into your DAW as a single multi-track MIDI file">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="Drag as one file" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <TextBlock Text="Or drag any channel. Ctrl or Shift picks several." VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </WrapPanel>

        <ListBox x:Name="ChannelList" ItemsSource="{Binding Channels}" SelectionMode="Extended" Margin="12,0,8,0"
                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DragRow}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                 views:FileDrag.Source="{Binding}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MidiChannelRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Command="{Binding PlayCommand}" Padding="7" Margin="2,0,10,0" VerticalAlignment="Center"
                                   ToolTip="Listen to this channel">
                            <Grid>
                                <ui:SymbolIcon Symbol="Play24" Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ui:SymbolIcon Symbol="Stop24" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </ui:Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" />
                            <TextBlock Text="{Binding Source}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Source}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding Source, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Text="{Binding Details}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <views:NoteRoll Grid.Column="2" Height="48" Channel="{Binding Channel}" SongEnd="{Binding SongEnd}"
                                        Position="{Binding Position}" SeekCommand="{Binding SeekCommand}" />
                        <ui:Button Grid.Column="3" Content="Export" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Command="{Binding ExportCommand}" ToolTip="Save just this channel as a MIDI file" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</ui:FluentWindow>
