<UserControl x:Class="MusicOrganiser.App.Views.SamplesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MusicOrganiser.ViewModels;assembly=MusicOrganiser.ViewModels"
             xmlns:views="clr-namespace:MusicOrganiser.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SamplesViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Missing only" IsChecked="{Binding OnlyMissing}" Margin="0,0,12,0" />
                <ui:TextBox Width="360" PlaceholderText="Search sample paths…" Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Samples" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="8,10,8,8">
        <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Extended" views:FileDrag.Source="{Binding}">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ShowProjectsCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Sample" Width="*" SortMemberPath="Path">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Projects" Width="80" Binding="{Binding Projects}" />
                <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Found">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}" Background="{StaticResource MissingSoftBrush}"
                                    Visibility="{Binding Found, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="Missing" Style="{StaticResource PillText}" Foreground="{StaticResource MissingBrush}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Border>

        <!-- Selected sample -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding Selected.Path}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <WrapPanel Margin="0,8,0,0">
                    <ui:Button Content="Projects using it" Command="{Binding ShowProjectsCommand}" Margin="0,0,6,0" />
                    <ui:Button Content="Find matches on my drives" Icon="{ui:SymbolIcon Search24}"
                               Command="{Binding FindMatchesCommand}" Margin="0,0,6,0" />
                    <ui:Button Content="Search online" Icon="{ui:SymbolIcon Globe24}" Command="{Binding SearchOnlineCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding MatchMessage}" Margin="0,8,0,0"
                           Visibility="{Binding MatchMessage, Converter={StaticResource NullToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Matches}" MaxHeight="200" views:FileDrag.Source="{Binding}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <ui:Button DockPanel.Dock="Right" Content="Show" Padding="8,2"
                                           Command="{Binding DataContext.RevealMatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                                <TextBlock DockPanel.Dock="Right" Margin="8,0" VerticalAlignment="Center"
                                           Text="{Binding Score, StringFormat={}{0:P0}}" ToolTip="{Binding Reason}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Candidate}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
