<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicOrganiser.ViewModels"
        xmlns:views="using:MusicOrganiser.Avalonia.Views"
        x:Class="MusicOrganiser.Avalonia.MainWindow" Classes="studio"
        x:DataType="vm:MainViewModel"
        Title="Music Organiser" Width="1440" Height="900" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:ProjectsViewModel"><views:ProjectsView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
        <!-- Screens not moved over from the Windows app yet. -->
        <DataTemplate DataType="vm:SoundsViewModel"><views:SoundsView /></DataTemplate>
        <DataTemplate DataType="vm:MidiBrowserViewModel"><views:MidiView /></DataTemplate>
        <DataTemplate DataType="vm:PlaygroundViewModel"><views:PlaygroundView /></DataTemplate>
        <DataTemplate DataType="vm:SongMidiViewModel"><views:SongMidiView /></DataTemplate>
        <DataTemplate DataType="vm:PluginsViewModel"><views:PluginsView /></DataTemplate>
        <DataTemplate DataType="vm:SamplesViewModel"><views:SamplesView /></DataTemplate>
    </Window.DataTemplates>

    <!-- Settings › Appearance › Size scales everything in here. -->
    <LayoutTransformControl x:Name="Scaler">
    <Grid ColumnDefinitions="84,*">
        <!-- The rail: the places to go, always in the same spot. Settings sits at the bottom, below the DAW lights. -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,14">
                <Border DockPanel.Dock="Top" Width="40" Height="40" CornerRadius="{DynamicResource RadiusL}" Margin="0,0,0,18"
                        Background="{StaticResource AccentBrush}" ToolTip.Tip="Music Organiser">
                    <Path Data="{StaticResource NavIcon.Samples}" Classes="navIcon" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="2.2" />
                </Border>

                <!-- Scanning: one button; its tooltip says when the library was last brought up to date. -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Spacing="6" Margin="0,10,0,0">
                    <!-- While scanning: a ring that fills as it goes, around a stop square. -->
                    <Button Classes="railButton flat" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}"
                            ToolTip.Tip="{Binding ScanStatus, StringFormat='{}{0}&#10;Click to stop.'}">
                        <Panel Width="30" Height="30">
                            <Arc Classes="ringTrack" Width="30" Height="30" />
                            <Arc Classes="ring" Width="30" Height="30" SweepAngle="{Binding ScanPercent, Converter={StaticResource PercentAngle}}" />
                            <Arc Classes="spinner" Width="22" Height="22" Opacity="0.6" />
                            <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource TextBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                    </Button>
                    <Button Classes="railButton flat" Command="{Binding RescanCommand}" IsVisible="{Binding !IsScanning}"
                            ToolTip.Tip="{Binding ScanStatus, StringFormat='{}{0}&#10;Click to look for new and changed projects. Right-click to re-read everything.'}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rescan everything" Command="{Binding FullRescanCommand}"
                                          ToolTip.Tip="Re-read every project, even unchanged ones" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Data="{StaticResource RescanIcon}" Classes="navIcon" />
                    </Button>
                </StackPanel>

                <!-- The DAW lights: lit in the DAW's colour when it's open and linked. Click one to open its project here. -->
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Live.Rows}" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LiveDawRow">
                            <Button Command="{Binding OpenCommand}" Classes="dawLight flat">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="280">
                                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding Tip}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" StrokeThickness="1.5"
                                             Stroke="{Binding Colour, Converter={StaticResource DawBrush}}"
                                             Fill="{Binding Colour, Converter={StaticResource DawBrush}, ConverterParameter=Light}" />
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" Background="Transparent" Classes="nav"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><DockPanel LastChildFill="False" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <StackPanel Spacing="4" ToolTip.Tip="{Binding Title}">
                                <Path Classes="navIcon" Data="{Binding Title, Converter={StaticResource NavIcon}}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Title, Converter={StaticResource NavLabel}}" FontSize="10.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page: a new one fades in. -->
        <TransitioningContentControl Grid.Column="1" Margin="32,24,32,20" Content="{Binding SelectedNav.Page}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.16" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <!-- Activity cards, bottom right: what's running, how far it has got, and what just finished. -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Activities.Items}" Width="380" Margin="0,0,24,20"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" ZIndex="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:Activity">
                    <Border Classes="toast" Classes.leaving="{Binding IsLeaving}">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <Panel Width="26" Height="26" VerticalAlignment="Top">
                                <Arc Classes="spinner" Width="20" Height="20" IsVisible="{Binding IsRunning}" />
                                <Border Classes="toastIcon" CornerRadius="13" Background="{StaticResource OkBrush}" IsVisible="{Binding IsDone}">
                                    <Path Data="M7,13.5 L11,17 L19,9" Stroke="{StaticResource InkBrush}" StrokeThickness="2.4"
                                          StrokeLineCap="Round" StrokeJoin="Round" Width="26" Height="26" Stretch="None" Margin="-3,-3,0,0" />
                                </Border>
                                <Border Classes="toastIcon" CornerRadius="13" Background="{StaticResource MissingBrush}" IsVisible="{Binding IsFailed}">
                                    <TextBlock Text="!" FontWeight="Bold" FontSize="15" Foreground="{StaticResource InkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Classes="toastIcon" CornerRadius="13" Background="{StaticResource FaintBrush}" IsVisible="{Binding IsStopped}">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource InkBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                            <StackPanel Grid.Column="1" Margin="12,1,8,0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDetail}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                <Button Classes="toastButton accent" Content="{Binding ActionLabel}" Command="{Binding RunActionCommand}"
                                        IsVisible="{Binding HasAction}" />
                                <Button Classes="toastButton" Content="Stop" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
                                <Button Classes="toastButton flat" Command="{Binding DismissCommand}" IsVisible="{Binding !IsRunning}"
                                        ToolTip.Tip="Close">
                                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
                                </Button>
                            </StackPanel>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Margin="38,10,6,0" Height="3" MinHeight="3"
                                         Value="{Binding Percent}" IsVisible="{Binding HasPercent}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
    </LayoutTransformControl>
</Window>
