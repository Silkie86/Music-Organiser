<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicOrganiser.ViewModels"
        xmlns:views="using:MusicOrganiser.Avalonia.Views"
        x:Class="MusicOrganiser.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Music Organiser" Width="1440" Height="900" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:ProjectsViewModel"><views:ProjectsView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
        <!-- Screens not moved over from the Windows app yet. -->
        <DataTemplate DataType="vm:SoundsViewModel"><views:SoundsView /></DataTemplate>
        <DataTemplate DataType="vm:PluginsViewModel"><views:PluginsView /></DataTemplate>
        <DataTemplate DataType="vm:SamplesViewModel"><views:SamplesView /></DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="84,*">
        <!-- The rail: the places to go, always in the same spot. Settings sits at the bottom, below the DAW lights. -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,14">
                <Border DockPanel.Dock="Top" Width="40" Height="40" CornerRadius="12" Margin="0,0,0,18"
                        Background="{StaticResource AccentBrush}" ToolTip.Tip="Music Organiser">
                    <Path Data="{StaticResource NavIcon.Samples}" Classes="navIcon" Stroke="{StaticResource AppBackgroundBrush}" StrokeThickness="2.2" />
                </Border>

                <!-- Scanning: one button; its tooltip says when the library was last brought up to date. -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Spacing="6" Margin="0,10,0,0">
                    <ProgressBar Width="44" Height="4" MinWidth="0" Value="{Binding ScanPercent}" IsVisible="{Binding IsScanning}" />
                    <Button Classes="railButton" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}"
                            ToolTip.Tip="{Binding ScanStatus}">
                        <TextBlock Text="Stop" FontSize="11" FontWeight="SemiBold" />
                    </Button>
                    <Button Classes="railButton" Command="{Binding RescanCommand}" IsVisible="{Binding !IsScanning}"
                            ToolTip.Tip="{Binding ScanStatus, StringFormat='{}{0}&#10;Click to look for new and changed projects. Right-click to re-read everything.'}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rescan everything" Command="{Binding FullRescanCommand}"
                                          ToolTip.Tip="Re-read every project, even unchanged ones" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Data="{StaticResource RescanIcon}" Classes="navIcon" />
                    </Button>
                </StackPanel>

                <!-- The DAW lights: lit in the DAW's colour when it's open and linked. Click one to open its project here. -->
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Live.Rows}" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LiveDawRow">
                            <Button Command="{Binding OpenCommand}" Classes="dawLight">
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="280">
                                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding Tip}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" StrokeThickness="1.5"
                                             Stroke="{Binding Colour, Converter={StaticResource DawBrush}}"
                                             Fill="{Binding Colour, Converter={StaticResource DawBrush}, ConverterParameter=Light}" />
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" Background="Transparent" Classes="nav"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><DockPanel LastChildFill="False" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <StackPanel Spacing="4" ToolTip.Tip="{Binding Title}">
                                <Path Classes="navIcon" Data="{Binding Title, Converter={StaticResource NavIcon}}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Title, Converter={StaticResource NavLabel}}" FontSize="10.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Column="1" Margin="32,24,32,20" Content="{Binding SelectedNav.Page}" />
    </Grid>
</Window>
