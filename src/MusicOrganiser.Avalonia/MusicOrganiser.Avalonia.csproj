<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app for Windows, macOS and Linux, on Avalonia. It shares its screens' logic with the WPF app
       (MusicOrganiser.ViewModels) and replaces it once every screen is ported. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MusicOrganiser.Avalonia</AssemblyName>
    <RootNamespace>MusicOrganiser.Avalonia</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Hot reload (below) is for Debug builds only; this keeps its XAML reader out of Release builds too. -->
    <HotAvaloniaIncludeXamlLoader Condition="'$(Configuration)' != 'Debug'">false</HotAvaloniaIncludeXamlLoader>
    <!-- One memory heap that's cleaned up in the background while the window keeps drawing (the desktop-app setting). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Sound output on every system: OpenAL Soft, with its native library for Windows, macOS and Linux. -->
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <!-- On Windows, MP3, FLAC, M4A and OGG through Media Foundation, and compressed WAVs through Windows'
         audio codecs, as in the WPF app. Unused on a Mac or Linux. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <!-- Hot reload for the screens (.axaml): in a Debug build, a saved change to a screen shows in the running
         app within a second, from Visual Studio, Rider, `dotnet watch` or tools/run-latest. Release builds
         don't include it. Alt+F5 in the app reloads every screen. C# changes go through .NET's own Hot Reload. -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.4" PrivateAssets="All" Publish="True" />
    <PackageReference Include="HotAvalonia" Version="3.1.5" PrivateAssets="All" Publish="True" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicOrganiser.ViewModels\MusicOrganiser.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's fonts, built in so they look the same on every system: IBM Plex, and Space Grotesk and Space Mono for the Retro theme (all SIL Open Font License, in the OFL files). -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenAL Soft's settings (a small output buffer, so sounds start soon after they're asked for), beside the app
         where it looks for them: alsoft.ini on Windows, alsoft.conf on a Mac or Linux. -->
    <None Include="Audio\alsoft.ini" Link="alsoft.ini" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Audio\alsoft.ini" Link="alsoft.conf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MusicOrganiser.Avalonia.Tests" />
  </ItemGroup>

</Project>
