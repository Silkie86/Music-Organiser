<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganiser.ViewModels"
             xmlns:views="using:MusicOrganiser.Avalonia.Views"
             x:Class="MusicOrganiser.Avalonia.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">
    <Grid x:Name="Page" RowDefinitions="Auto,Auto,*">
        <!-- The song's panel takes most of the width (its arrangement wants it; a list row is one line). The splitter
             can't squeeze either to nothing, and where it's left is remembered. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" MinWidth="440" />
        </Grid.ColumnDefinitions>

        <!-- One big search box, and how many songs it leaves. -->
        <DockPanel Grid.ColumnSpan="3">
            <StackPanel DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CountText}" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
            </StackPanel>
            <TextBox x:Name="Search" Classes="bigSearch" VerticalAlignment="Center"
                     PlaceholderText="{x:Static views:Keys.SearchProjects}" Text="{Binding SearchText}"
                     ToolTip.Tip="Several words find projects matching all of them, e.g. &quot;serum dark 2019&quot;. Down arrow goes to the list, Esc clears.">
                <TextBox.InnerLeftContent>
                    <Path Data="M11,4 A7,7 0 1 1 10.99,4 Z M20,20 L16.5,16.5" Classes="navIcon" Margin="16,0,4,0" />
                </TextBox.InnerLeftContent>
                <!-- The X shows whenever there's a search to clear, not only while the box has the focus. -->
                <TextBox.InnerRightContent>
                    <Button Classes="flat" x:Name="ClearSearch" Click="OnClearSearch" Padding="10,6" Margin="0,0,4,0"
                            VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="Clear the search (Esc)"
                            IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Path Data="M1,1 L11,11 M11,1 L1,11" Classes="navIcon" Width="12" Height="12" />
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
        </DockPanel>

        <!-- Filters as chips: the DAW, two quick toggles, the rest under More. -->
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,14">
            <ListBox Classes="chips group" ItemsSource="{Binding DawFilters}" SelectedItem="{Binding DawFilter}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Converter={StaticResource DawBrush}}"
                                     IsVisible="{Binding Converter={StaticResource NotAny}}" />
                            <TextBlock Text="{Binding Converter={StaticResource DawChipText}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Width="1" Height="22" Background="{StaticResource StrokeBrush}" Margin="6,0,12,0" VerticalAlignment="Center" />
            <ToggleButton Classes="chip" IsChecked="{Binding OnlyMissing}" ToolTip.Tip="Only projects with missing plugins or samples">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource MissingBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Has missing stuff" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" IsChecked="{Binding OnlyFavourites}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="M12,20.5 C12,20.5 3,14.6 3,8.6 C3,5.6 5.3,3.5 8.1,3.5 C9.8,3.5 11.2,4.4 12,5.7 C12.8,4.4 14.2,3.5 15.9,3.5 C18.7,3.5 21,5.6 21,8.6 C21,14.6 12,20.5 12,20.5 Z"
                          Fill="{StaticResource MissingBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="Favourites" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <Button Classes="chip" ToolTip.Tip="Status, tag, Elektron box, grouping, archived and older saves">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="{StaticResource FilterIcon}" Classes="navIcon" Width="14" Height="14" />
                    <TextBlock Text="More" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="260" Margin="4">
                            <TextBlock Text="STATUS" Classes="filterLabel" />
                            <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Margin="0,0,0,12" HorizontalAlignment="Stretch" />
                            <TextBlock Text="TAG" Classes="filterLabel" />
                            <ComboBox ItemsSource="{Binding TagFilters}" SelectedItem="{Binding TagFilter}" Margin="0,0,0,12" HorizontalAlignment="Stretch" />
                            <TextBlock Text="ELEKTRON BOX" Classes="filterLabel" />
                            <ComboBox ItemsSource="{Binding HardwareFilters}" SelectedItem="{Binding HardwareFilter}" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Projects that talk to an Elektron box through Overbridge" />
                            <TextBlock Text="GROUP BY" Classes="filterLabel" />
                            <ComboBox ItemsSource="{x:Static vm:ProjectsViewModel.GroupChoices}" SelectedItem="{Binding GroupBy}" Margin="0,0,0,12" HorizontalAlignment="Stretch" />
                            <CheckBox Content="Hide archived" IsChecked="{Binding HideArchived}" />
                            <CheckBox Content="One row per song" IsChecked="{Binding GroupSaves}" Margin="0,0,0,10"
                                      ToolTip.Tip="Show numbered saves (Song_2, Song_3 …) as one song, opening the newest" />
                            <Button Content="Clear all filters" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </WrapPanel>

        <!-- The list: two lines per song, a stripe in its DAW's colour, grouped by when it was first made. -->
        <DockPanel Grid.Row="2">
            <Border DockPanel.Dock="Top" Padding="12,8" Margin="0,0,0,8" CornerRadius="{DynamicResource RadiusM}"
                    Background="{StaticResource AccentFaintBrush}" IsVisible="{Binding HasIdFilter}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Show all" Command="{Binding ClearFiltersCommand}" />
                    <TextBlock Text="{Binding IdFilterLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
            </Border>

            <!-- Songs whose names are close enough that they may be saves of one: the app asks rather than guessing. -->
            <Border DockPanel.Dock="Top" Padding="12,8" Margin="0,0,0,8" CornerRadius="{DynamicResource RadiusM}"
                    Background="{StaticResource AccentFaintBrush}" IsVisible="{Binding ShowDoubtsBanner}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Check" Command="{Binding CheckDoubtsCommand}"
                            ToolTip.Tip="Go through them one pair at a time: one song or two?" />
                    <TextBlock Text="{Binding DoubtsText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Padding="14,12" Margin="0,0,0,8" CornerRadius="{DynamicResource RadiusM}"
                    Background="{StaticResource SurfaceRaisedBrush}" IsVisible="{Binding CheckingDoubts}">
                <StackPanel Spacing="6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Close" Classes="row" Command="{Binding CloseDoubtsCommand}" />
                        <TextBlock Text="{Binding QuestionText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding Doubt.Why}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DoubtA}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DoubtB}" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{Binding KeepAText}" Classes="accent" Margin="0,0,6,6" Command="{Binding SameSongCommand}" CommandParameter="A"
                                ToolTip.Tip="Put both under this name" />
                        <Button Content="{Binding KeepBText}" Margin="0,0,6,6" Command="{Binding SameSongCommand}" CommandParameter="B"
                                IsVisible="{Binding KeepBText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                ToolTip.Tip="Put both under this name" />
                        <Button Content="{Binding DifferentText}" Margin="0,0,6,6" Command="{Binding DifferentSongsCommand}"
                                ToolTip.Tip="Keep them apart and don't ask about these again" />
                        <Button Content="Skip" Margin="0,0,6,6" Command="{Binding SkipDoubtCommand}"
                                ToolTip.Tip="Ask again next time the app starts" />
                    </WrapPanel>
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="You can change this later on a song's Saves tab. Settings › Projects turns these questions off." />
                </StackPanel>
            </Border>

            <DataGrid x:Name="Grid" Classes="songs" ItemsSource="{Binding View, Converter={StaticResource ItemsViewSource}}" views:GridSelection.Item="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="None"
                      CanUserSortColumns="False" CanUserResizeColumns="False" CanUserReorderColumns="False"
                      GridLinesVisibility="None" Background="Transparent" views:ColumnFloor.Enabled="False" RowHeight="64" HorizontalScrollBarVisibility="Disabled"
                      DoubleTapped="OnDoubleTapped" views:FileDrag.Source="{Binding}">
                <!-- Right-click a song: the same ways to open it as the Open button, older versions included. -->
                <DataGrid.ContextFlyout>
                    <MenuFlyout />
                </DataGrid.ContextFlyout>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ProjectItem">
                                <DockPanel Height="60" Margin="0,0,14,0" Background="Transparent" ToolTip.Tip="{Binding Path}">
                                    <Border DockPanel.Dock="Left" Width="4" Height="36" CornerRadius="2" Margin="10,0,14,0"
                                            Background="{Binding Daw, Converter={StaticResource DawBrush}}" />
                                    <TextBlock ToolTip.Tip="{Binding DateTip}" DockPanel.Dock="Right" Text="{Binding ShortDate}" Width="100" TextAlignment="Right" FontSize="12" FontFamily="{DynamicResource NumberFont}"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="★" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource WarningBrush}" IsVisible="{Binding Favourite}" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center"
                                                IsVisible="{Binding HasMissing}" ToolTip.Tip="{Binding MissingText, StringFormat='{}{0} missing'}">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource MissingBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding MissingCount}" FontSize="12" FontFamily="{DynamicResource NumberFont}" Foreground="{StaticResource MissingBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding OpenIn}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource OkBrush}"
                                               IsVisible="{Binding OpenIn, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailsLine}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <GridSplitter x:Name="Splitter" Grid.Row="2" Grid.Column="1" Width="16" Background="Transparent" ResizeDirection="Columns"
                      DragCompleted="OnSplitterMoved" ToolTip.Tip="Drag to give the list or the song more room" />

        <!-- Selected project -->
        <Border Grid.Row="2" Grid.Column="2" Classes="card" Padding="0">
            <Grid>
                <!-- Another project's details cross-fade in, so the eye sees the panel change. -->
                <TransitioningContentControl Content="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.12" />
                    </TransitioningContentControl.PageTransition>
                    <TransitioningContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:ProjectDetailViewModel">
                            <views:ProjectDetailView />
                        </DataTemplate>
                    </TransitioningContentControl.ContentTemplate>
                </TransitioningContentControl>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                            IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="Pick a project" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Its plugins, samples, notes and older saves show up here. Double-click to open it in its DAW."
                               Classes="muted" TextAlignment="Center" MaxWidth="260" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
