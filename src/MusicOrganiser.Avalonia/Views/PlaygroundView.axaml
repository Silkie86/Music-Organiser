<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganiser.ViewModels"
             xmlns:views="using:MusicOrganiser.Avalonia.Views"
             x:Class="MusicOrganiser.Avalonia.Views.PlaygroundView"
             x:DataType="vm:PlaygroundViewModel">
    <UserControl.Styles>
        <!-- The side panel's six tabs fit on one line. -->
        <Style Selector="TabControl.side TabItem">
            <Setter Property="Padding" Value="7,0" />
        </Style>
        <!-- A suggestion being heard: its card lights up (and glows softly while its sound is being made). -->
        <Style Selector="Border.tryCard">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.matches ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBlock.pct">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="{DynamicResource NumberFont}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Border.matchRow">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.matchRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="Border.matchRow StackPanel.actions">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Its buttons show on the row picked (a click), or while it plays: showing them under the mouse would make rows jump. -->
        <Style Selector="ListBoxItem:selected Border.matchRow StackPanel.actions, Border.matchRow.playing StackPanel.actions, Border.matchRow.preparing StackPanel.actions">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Border.tryCard.preparing">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Border.tryCard.playing">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
        </Style>
        <!-- Reharm's three steps: where you are, the ideas as tiles, and the one being tried. -->
        <Style Selector="Border.steps">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="TextBlock.step">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.step.on">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.idea">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.reharmCard">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
        </Style>
        <Style Selector="Border.tryBar">
            <Setter Property="Padding" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.fit">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="ListBox.tracks > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- The dividers: see-through to drag, with a short line in the middle to show where they are. -->
        <Style Selector="Border.grip">
            <Setter Property="Background" Value="{StaticResource StrokeBrush}" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.trackEdge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="6" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
        </Style>
        <Style Selector="Border.trackEdge:pointerover">
            <Setter Property="Background" Value="{StaticResource StrokeBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid Classes="studio" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Menus like a DAW's (2026-10-21; built in PlaygroundView.Menus.cs), and the idea's name on the right. -->
        <DockPanel>
            <TextBox DockPanel.Dock="Right" Text="{Binding IdeaName, UpdateSourceTrigger=LostFocus}" Classes="commitOnEnter ideaName" Width="220"
                     VerticalAlignment="Center" ToolTip.Tip="This idea's name: what the MIDI files are called when you drag them out" />
            <Menu x:Name="MenuBar" Margin="-6,-6,0,0" />
        </DockPanel>

        <!-- The transport and the page's settings, on one strip: buttons that go together joined, numbers in wells. -->
        <!-- The top bar, transport in the middle (Solomon, 2026-10-22): snapping on the left; play, position and tempo
             in the middle; the key, length and ideas on the right. -->
        <Border Grid.Row="1" Classes="panel" Margin="0,6,0,0" Padding="6">
            <Grid Classes="toolbar" ColumnDefinitions="*,Auto,*">
                <WrapPanel VerticalAlignment="Center">
                    <ListBox Classes="chips group" ItemsSource="{x:Static vm:PlaygroundViewModel.GridChoices}" SelectedItem="{Binding GridPick}" Margin="0,0,6,0"
                             ToolTip.Tip="What clips snap to when you drag them. Hold Shift while dragging to place them freely.">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <StackPanel Classes="group" Margin="0,0,10,0">
                        <ToggleButton Content="Grid" IsChecked="{Binding SnapGrid}" ToolTip.Tip="Snap to the grid: dragged clips land on the grid lines" />
                        <ToggleButton Content="Rel" IsChecked="{Binding SnapRelative}"
                                      ToolTip.Tip="Snap relative: dragged clips move in whole grid steps but keep how far off the grid they sat, so a pushed clip stays pushed. With Grid on too, whichever is nearer wins." />
                        <ToggleButton Content="Obj" IsChecked="{Binding SnapObjects}"
                                      ToolTip.Tip="Snap to objects: dragged clips catch the starts and ends of other clips, the highlight, labels and the play marker when they come close" />
                    </StackPanel>
                    <StackPanel Classes="group">
                        <ToggleButton Content="Jazz" IsChecked="{Binding !IsClassical}"
                                      ToolTip.Tip="Jazz and gospel: 9ths, 11ths, 13ths, altered dominants and blue notes heard as colour" />
                        <ToggleButton Content="Classical" IsChecked="{Binding IsClassical}"
                                      ToolTip.Tip="Classical: the chords' own notes are the safe ones; a clash on a strong beat counts against a part" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <StackPanel Classes="group" Margin="0,0,6,0">
                        <!-- Drawn symbols, not emoji: they take the strip's colours and sit on one line. -->
                        <Button MinWidth="34" Command="{Binding ToStartCommand}" ToolTip.Tip="Back to the start: Play starts from bar 1">
                            <Path Classes="buttonIcon filled" Data="M1,1 H3 V11 H1 Z M11,1 V11 L4,6 Z" />
                        </Button>
                        <Button Classes="accent" MinWidth="40" Command="{Binding PlayCommand}" ToolTip.Tip="Play or stop, from the marker on the bar numbers (Space)">
                            <Panel>
                                <Path Classes="buttonIcon filled" Data="M2,0.5 L11,6 L2,11.5 Z" IsVisible="{Binding !IsPlaying}" />
                                <Path Classes="buttonIcon filled" Data="M1.5,1.5 H10.5 V10.5 H1.5 Z" IsVisible="{Binding IsPlaying}" />
                            </Panel>
                        </Button>
                        <ToggleButton MinWidth="40" IsChecked="{Binding LoopOn}"
                                      ToolTip.Tip="Loop: Play goes round the highlighted bars, or the whole idea (Ctrl+L)">
                            <Path Classes="buttonIcon" Data="M1,7 V5.5 A2.5,2.5 0 0 1 3.5,3 H11 M9,1 L11,3 L9,5 M13,7 V8.5 A2.5,2.5 0 0 1 10.5,11 H3 M5,9 L3,11 L5,13" />
                        </ToggleButton>
                        <!-- Playing along with Bitwig: a link (Follow) and into Bitwig (Play in Bitwig). -->
                        <ToggleButton MinWidth="34" IsChecked="{Binding FollowBitwig}"
                                      ToolTip.Tip="Follow Bitwig: press Play in Bitwig and the Playground plays along with its own sounds, from the same place in the bar, at Bitwig's tempo. It stops when Bitwig stops.">
                            <Path Classes="buttonIcon" Data="M4.5,7.5 L7.5,4.5 M5,3.5 L6,2.5 A2.5,2.5 0 0 1 9.5,6 L8.5,7 M7,8.5 L6,9.5 A2.5,2.5 0 0 1 2.5,6 L3.5,5" />
                        </ToggleButton>
                        <ToggleButton MinWidth="34" IsChecked="{Binding PlayInBitwig}"
                                      ToolTip.Tip="Play in Bitwig: each part (and the chord track, when it's heard) goes on a track of its own in Bitwig, named “… (Playground)”, as a clip that plays round. Put your instruments on those tracks; edits here go across as you make them. Bitwig plays at its own tempo.">
                            <Path Classes="buttonIcon" Data="M1,6 V11 H11 V6 M6,1 V7.5 M3.5,5 L6,7.5 L8.5,5" />
                        </ToggleButton>
                    </StackPanel>
                    <Border Classes="lcd" MinWidth="70" Margin="0,0,6,0" ToolTip.Tip="Where it's playing, or where Play starts: bar, beat and sixteenth">
                        <TextBlock Text="{Binding PositionText}" HorizontalAlignment="Center" />
                    </Border>
                    <NumericUpDown Value="{Binding Tempo}" Minimum="40" Maximum="200" Increment="1" FormatString="0" Width="58" Margin="0,0,4,0" ShowButtonSpinner="False"
                                   FontFamily="{DynamicResource NumberFont}" ToolTip.Tip="Tempo, in beats a minute: type it, or scroll over it" />
                    <TextBlock Text="BPM" Classes="caps" Margin="0,0,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox Text="{Binding KeyText}" Width="100" Margin="0,0,4,0" PlaceholderText="{Binding KeyHint}"
                             ToolTip.Tip="{Binding KeySummary, StringFormat='{}{0}. Type a key (Eb, F# minor) to set it, or leave it empty for the app to hear it. A typed key wins.'}" />
                    <TextBlock Text="KEY" Classes="caps" Margin="0,0,12,0" />
                    <NumericUpDown Value="{Binding Bars}" Minimum="1" Maximum="128" Increment="1" FormatString="0" Width="52" Margin="0,0,4,0" ShowButtonSpinner="False"
                                   FontFamily="{DynamicResource NumberFont}"
                                   ToolTip.Tip="How long the timeline is, in bars. Clips that reach the end follow it, playing round again to fill new bars." />
                    <TextBlock Text="BARS" Classes="caps" Margin="0,0,12,0" />
                <StackPanel Classes="group" VerticalAlignment="Center">
                        <Button x:Name="IdeasButton" Content="Ideas" ToolTip.Tip="Save this idea by name, open one you saved, or start a new one">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Spacing="8">
                                    <TextBlock Text="Ideas" FontWeight="SemiBold" />
                                    <TextBlock Text="The idea you're working on is saved after every change. Save it by name to keep it and start another."
                                               TextWrapping="Wrap" Classes="small" TextTrimming="None" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Save this idea" Classes="accent" Command="{Binding SaveIdeaCommand}" />
                                        <Button Content="New idea" Command="{Binding NewIdeaCommand}" />
                                    </StackPanel>
                                    <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,4" />
                                    <TextBlock Text="Saved ideas" Classes="small" />
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsControl ItemsSource="{Binding SavedIdeas}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Button Content="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2"
                                                            Command="{Binding $parent[UserControl].((vm:PlaygroundViewModel)DataContext).OpenIdeaCommand}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        </Button>
                        <Border Classes="dragChip" views:FileDrag.Source="{Binding $parent[UserControl].DataContext}" DataContext="arrangement"
                                ToolTip.Tip="Drag the whole timeline into your DAW: one MIDI file, a track for each part">
                            <TextBlock Text="Drag out" />
                        </Border>
                        <Button Content="To Bitwig" Command="{Binding SendToBitwigCommand}"
                                ToolTip.Tip="Send to Bitwig: each part on its own new track in Bitwig, as a clip" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,6,0,0" Padding="12,6" CornerRadius="3" Background="{StaticResource AccentFaintBrush}"
                IsVisible="{Binding HasMessage}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <!-- The picked label, and the highlight: only while there's one. -->
        <WrapPanel Grid.Row="3" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0" IsVisible="{Binding HasSelectedLabel}">
                <TextBlock Text="Label" Classes="label" />
                <TextBox Text="{Binding LabelName, UpdateSourceTrigger=LostFocus}" Classes="commitOnEnter" Width="130" FontSize="12" />
                <TextBlock Text="is a" Classes="label" />
                <ComboBox ItemsSource="{x:Static vm:PlaygroundViewModel.FeelChoices}" SelectedItem="{Binding FeelPick}" Width="120" FontSize="12"
                          ToolTip.Tip="Verse: steady and calm. Build: rising. Drop: full all the way. Breakdown: sparse. Suggestions for these bars whose energy suits it rank higher." />
                <Button Content="Remove label" Classes="tiny" Command="{Binding RemoveLabelCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasLoop}">
                <TextBlock Text="{Binding LoopText}" Classes="label" FontWeight="SemiBold" />
                <TextBlock Text="highlighted" Classes="label" ToolTip.Tip="Play loops them, suggestions fit them, new parts go there" />
                <Button Content="Clear" Classes="tiny" Command="{Binding ClearLoopCommand}" />
            </StackPanel>
        </WrapPanel>

        <Grid x:Name="Body" Grid.Row="4" ColumnDefinitions="*,16,400" Margin="0,6,0,0">
            <!-- The timeline: chords heard, energy, tracks of clips, and the piano roll for the clip picked. -->
            <Grid x:Name="LeftPane" RowDefinitions="Auto,*,Auto,330">
                <!-- Two panels: the arrangement (chords, energy, tracks), and the clip picked. -->
                <Border Grid.RowSpan="2" Classes="panel" />
                <Border Grid.Row="3" Classes="panel" IsVisible="{Binding HasSelectedClip}" />
                <StackPanel Spacing="2" Margin="6,6,6,6">
                    <Panel>
                    <TextBlock Text="Chords" Classes="laneName" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent"
                               ToolTip.Tip="The chords. Tinted ones are on the chord track (from the Chords tab, no MIDI): drag an edge to stretch one, the middle to move it, everything follows. The rest are heard from the chord and bass parts (everything playing where there are none). Green: home. Red: pulling home. Click one to change it (Reharm)." />
                    <views:ChordLaneView Height="28" ContextRequested="OnChordMenu" Items="{Binding Chords}" PickCommand="{Binding PickChordCommand}"
                                         DragCommand="{Binding DragChordCommand}" Grid="{Binding Grid}" SnapGrid="{Binding SnapGrid}"
                                         Picked="{Binding PickedChord}" Proposed="{Binding ProposedChords}" Length="{Binding Length}" Position="{Binding Position}" Inset="210"
                                         ViewFrom="{Binding ViewFrom}" ViewTo="{Binding ViewTo}" />
                    </Panel>
                    <Panel>
                    <TextBlock Text="Energy" Classes="laneName" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent"
                               ToolTip.Tip="{Binding EnergyText}" />
                    <views:EnergyCurveView Height="18" Values="{Binding EnergyCurve}" Target="{Binding EnergyTarget}" Inset="210" ViewFrom="{Binding ViewFrom}" ViewTo="{Binding ViewTo}"
                                           ToolTip.Tip="Energy, bar by bar: how busy, loud and high it plays, and how far its harmony pulls from the key. Dashed: what each label's feel asks for." />
                    </Panel>
                </StackPanel>

                <!-- Track names beside their rows, then the clips. -->
                <ScrollViewer x:Name="TrackScroll" Grid.Row="1" MinHeight="80" Margin="6,0,6,6" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="210,*">
                        <StackPanel>
                            <Border Height="32" />
                            <ListBox x:Name="TrackList" Classes="tracks" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LayerRow">
                                        <Panel Height="{Binding Height}" Background="Transparent" ContextRequested="OnTrackMenu">
                                        <!-- A colour tab (Solomon, 2026-10-22): a faint wash of the track's colour, solid on its edge. -->
                                        <Border Background="{Binding Colour}" Opacity="0.12" Margin="0,0,0,1" />
                                        <Border Width="6" HorizontalAlignment="Left" Margin="0,0,0,1" Background="{Binding Colour}" />
                                        <StackPanel Spacing="1" Margin="14,3,8,3" VerticalAlignment="Center" ClipToBounds="True">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Classes="group">
                                                    <ToggleButton Classes="tiny" Content="M" IsChecked="{Binding Muted, Mode=OneWay}" Command="{Binding MuteCommand}" ToolTip.Tip="Mute" />
                                                    <ToggleButton Classes="tiny" Content="S" IsChecked="{Binding Solo, Mode=OneWay}" Command="{Binding ToggleSoloCommand}" ToolTip.Tip="Solo: hear only the soloed parts" />
                                                    <Button Classes="tiny" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Take this track and its clips out (Undo brings it back)" />
                                                </StackPanel>
                                                <!-- Renamed in place: double-click the name, or Rename on the track's right-click menu. -->
                                                <Panel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Details}"
                                                               DoubleTapped="OnTrackNameDoubleTapped" />
                                                    <TextBox Classes="commitOnEnter trackRename" IsVisible="False" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                             MinHeight="0" FontSize="12" KeyDown="OnTrackRenameKey" LostFocus="OnTrackRenameDone" />
                                                </Panel>
                                            </DockPanel>
                                            <!-- Its volume, a small fader as on a mixer's channel (Solomon, 2026-10-22). -->
                                            <DockPanel>
                                                <views:VolumeFader DockPanel.Dock="Right" Width="54" Height="6" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Value="{Binding Volume}" Fill="{Binding Colour}" Command="{Binding SetVolumeCommand}"
                                                                   ToolTip.Tip="{Binding VolumeText, StringFormat='Volume {0}: drag along it, scroll over it, or double-click for 0 dB'}" />
                                                <TextBlock Text="{Binding Details}" Classes="small" ToolTip.Tip="{Binding Details}" />
                                            </DockPanel>
                                        </StackPanel>
                                        <Border Classes="trackEdge" PointerPressed="OnTrackEdgePressed" PointerMoved="OnTrackEdgeMoved"
                                                PointerReleased="OnTrackEdgeReleased" PointerCaptureLost="OnTrackEdgeCaptureLost" DoubleTapped="OnTrackEdgeReset"
                                                ToolTip.Tip="Drag to make the tracks taller or shorter; double-click to put them back" />
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <views:TimelineView x:Name="Timeline" Grid.Column="1" Tracks="{Binding Layers}" Labels="{Binding Labels}" Length="{Binding Length}"
                                            Revision="{Binding Revision}" Position="{Binding Position}"
                                            Highlight="{Binding Loop}" HighlightCommand="{Binding SetLoopCommand}"
                                            Selected="{Binding SelectedClip.Clip}" SelectCommand="{Binding SelectClipCommand}"
                                            SelectedLabel="{Binding SelectedLabel}" LabelCommand="{Binding SelectLabelCommand}"
                                            EditCommand="{Binding ChangeClipCommand}" Grid="{Binding Grid}" DropCommand="{Binding DropPartCommand}"
                                            ViewStart="{Binding ViewStart}" ViewLength="{Binding ViewLength}" PlayFrom="{Binding Cursor}" CursorCommand="{Binding SetCursorCommand}" Trying="{Binding Trying}"
                                            DragSource="{Binding}"
                                            SnapGrid="{Binding SnapGrid}" SnapRelative="{Binding SnapRelative}" SnapObjects="{Binding SnapObjects}"
                                            RowHeight="{Binding TrackHeight}"
                                            ToolTip.Tip="Click a clip to edit it below; drag it to slide it, or onto another track (below the last makes a new one). Drag its right edge to play it round more, its left edge to trim it. Hold Shift to drag off the grid. Drag across empty bars, or along the bar numbers, to highlight them: highlight bars of the clip you picked to get other parts for just those bars. Click a label to pick its bars. Drop suggestions from the right, or .mid files from Explorer, onto a track. Pull a clip or a label right out of the timeline to drag it into your DAW. Click the bar numbers to move where Play starts; Ctrl + scroll zooms, Shift + scroll or the middle button moves along, double-click the bar numbers to see it all. Delete takes the picked clip out." />
                    </Grid>
                </ScrollViewer>

                <!-- The divider between the timeline and the clip picked. -->
                <GridSplitter x:Name="ClipDivider" Grid.Row="2" Height="12" Background="Transparent" ResizeDirection="Rows"
                              DragCompleted="OnClipDividerMoved" DoubleTapped="OnClipDividerReset"
                              ToolTip.Tip="Drag to give the timeline or the piano roll more room; double-click to put it back" />
                <Border Grid.Row="2" Classes="grip" Width="48" Height="3" IsVisible="{Binding #ClipDivider.IsVisible}" />

                <!-- The clip picked: its controls and the piano roll, the other parts grey behind. -->
                <DockPanel Grid.Row="3" Margin="6" IsVisible="{Binding HasSelectedClip}">
                    <!-- The inspector: what can be done to the picked clip and its track, in a column under the track names
                         (Solomon, 2026-10-21: the strip of buttons and sentences above the piano roll was too cluttered). -->
                    <ScrollViewer DockPanel.Dock="Left" Width="204" Margin="0,0,6,0" HorizontalScrollBarVisibility="Disabled">
                        <!-- Folding sections (Solomon, 2026-10-22): Clip, Notes and Track, each with a heading that folds it away;
                             values are dragged up or down, scrolled or typed (DragValue), so there are no − and + buttons. -->
                        <StackPanel Spacing="5" Margin="2,2,8,2">
                            <DockPanel ToolTip.Tip="{Binding SelectedClip.Details}">
                                <Button DockPanel.Dock="Right" Classes="tiny" Content="{Binding FoldGlyph}" Command="{Binding FoldPianoCommand}"
                                        ToolTip.Tip="Fold the piano roll away to give the timeline the room, or bring it back" />
                                <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="2" Margin="0,0,7,0" Background="{Binding SelectedClip.Colour}" />
                                <TextBlock Text="{Binding SelectedClip.Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Spacing="5" IsVisible="{Binding !PianoFolded}">
                                <ToggleButton x:Name="ClipOpen" Classes="section" IsChecked="True">
                                    <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Classes="arrow" /><TextBlock Text="Clip" /></StackPanel>
                                </ToggleButton>
                                <StackPanel Spacing="5" IsVisible="{Binding #ClipOpen.IsChecked}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Classes="lcd" MinWidth="72"><TextBlock Text="{Binding SelectedClip.BarsText}" HorizontalAlignment="Center" /></Border>
                                        <TextBlock Text="Bars" Classes="label" />
                                    </DockPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Classes="lcd" MinWidth="72"><TextBlock Text="{Binding SelectedClip.RoundText}" HorizontalAlignment="Center" /></Border>
                                        <TextBlock Text="Round" Classes="label" ToolTip.Tip="How long one go round is, and how many times it plays" />
                                    </DockPanel>
                                    <StackPanel Spacing="3" IsVisible="{Binding SelectedClip.CanFollow}">
                                        <TextBlock Text="Follows the chords" Classes="label" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:ClipRow.FollowWays}" SelectedItem="{Binding SelectedClip.FollowPick}"
                                                  ToolTip.Tip="How it follows the chords on the chord track. Nudge clashes: the line stays as written, only notes that clash move (melodies, soul, pop). Keep its place (in the chord): a root stays a root and a 3rd a 3rd, so it reshapes for each chord (chord parts, gospel and funk bass, arps). Move with root: the whole riff moves with the chord, note for note (riffs, EDM, hip hop). Don't follow: it stays exactly as it is (a pedal note, a drone)." />
                                    </StackPanel>
                                    <DockPanel ToolTip.Tip="A clip follows the chords where it's put: on the chord track the way picked above, elsewhere it moves itself up or down (each time round separately) to sit best on the chords under it. Changing it by hand stops that until Follow again.">
                                        <Button DockPanel.Dock="Right" Content="Follow again" Classes="tiny" Command="{Binding SelectedClip.FitAgainCommand}" IsVisible="{Binding SelectedClip.CanFitAgain}"
                                                ToolTip.Tip="Changed by hand, so it stays as it is. Follow again lets it follow the chords under it again (its octave is kept)." />
                                        <TextBlock Text="{Binding SelectedClip.FitText}" Classes="small" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel Classes="group">
                                        <Button Content="Copy after" Classes="tiny" Command="{Binding SelectedClip.DuplicateCommand}" ToolTip.Tip="A copy straight after it (Ctrl+D)" />
                                        <Button Content="Remove" Classes="tiny" Command="{Binding SelectedClip.RemoveCommand}" ToolTip.Tip="Take the clip out (Delete)" />
                                        <Button Content="Smooth" Classes="tiny" Command="{Binding SmoothInversionsCommand}" IsVisible="{Binding IsChordLayer}"
                                                ToolTip.Tip="Smooth inversions: turn each chord over (same notes, same spacing) so the voices move as little as they can from chord to chord" />
                                    </StackPanel>
                                </StackPanel>

                                <ToggleButton x:Name="NotesOpen" Classes="section" IsChecked="True">
                                    <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Classes="arrow" /><TextBlock Text="Notes" /></StackPanel>
                                </ToggleButton>
                                <StackPanel Spacing="5" IsVisible="{Binding #NotesOpen.IsChecked}">
                                    <DockPanel>
                                        <views:DragValue DockPanel.Dock="Right" MinWidth="72" Text="{Binding SelectedClip.OctaveText}" Value="{Binding SelectedClip.OctaveValue}"
                                                         UpCommand="{Binding SelectedClip.OctaveUpCommand}" DownCommand="{Binding SelectedClip.OctaveDownCommand}" ByCommand="{Binding SelectedClip.OctaveByCommand}" />
                                        <TextBlock Text="Octave" Classes="label" />
                                    </DockPanel>
                                    <DockPanel>
                                        <views:DragValue DockPanel.Dock="Right" MinWidth="72" Text="{Binding SelectedClip.SemitoneText}" Value="{Binding SelectedClip.SemitoneValue}"
                                                         UpCommand="{Binding SelectedClip.UpCommand}" DownCommand="{Binding SelectedClip.DownCommand}" ByCommand="{Binding SelectedClip.SemitoneByCommand}" />
                                        <TextBlock Text="Transpose" Classes="label" ToolTip.Tip="Semitones up or down, on top of its octave" />
                                    </DockPanel>
                                    <DockPanel IsVisible="{Binding SelectedClip.IsChords}">
                                        <views:DragValue DockPanel.Dock="Right" MinWidth="72" Text="{Binding SelectedClip.InversionText}" Value="{Binding SelectedClip.InversionValue}"
                                                         UpCommand="{Binding SelectedClip.TurnUpCommand}" DownCommand="{Binding SelectedClip.TurnDownCommand}" ByCommand="{Binding SelectedClip.TurnByCommand}" />
                                        <TextBlock Text="Inversion" Classes="label" ToolTip.Tip="Turn its chords up (each chord's bottom note up an octave) or down (its top note down an octave)" />
                                    </DockPanel>
                                    <DockPanel ToolTip.Tip="Write each note's name on it and on the keys (C4, F#3), or what it is over the chord heard there (3, ♭7, 9, 13): handy for jazz and gospel tensions">
                                        <ComboBox DockPanel.Dock="Right" Width="112" FontSize="12" ItemsSource="{x:Static vm:PlaygroundViewModel.NoteLabelChoices}" SelectedItem="{Binding NoteLabelPick}" />
                                        <TextBlock Text="Notes say" Classes="label" />
                                    </DockPanel>
                                    <DockPanel ToolTip.Tip="By fit: each note's colour shows how strongly it fits the chord under it, brightest for the strongest, red where it fights. The rows of the strongest notes are lit faintly behind, so you can see where a note would go best. Quieter notes are drawn fainter either way.">
                                        <ComboBox DockPanel.Dock="Right" Width="112" FontSize="12" ItemsSource="{x:Static vm:PlaygroundViewModel.NoteColourChoices}" SelectedItem="{Binding NoteColourPick}" />
                                        <TextBlock Text="Colours" Classes="label" />
                                    </DockPanel>
                                    <views:FitLegend Bass="{Binding SelectedClip.IsBass}" IsVisible="{Binding FitColours}" HorizontalAlignment="Left"
                                                     ToolTip.Tip="Strongest fit first. A bassline leans on the root and 5th, then the 3rd; other parts on the root, 3rd and 5th, then the 7th, then tensions." />
                                </StackPanel>

                                <ToggleButton x:Name="TrackOpen" Classes="section" IsChecked="True">
                                    <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Classes="arrow" /><TextBlock Text="Track" /></StackPanel>
                                </ToggleButton>
                                <StackPanel Spacing="5" IsVisible="{Binding #TrackOpen.IsChecked}">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" DataContext="{Binding SelectedLayer}" x:DataType="vm:LayerRow" ItemsSource="{x:Static vm:LayerRow.SoundChoices}" SelectedItem="{Binding Sound}"
                                      FontSize="12" Width="132" ToolTip.Tip="The track's sound here (General MIDI)" />
                                        <TextBlock Text="Sound" Classes="label" />
                                    </DockPanel>
                                    <DockPanel DataContext="{Binding SelectedLayer}" x:DataType="vm:LayerRow">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeText}" Width="52" TextAlignment="Right" Classes="small" VerticalAlignment="Center" />
                                        <views:VolumeFader DockPanel.Dock="Right" Width="72" Height="8" Margin="6,0" VerticalAlignment="Center"
                                                           Value="{Binding Volume}" Fill="{Binding Colour}" Command="{Binding SetVolumeCommand}" />
                                        <TextBlock Text="Volume" Classes="label" />
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBox x:Name="TrackName" DockPanel.Dock="Right" DataContext="{Binding SelectedLayer}" x:DataType="vm:LayerRow" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Classes="commitOnEnter"
                                     Width="132" FontSize="12" ToolTip.Tip="The track's name: its name in your DAW" />
                                        <TextBlock Text="Name" Classes="label" />
                                    </DockPanel>
                                    <StackPanel Classes="group">
                                        <Border Classes="dragChip" Margin="0" views:FileDrag.Source="{Binding $parent[UserControl].DataContext}"
                                                ToolTip.Tip="Drag this track into your DAW as a MIDI clip">
                                            <TextBlock Text="Drag this track out" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <views:PianoRollEditor MinHeight="80" IsVisible="{Binding !PianoFolded}" Notes="{Binding SelectedClip.Notes}" Guide="{Binding SelectedClip.Guide}" Overlay="{Binding SelectedClip.Overlay}"
                                           NoteLabels="{Binding NoteLabels}" DegreeOf="{Binding SelectedClip.DegreeOf}"
                                           StrengthOf="{Binding SelectedClip.StrengthOf}" WouldBe="{Binding SelectedClip.WouldBe}" FitGuide="{Binding SelectedClip.FitGuide}"
                                           SnapGrid="{Binding SnapGrid}" SnapRelative="{Binding SnapRelative}" SnapObjects="{Binding SnapObjects}"
                                           Period="{Binding SelectedClip.Loop}" Length="{Binding SelectedClip.Loop}" Position="{Binding SelectedClip.Position}"
                                           Section="{Binding SelectedClip.Highlight}" SectionCommand="{Binding SelectedClip.PickBarsCommand}" SeekCommand="{Binding SelectedClip.SeekCommand}"
                                           EditedCommand="{Binding SelectedClip.EditedCommand}" ClashTest="{Binding SelectedClip.Clashes}"
                                           ToolTip.Tip="One go round of the clip. The other parts playing then are grey behind. Click to add a note (it copies the length and velocity of the last note you clicked), drag to move, drag its end to stretch, right-click to remove; red notes fight the chords (a jazz tension or a quick passing note isn't marked). Drag along the bar numbers to pick part of the clip: Suggest then finds the bit of each part that fits there, to swap in (right-click the bar numbers to let go). Notes snap with the Grid, Relative and Objects switches above; hold Shift to place freely." />
                </DockPanel>
            </Grid>
            <!-- The side panel's edge: drag to make it wider or narrower. -->
            <GridSplitter Grid.Column="1" Width="16" Background="Transparent" ResizeDirection="Columns"
                          DragCompleted="OnSideDividerMoved" DoubleTapped="OnSideDividerReset"
                          ToolTip.Tip="Drag to make the side panel wider or narrower; double-click to put it back" />
            <Border Grid.Column="1" Classes="grip" Width="3" Height="48" />
            <!-- Getting parts: suggestions, writing from the chords, reharmonising, and songs. -->
            <Border Grid.Column="2" Classes="panel" Padding="10,6,10,10">
                <TabControl Classes="side" Padding="0,8,0,0" SelectedIndex="{Binding RightTab}">
                    <TabItem Header="{Binding SuggestTab}" FontSize="14">
                        <Panel>
                        <!-- An empty idea: the MIDI page's own list, smaller, with Add on each part. -->
                        <views:MidiListView Classes="compact" DataContext="{Binding Midi}" IsVisible="{Binding $parent[UserControl].((vm:PlaygroundViewModel)DataContext).IsEmpty}"
                                            AddCommand="{Binding $parent[UserControl].((vm:PlaygroundViewModel)DataContext).AddMidiRowCommand}" />
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding !IsEmpty}">
                            <ListBox Classes="chips group" ItemsSource="{Binding RoleChips}" SelectedItem="{Binding SuggestRole}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoleChip">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Find" Classes="accent" Margin="6,0,0,0" Command="{Binding FindMatchesCommand}" />
                                <TextBox Text="{Binding SuggestSearch}" PlaceholderText="Words to narrow it (optional)" Classes="clearButton" />
                            </DockPanel>
                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                <ComboBox DataContext="{Binding Midi}" x:DataType="vm:MidiBrowserViewModel" ItemsSource="{x:Static vm:MidiBrowserViewModel.FromChoices}" SelectedItem="{Binding From}"
                                          Width="136" FontSize="12" Margin="0,0,10,4" ToolTip.Tip="Parts from your projects, from your MIDI folders, or both" />
                                <TextBlock Text="These bars are a" Classes="label" Margin="0,0,6,4" />
                                <ComboBox ItemsSource="{x:Static vm:PlaygroundViewModel.FeelChoices}" SelectedItem="{Binding FeelPick}" Width="120" Margin="0,0,10,4"
                                          ToolTip.Tip="Verse: steady and calm. Build: rising. Drop: full all the way. Breakdown: sparse. Suggestions whose energy suits it rank higher; Any ranks on harmony alone." />
                                <CheckBox Content="Smooth inversions" IsChecked="{Binding SmoothIncoming}" Margin="0,0,0,4"
                                          ToolTip.Tip="Chord parts you add are turned into the inversions that move least, sitting with the chords already here" />
                            </WrapPanel>
                            <DockPanel Grid.Row="3" Margin="0,6">
                                <Button DockPanel.Dock="Right" Content="Show more" Classes="tiny" Margin="6,0,0,0" VerticalAlignment="Top"
                                        IsVisible="{Binding CanShowMore}" Command="{Binding ShowMoreCommand}"
                                        ToolTip.Tip="The next lot under these, best first. How many come at a time is in Settings › Playground." />
                                <TextBlock Text="{Binding MatchStatus}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                            </DockPanel>
                            <ListBox Grid.Row="4" ItemsSource="{Binding Matches}" SelectedItem="{Binding SelectedMatch}" Background="Transparent" Classes="longList matches"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlaygroundMatchRow">
                                        <!-- A tight row (Solomon, 2026-10-22: strip and list, keeping the preview of its notes): name and
                                             where it's from, its notes, how well it fits. Why it fits and its chords are in the tooltip;
                                             the buttons show on the row clicked, or while it plays. -->
                                        <Border Classes="tryCard matchRow" Classes.playing="{Binding IsPlaying}" Classes.preparing="{Binding IsPreparing}">
                                            <ToolTip.Tip>
                                                <StackPanel Spacing="3" MaxWidth="320">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Why}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Chords}" FontFamily="{DynamicResource NumberFont}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ToolTip.Tip>
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,104,40">
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding From}" Classes="small" />
                                                    </StackPanel>
                                                    <views:NoteRoll Grid.Column="1" Height="28" Channel="{Binding Channel}" views:PartDrag.Part="{Binding}" ToolTip.Tip="Drag it onto a track on the timeline" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FitText}" Classes="pct" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Classes="group actions">
                                                    <Button Classes="tiny" Command="{Binding PreviewCommand}" ToolTip.Tip="Hear it with the idea, where it would go">
                                                        <TextBlock Text="{Binding PreviewText}" />
                                                    </Button>
                                                    <Button Content="{Binding AddText}" Classes="tiny" Command="{Binding AddCommand}" ToolTip.Tip="Add: on a new track over the highlight (or from bar 1), moved into key. Swap in: in place of the highlighted bars of the clip you picked." />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        </Panel>
                    </TabItem>

                    <!-- Chords first (Solomon, 2026-10-22): progressions from every chord part read, put on the chord track with no MIDI,
                         and what usually comes next after the chord track's last chord. -->
                    <TabItem Header="Chords" FontSize="14" ToolTip.Tip="Chord progressions from your own chord parts, to put on the chord track (no MIDI)">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <StackPanel Spacing="4" Margin="0,0,0,8" IsVisible="{Binding NextChords.Count}">
                                <TextBlock Text="{Binding NextChordsText}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                                <ItemsControl ItemsSource="{Binding NextChords}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NextChordRow">
                                            <Button Margin="0,0,6,6" Classes="tiny" Command="{Binding AddCommand}"
                                                    ToolTip.Tip="Add it after the last chord, a bar long (on the chord track when it has chords)">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ShareText}" Classes="small" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <DockPanel Grid.Row="1">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static vm:PlaygroundViewModel.ProgressionBarChoices}" SelectedItem="{Binding ProgressionBars}"
                                          Width="118" FontSize="12" Margin="6,0,0,0" ToolTip.Tip="How long one go round of the progression lasts" />
                                <TextBox Text="{Binding ProgressionSearch}" PlaceholderText="Chords or numerals: Dm7, ii V, minor" Classes="clearButton" />
                            </DockPanel>
                            <DockPanel Grid.Row="2" Margin="0,6">
                                <ToggleButton DockPanel.Dock="Right" Content="Hear" Classes="tiny" IsChecked="{Binding HearChordTrack}" Margin="6,0,0,0" VerticalAlignment="Top"
                                              ToolTip.Tip="Hear the chord track's chords, played plainly, with the idea. They're never sent to the DAW." />
                                <Button DockPanel.Dock="Right" Content="From Bitwig" Classes="tiny" Command="{Binding ChordsFromBitwigCommand}" Margin="6,0,0,0" VerticalAlignment="Top"
                                        ToolTip.Tip="Get chords from Bitwig: click your chord clip in Bitwig (arranger or clip launcher) first. Its chords, read from its notes, go on the chord track. Needs the Music Organiser extension 3.15." />
                                <TextBlock Text="{Binding ProgressionsText}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                            </DockPanel>
                            <ListBox Grid.Row="3" ItemsSource="{Binding Progressions}" Background="Transparent" Classes="longList"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProgressionRow">
                                        <Border Classes="tryCard" Classes.playing="{Binding IsPlaying}" ToolTip.Tip="{Binding Tip}">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Button Classes="tiny" Command="{Binding PlayCommand}" Width="26" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        ToolTip.Tip="Hear it, moved into the idea's key">
                                                    <TextBlock Text="{Binding PlayText}" />
                                                </Button>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Names}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Romans}" Classes="small" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding SongsText}" Classes="small" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding BarsText}" Classes="small" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="Use" Classes="tiny accent" Command="{Binding UseCommand}" VerticalAlignment="Center"
                                                        ToolTip.Tip="Put these chords on the chord track, with no MIDI: over the highlight, else after its last chord (from bar 1 when it's empty)" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Write" FontSize="14">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="8">
                                <TextBlock TextWrapping="Wrap" Classes="small" TextTrimming="None"
                                           Text="Parts written from the chords heard, over the highlight or the whole timeline. They follow when the chords change, until you edit their notes." />
                                <TextBlock Text="Chords" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{x:Static vm:PlaygroundViewModel.VoicingChoices}" SelectedItem="{Binding Voicing}" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="Rootless: Bill Evans's 3-5-7-9 voicings. Drop 2: open four-note voicings. Gospel: root and octave under a cluster with the 9 on top. Classical: four voices with no parallel fifths. Every style moves each voice as little as it can." />
                                <ComboBox ItemsSource="{x:Static vm:PlaygroundViewModel.RhythmChoices}" SelectedItem="{Binding Rhythm}" HorizontalAlignment="Stretch" />
                                <Button Content="Write chords" Classes="accent" Command="{Binding WriteChordsCommand}" />
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,4" />
                                <TextBlock Text="Bassline" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{x:Static vm:PlaygroundViewModel.BassChoices}" SelectedItem="{Binding BassPick}" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="Walking: quarter notes, root first, approaching the next chord by a semitone. Gospel runs: roots and octaves with a chromatic run into each change." />
                                <Button Content="Write a bassline" Classes="accent" Command="{Binding WriteBassCommand}" />
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,4" />
                                <TextBlock Text="Guide-tone line" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap" Classes="small" TextTrimming="None"
                                           Text="One line on each chord's third or seventh, moving as little as it can: the line jazz melodies and solos are built on." />
                                <Button Content="Write a guide-tone line" Command="{Binding WriteGuideTonesCommand}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Reharm" FontSize="14" ToolTip.Tip="Change a chord: click it on the chord lane, try an idea, keep it or go back">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <!-- where you are in the three steps -->
                            <Border Classes="steps" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,*,*">
                                    <TextBlock Text="1  Pick a chord" Classes="step" Classes.on="{Binding IsReharmPicking}" />
                                    <TextBlock Grid.Column="1" Text="2  Try an idea" Classes="step" Classes.on="{Binding IsReharmChoosing}" />
                                    <TextBlock Grid.Column="2" Text="3  Keep it" Classes="step" Classes.on="{Binding IsReharmTrying}" />
                                </Grid>
                            </Border>

                            <Panel Grid.Row="1">
                                <!-- 1: nothing picked -->
                                <Panel IsVisible="{Binding IsReharmPicking}">
                                    <StackPanel IsVisible="{Binding !CanHarmonise}" Spacing="6" Margin="0,12">
                                        <TextBlock Text="Click a chord on the chord lane" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Its ideas show here." Classes="small" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <!-- no chords yet: whole sets of chords for the melody or bassline, to try -->
                                    <DockPanel IsVisible="{Binding CanHarmonise}">
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding HarmoniseText}" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" TextTrimming="None"
                                                   ToolTip.Tip="No chord part plays, so these are chords made for what does: try one, then keep it on the chord track (or as a Chords part) or go back" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding HarmoniseIdeas}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReharmRow">
                                                        <Button Classes="idea" Command="{Binding TryCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                                                ToolTip.Tip="{Binding Why}">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Idea.After}" Classes="small" FontFamily="{DynamicResource NumberFont}" TextWrapping="Wrap" TextTrimming="None" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Panel>

                                <!-- 2: the ideas for the picked chord -->
                                <DockPanel IsVisible="{Binding IsReharmChoosing}">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="✕" Classes="tiny" Command="{Binding ClearPickedChordCommand}" ToolTip.Tip="Pick no chord" />
                                        <TextBlock Text="{Binding PickedChordText}" FontSize="16" FontWeight="SemiBold" FontFamily="{DynamicResource NumberFont}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="No ideas for this chord. Try another." Classes="small" IsVisible="{Binding !ChordIdeas.Count}" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding ChordIdeas}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ReharmRow">
                                                    <Button Classes="idea" Command="{Binding TryCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                                            ToolTip.Tip="{Binding Why}">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Swap}" Classes="small" FontFamily="{DynamicResource NumberFont}" TextWrapping="Wrap" TextTrimming="None" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>

                                <!-- 3: trying one, striped on the chord lane -->
                                <Panel IsVisible="{Binding IsReharmTrying}">
                                <StackPanel Spacing="8" DataContext="{Binding TryingIdea}" x:DataType="vm:ReharmRow">
                                    <Border Classes="reharmCard">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Swap}" FontSize="18" FontWeight="SemiBold" FontFamily="{DynamicResource NumberFont}" TextWrapping="Wrap" TextTrimming="None" />
                                            <TextBlock Text="{Binding Why}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="accent" Command="{Binding $parent[UserControl].((vm:PlaygroundViewModel)DataContext).KeepIdeaCommand}"
                                                Content="Keep" ToolTip.Tip="Change the chords (chords made for the melody go on the chord track); parts follow them. Undo takes it back." />
                                        <Button Command="{Binding $parent[UserControl].((vm:PlaygroundViewModel)DataContext).KeepIdeaAsPartCommand}" IsVisible="{Binding Idea.Whole}"
                                                Content="As a part" ToolTip.Tip="Keep these chords as a Chords part with notes, played plainly, instead of on the chord track" />
                                        <Button Command="{Binding $parent[UserControl].((vm:PlaygroundViewModel)DataContext).BackIdeaCommand}"
                                                Content="{Binding $parent[UserControl].((vm:PlaygroundViewModel)DataContext).BackText}" ToolTip.Tip="Leave the chords as they were and try another idea" />
                                        <Button Command="{Binding PreviewCommand}" ToolTip.Tip="Hear the idea with it">
                                            <Panel>
                                                <TextBlock Text="▶" IsVisible="{Binding !IsPlaying}" />
                                                <TextBlock Text="■" IsVisible="{Binding IsPlaying}" />
                                            </Panel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                </Panel>
                            </Panel>

                            <!-- what could come next, smaller, under the steps -->
                            <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0" IsVisible="{Binding NextChords.Count}">
                                <TextBlock Text="{Binding NextChordsText}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                                <ItemsControl ItemsSource="{Binding NextChords}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NextChordRow">
                                            <Button Margin="0,0,6,6" Classes="tiny" Command="{Binding AddCommand}" ToolTip.Tip="Add it as the next bar">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ShareText}" Classes="small" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Song" FontSize="14" ToolTip.Tip="Bring in the parts of one of your songs">
                        <StackPanel Spacing="8">
                            <TextBlock TextWrapping="Wrap" Classes="small" TextTrimming="None"
                                       Text="Bring in every part of one of your songs from a bar, over the highlight (or the whole timeline), to build on. Its other parts are then never suggested here." />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="From bar" Classes="label" />
                                <NumericUpDown Value="{Binding FromBar}" Minimum="1" Maximum="999" Increment="1" FormatString="0" Width="110" />
                            </StackPanel>
                            <CheckBox Content="Chords only" IsChecked="{Binding SongChordsOnly}"
                                      ToolTip.Tip="Bring in just the song's chords, onto the chord track, with none of its parts" />
                            <TextBox Text="{Binding SongSearch}" PlaceholderText="Search your songs" Classes="clearButton" />
                            <ItemsControl ItemsSource="{Binding SongChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectItem">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2"
                                                Command="{Binding $parent[UserControl].((vm:PlaygroundViewModel)DataContext).BringSongCommand}" CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Daw}" Classes="small" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
