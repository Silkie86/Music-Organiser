<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganiser.ViewModels"
             xmlns:views="using:MusicOrganiser.Avalonia.Views"
             x:Class="MusicOrganiser.Avalonia.Views.PlaygroundView"
             x:DataType="vm:PlaygroundViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.fit">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.tiny">
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="26" />
        </Style>
        <Style Selector="ToggleButton.tiny">
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="26" />
        </Style>
        <Style Selector="ListBox.tracks > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="46" />
            <Setter Property="MinHeight" Value="46" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Header: the idea, saving, undo, and out to the DAW. -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                <Button Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Take back the last change" />
                <Button Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" />
                <Button Content="Ideas" ToolTip.Tip="Save this idea by name, open one you saved, or start a new one">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="320" Spacing="8">
                                <TextBlock Text="Ideas" FontWeight="SemiBold" />
                                <TextBlock Text="The idea you're working on is saved after every change. Save it by name to keep it and start another."
                                           TextWrapping="Wrap" Classes="small" TextTrimming="None" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Save this idea" Classes="accent" Command="{Binding SaveIdeaCommand}" />
                                    <Button Content="New idea" Command="{Binding NewIdeaCommand}" />
                                </StackPanel>
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,4" />
                                <TextBlock Text="Saved ideas" Classes="small" />
                                <ScrollViewer MaxHeight="260">
                                    <ItemsControl ItemsSource="{Binding SavedIdeas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Content="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2"
                                                        Command="{Binding $parent[UserControl].((vm:PlaygroundViewModel)DataContext).OpenIdeaCommand}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Border Classes="dragChip" views:FileDrag.Source="{Binding $parent[UserControl].DataContext}" DataContext="arrangement"
                        ToolTip.Tip="Drag the whole timeline into your DAW: one MIDI file, a track for each part">
                    <TextBlock Text="Drag the arrangement" />
                </Border>
                <Button Content="Send to Bitwig" Command="{Binding SendToBitwigCommand}"
                        ToolTip.Tip="Each part on its own new track in Bitwig, as a clip" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Playground" Classes="pageTitle" />
                <TextBox Text="{Binding IdeaName, UpdateSourceTrigger=LostFocus}" Classes="commitOnEnter" MinWidth="260" HorizontalAlignment="Left" Margin="0,4,0,0" FontSize="13"
                         ToolTip.Tip="This idea's name: what the MIDI files are called when you drag them out" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,10,0,0" Padding="12,8" CornerRadius="{DynamicResource RadiusM}" Background="{StaticResource AccentFaintBrush}"
                IsVisible="{Binding HasMessage}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <!-- Transport, tempo, length, key and the harmony's ears. -->
        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Classes="accent" Margin="0,0,10,6" MinWidth="80" Command="{Binding PlayCommand}" ToolTip.Tip="Play the idea round and round, or just the highlighted bars">
                <Panel>
                    <TextBlock Text="▶ Play" IsVisible="{Binding !IsPlaying}" />
                    <TextBlock Text="■ Stop" IsVisible="{Binding IsPlaying}" />
                </Panel>
            </Button>
            <TextBlock Text="Tempo" Classes="label" Margin="0,0,6,6" />
            <Slider Minimum="40" Maximum="200" Value="{Binding Tempo}" Width="120" Margin="0,-6,6,0" />
            <TextBlock Text="{Binding Tempo, StringFormat={}{0:0} BPM}" Classes="label" MinWidth="58" Margin="0,0,12,6" />
            <TextBlock Text="Bars" Classes="label" Margin="0,0,6,6" />
            <NumericUpDown Value="{Binding Bars}" Minimum="1" Maximum="128" Increment="1" FormatString="0" Width="110" Margin="0,0,12,6"
                           ToolTip.Tip="How long the timeline is. Clips that reach the end follow it, playing round again to fill new bars." />
            <TextBlock Text="Key" Classes="label" Margin="0,0,6,6" />
            <TextBox Text="{Binding KeyText}" Width="90" Margin="0,0,6,6" PlaceholderText="Heard"
                     ToolTip.Tip="Type a key (Eb, F# minor) to set it, or leave it empty for the app to hear it. A typed key wins." />
            <TextBlock Text="{Binding KeySummary}" Classes="label" Margin="0,0,16,6" />
            <ToggleButton Classes="chip" Content="Jazz and gospel" IsChecked="{Binding !IsClassical}" Margin="0,0,4,6"
                          ToolTip.Tip="Hear 9ths, 11ths, 13ths, altered dominants and blue notes as colour" />
            <ToggleButton Classes="chip" Content="Classical" IsChecked="{Binding IsClassical}" Margin="0,0,6,6"
                          ToolTip.Tip="The chords' own notes are the safe ones; a clash on a strong beat counts against a part" />
        </WrapPanel>

        <!-- Labels, the grid and the highlight. -->
        <WrapPanel Grid.Row="3" Margin="0,2,0,0">
            <TextBlock Text="Snap to" Classes="label" Margin="0,0,6,6" />
            <ListBox Classes="chips" ItemsSource="{x:Static vm:PlaygroundViewModel.GridChoices}" SelectedItem="{Binding GridPick}" Margin="0,0,12,6"
                     ToolTip.Tip="What clips snap to when you drag them. Hold Shift while dragging to place them freely.">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Button Content="+ Label" Classes="tiny" Margin="0,0,10,6" Command="{Binding AddLabelCommand}"
                    ToolTip.Tip="Name some bars (Verse, Build, Drop…): over the highlight, or the bars after the last label. Suggestions for those bars suit its feel." />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6" IsVisible="{Binding HasSelectedLabel}">
                <TextBlock Text="Label" Classes="label" />
                <TextBox Text="{Binding LabelName, UpdateSourceTrigger=LostFocus}" Classes="commitOnEnter" Width="130" FontSize="12" />
                <TextBlock Text="is a" Classes="label" />
                <ComboBox ItemsSource="{x:Static vm:PlaygroundViewModel.FeelChoices}" SelectedItem="{Binding FeelPick}" Width="120" FontSize="12"
                          ToolTip.Tip="Verse: steady and calm. Build: rising. Drop: full all the way. Breakdown: sparse. Suggestions for these bars whose energy suits it rank higher." />
                <Button Content="Remove label" Classes="tiny" Command="{Binding RemoveLabelCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" IsVisible="{Binding HasLoop}">
                <TextBlock Text="{Binding LoopText}" Classes="label" FontWeight="SemiBold" />
                <TextBlock Text="highlighted: Play goes round them, suggestions fit them, new parts go there." Classes="label" />
                <Button Content="Clear" Classes="tiny" Command="{Binding ClearLoopCommand}" />
            </StackPanel>
            <TextBlock Text="Drag across empty bars on the timeline to highlight them." Classes="label" Margin="0,0,0,6" IsVisible="{Binding !HasLoop}" />
        </WrapPanel>

        <Grid Grid.Row="4" ColumnDefinitions="*,400" Margin="0,6,0,0">
            <!-- The timeline: chords heard, energy, tracks of clips, and the piano roll for the clip picked. -->
            <Grid RowDefinitions="Auto,Auto,Auto">
                <StackPanel Spacing="2" Margin="0,0,0,6">
                    <views:ChordLaneView Height="46" Items="{Binding Chords}" Length="{Binding Length}" Position="{Binding Position}" Inset="210" />
                    <views:EnergyCurveView Height="36" Values="{Binding EnergyCurve}" Target="{Binding EnergyTarget}" Inset="210"
                                           ToolTip.Tip="Energy, bar by bar: how busy, loud and high it plays, and how far its harmony pulls from the key. Dashed: what each label's feel asks for." />
                    <DockPanel Margin="210,0,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding EnergyText}" Classes="small" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding ChordSummary}" Classes="small"
                                   ToolTip.Tip="Chords are heard, never typed: from the chord and bass parts where there are some, from everything playing where there aren't. Green: home. Red: pulling home. Faint: moving away." />
                    </DockPanel>
                </StackPanel>

                <!-- Track names beside their rows, then the clips. -->
                <ScrollViewer Grid.Row="1" MaxHeight="330" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="210,*">
                        <StackPanel>
                            <Border Height="38" />
                            <ListBox Classes="tracks" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LayerRow">
                                        <StackPanel Spacing="1" Margin="6,3,8,3">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="3">
                                                    <ToggleButton Classes="tiny" Content="M" IsChecked="{Binding Muted, Mode=OneWay}" Command="{Binding MuteCommand}" ToolTip.Tip="Mute" />
                                                    <ToggleButton Classes="tiny" Content="S" IsChecked="{Binding Solo, Mode=OneWay}" Command="{Binding ToggleSoloCommand}" ToolTip.Tip="Solo: hear only the soloed parts" />
                                                    <Button Classes="tiny" Content="✕" Command="{Binding RemoveCommand}" ToolTip.Tip="Take this track and its clips out (Undo brings it back)" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Details}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Details}" Classes="small" ToolTip.Tip="{Binding Details}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <views:TimelineView Grid.Column="1" Tracks="{Binding Layers}" Labels="{Binding Labels}" Length="{Binding Length}"
                                            Revision="{Binding Revision}" Position="{Binding Position}"
                                            Highlight="{Binding Loop}" HighlightCommand="{Binding SetLoopCommand}"
                                            Selected="{Binding SelectedClip.Clip}" SelectCommand="{Binding SelectClipCommand}"
                                            SelectedLabel="{Binding SelectedLabel}" LabelCommand="{Binding SelectLabelCommand}"
                                            EditCommand="{Binding ChangeClipCommand}" DeleteCommand="{Binding DeleteClipCommand}" Grid="{Binding Grid}" DropCommand="{Binding DropPartCommand}"
                                            ToolTip.Tip="Click a clip to edit it below; drag it to slide it, or onto another track (below the last makes a new one). Drag its right edge to play it round more, its left edge to trim it. Hold Shift to drag off the grid. Drag across empty bars, or along the bar numbers, to highlight them: highlight bars of the clip you picked to get other parts for just those bars. Click a label to pick its bars. Drop suggestions from the right, or .mid files from Explorer, onto a track. Delete takes the picked clip out." />
                    </Grid>
                </ScrollViewer>

                <!-- The clip picked: its controls and the piano roll, the other parts grey behind. -->
                <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding HasSelectedClip}">
                    <WrapPanel>
                        <TextBlock Text="{Binding SelectedClip.Details}" Classes="label" FontWeight="SemiBold" Margin="0,0,12,6" />
                        <ComboBox DataContext="{Binding SelectedLayer}" x:DataType="vm:LayerRow" ItemsSource="{x:Static vm:LayerRow.SoundChoices}" SelectedItem="{Binding Sound}"
                                  MinWidth="150" Margin="0,0,10,6" FontSize="12" ToolTip.Tip="The track's sound here (General MIDI)" />
                        <TextBlock Text="Octave" Classes="label" Margin="0,0,4,6" />
                        <Button Content="−" Classes="tiny" Margin="0,0,2,6" Command="{Binding SelectedClip.OctaveDownCommand}" />
                        <Button Content="+" Classes="tiny" Margin="0,0,10,6" Command="{Binding SelectedClip.OctaveUpCommand}" />
                        <TextBlock Text="Semitone" Classes="label" Margin="0,0,4,6" />
                        <Button Content="−" Classes="tiny" Margin="0,0,2,6" Command="{Binding SelectedClip.DownCommand}" />
                        <Button Content="+" Classes="tiny" Margin="0,0,10,6" Command="{Binding SelectedClip.UpCommand}" />
                        <TextBlock Text="Inversion" Classes="label" Margin="0,0,4,6" IsVisible="{Binding SelectedClip.IsChords}" />
                        <Button Content="−" Classes="tiny" Margin="0,0,2,6" Command="{Binding SelectedClip.TurnDownCommand}" IsVisible="{Binding SelectedClip.IsChords}"
                                ToolTip.Tip="Turn its chords down: each chord's top note down an octave" />
                        <Button Content="+" Classes="tiny" Margin="0,0,10,6" Command="{Binding SelectedClip.TurnUpCommand}" IsVisible="{Binding SelectedClip.IsChords}"
                                ToolTip.Tip="Turn its chords up: each chord's bottom note up an octave" />
                        <Button Content="Fit again" Classes="tiny" Margin="0,0,6,6" Command="{Binding SelectedClip.FitAgainCommand}" IsVisible="{Binding SelectedClip.CanFitAgain}"
                                ToolTip.Tip="Changed by hand, so it stays as it is. Fit again lets it move to fit the chords under it again (its octave is kept)." />
                        <TextBlock Text="{Binding SelectedClip.FitText}" Classes="label" Margin="0,0,12,6"
                                   ToolTip.Tip="Shift to fit: a clip you move moves itself up or down (each time round separately) to sit best on the chords under it. Changing it by hand stops that until Fit again." />
                        <Button Content="Copy after it" Classes="tiny" Margin="0,0,4,6" Command="{Binding SelectedClip.DuplicateCommand}" />
                        <Button Content="Remove" Classes="tiny" Margin="0,0,10,6" Command="{Binding SelectedClip.RemoveCommand}" />
                        <Button Content="Smooth inversions" Classes="tiny" Margin="0,0,10,6" Command="{Binding SmoothInversionsCommand}" IsVisible="{Binding IsChordLayer}"
                                ToolTip.Tip="Turn each chord over (same notes, same spacing) so the voices move as little as they can from chord to chord" />
                        <Border Classes="dragChip" Margin="0,0,6,6" views:FileDrag.Source="{Binding $parent[UserControl].DataContext}"
                                ToolTip.Tip="Drag this track into your DAW as a MIDI clip">
                            <TextBlock Text="Drag this track" />
                        </Border>
                        <TextBox DataContext="{Binding SelectedLayer}" x:DataType="vm:LayerRow" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Classes="commitOnEnter"
                                 Width="160" Margin="0,0,6,6" FontSize="12" ToolTip.Tip="The track's name: its name in your DAW" />
                    </WrapPanel>
                    <views:PianoRollEditor Height="230" Notes="{Binding SelectedClip.Notes}" Guide="{Binding SelectedClip.Guide}"
                                           Period="{Binding SelectedClip.Loop}" Length="{Binding SelectedClip.Loop}" Position="{Binding SelectedClip.Position}"
                                           EditedCommand="{Binding SelectedClip.EditedCommand}" ClashTest="{Binding SelectedClip.Clashes}"
                                           ToolTip.Tip="One go round of the clip. The other parts playing then are grey behind. Click to add a note, drag to move, drag its end to stretch, right-click to remove; red notes fight the chords (a jazz tension or a quick passing note isn't marked)." />
                </StackPanel>
            </Grid>
            <!-- Getting parts: suggestions, writing from the chords, reharmonising, and songs. -->
            <Border Grid.Column="1" Classes="card" Margin="16,0,0,0" Padding="12">
                <TabControl Padding="0,8,0,0" SelectedIndex="{Binding RightTab}">
                    <TabItem Header="Suggest" FontSize="14">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                            <ListBox Classes="chips" ItemsSource="{Binding RoleChips}" SelectedItem="{Binding SuggestRole}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoleChip">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Find" Classes="accent" Margin="6,0,0,0" Command="{Binding FindMatchesCommand}" />
                                <TextBox Text="{Binding SuggestSearch}" PlaceholderText="Words to narrow it (optional)" Classes="clearButton" />
                            </DockPanel>
                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="These bars are a" Classes="label" Margin="0,0,6,4" />
                                <ComboBox ItemsSource="{x:Static vm:PlaygroundViewModel.FeelChoices}" SelectedItem="{Binding FeelPick}" Width="120" Margin="0,0,10,4"
                                          ToolTip.Tip="Verse: steady and calm. Build: rising. Drop: full all the way. Breakdown: sparse. Suggestions whose energy suits it rank higher; Any ranks on harmony alone." />
                                <CheckBox Content="Smooth inversions" IsChecked="{Binding SmoothIncoming}" Margin="0,0,0,4"
                                          ToolTip.Tip="Chord parts you add are turned into the inversions that move least, sitting with the chords already here" />
                            </WrapPanel>
                            <TextBlock Grid.Row="3" Text="{Binding MatchStatus}" Classes="small" TextWrapping="Wrap" TextTrimming="None" Margin="0,6" />
                            <ListBox Grid.Row="4" ItemsSource="{Binding Matches}" Background="Transparent" Classes="longList"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlaygroundMatchRow">
                                        <StackPanel Spacing="3" Margin="0,2">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FitText}" Classes="fit" Margin="6,0,0,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                                    <TextBlock Text="{Binding From}" Classes="small" ToolTip.Tip="{Binding From}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <views:NoteRoll Height="36" Channel="{Binding Channel}" views:PartDrag.Part="{Binding}" ToolTip.Tip="Drag it onto a track on the timeline" />
                                            <TextBlock Text="{Binding Why}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                                            <TextBlock Text="{Binding Chords}" Classes="small" FontFamily="{DynamicResource NumberFont}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Classes="tiny" Command="{Binding PreviewCommand}" ToolTip.Tip="Hear it with the idea, where it would go">
                                                    <Panel>
                                                        <TextBlock Text="▶ With the idea" IsVisible="{Binding !IsPlaying}" />
                                                        <TextBlock Text="■ Stop" IsVisible="{Binding IsPlaying}" />
                                                    </Panel>
                                                </Button>
                                                <Button Content="{Binding AddText}" Classes="tiny accent" Command="{Binding AddCommand}" ToolTip.Tip="Add: on a new track over the highlight (or from bar 1), moved into key. Swap in: in place of the highlighted bars of the clip you picked." />
                                                <Button Content="Copy its groove" Classes="tiny" Command="{Binding TakeGrooveCommand}"
                                                        ToolTip.Tip="Put its feel, rhythm or whole playing on the part picked (block chords played like it)" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Write" FontSize="14">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="8">
                                <TextBlock TextWrapping="Wrap" Classes="small" TextTrimming="None"
                                           Text="Parts written from the chords heard, over the highlight or the whole timeline. They follow when the chords change, until you edit their notes." />
                                <TextBlock Text="Chords" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{x:Static vm:PlaygroundViewModel.VoicingChoices}" SelectedItem="{Binding Voicing}" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="Rootless: Bill Evans's 3-5-7-9 voicings. Drop 2: open four-note voicings. Gospel: root and octave under a cluster with the 9 on top. Classical: four voices with no parallel fifths. Every style moves each voice as little as it can." />
                                <ComboBox ItemsSource="{x:Static vm:PlaygroundViewModel.RhythmChoices}" SelectedItem="{Binding Rhythm}" HorizontalAlignment="Stretch" />
                                <Button Content="Write chords" Classes="accent" Command="{Binding WriteChordsCommand}" />
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,4" />
                                <TextBlock Text="Bassline" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{x:Static vm:PlaygroundViewModel.BassChoices}" SelectedItem="{Binding BassPick}" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="Walking: quarter notes, root first, approaching the next chord by a semitone. Gospel runs: roots and octaves with a chromatic run into each change." />
                                <Button Content="Write a bassline" Classes="accent" Command="{Binding WriteBassCommand}" />
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,4" />
                                <TextBlock Text="Guide-tone line" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap" Classes="small" TextTrimming="None"
                                           Text="One line on each chord's third or seventh, moving as little as it can: the line jazz melodies and solos are built on." />
                                <Button Content="Write a guide-tone line" Command="{Binding WriteGuideTonesCommand}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Groove" FontSize="14">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="8">
                                <TextBlock TextWrapping="Wrap" Classes="small" TextTrimming="None"
                                           Text="Take the groove of one part and put it on another: from just its swing and accents to its whole playing, so plain block chords play the way a player's part does." />
                                <TextBlock Text="Copy from" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding GrooveSources}" SelectedItem="{Binding GrooveSource}" HorizontalAlignment="Stretch"
                                          PlaceholderText="Another part"
                                          ToolTip.Tip="Another part here. Or press Copy its groove on any suggestion to copy from a part in your library.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LayerRow">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding GrooveSourceText}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="How much to copy" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <Slider Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                        Value="{Binding GrooveAmount}" Margin="0,-4,0,0" />
                                <!-- Six stops: four of feel (25% to 100%), then rhythm, then the whole playing. -->
                                <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*" Margin="0,-6,0,0">
                                    <TextBlock Grid.ColumnSpan="5" Text="Feel" Classes="small" />
                                    <TextBlock Grid.Column="7" Grid.ColumnSpan="2" Text="Rhythm" Classes="small" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="8" Grid.ColumnSpan="2" Text="Playing" Classes="small" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding GrooveAmountText}" Classes="small" TextWrapping="Wrap" TextTrimming="None" MinHeight="34" />
                                <TextBlock Text="{Binding GrooveTargetText}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="tiny" Command="{Binding PreviewGrooveCommand}" IsEnabled="{Binding CanCopyGroove}" ToolTip.Tip="Hear the idea with it">
                                        <Panel>
                                            <TextBlock Text="▶ Hear it" IsVisible="{Binding !IsGroovePlaying}" />
                                            <TextBlock Text="■ Stop" IsVisible="{Binding IsGroovePlaying}" />
                                        </Panel>
                                    </Button>
                                    <Button Content="Copy the groove" Classes="accent" Command="{Binding CopyGrooveCommand}" IsEnabled="{Binding CanCopyGroove}"
                                            ToolTip.Tip="Put it on the part picked on the left. Undo takes it back. A part written from the chords keeps the groove when the chords change." />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Reharm" FontSize="14">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">
                            <TextBlock Text="{Binding NextChordsText}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding NextChords}" Margin="0,4,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NextChordRow">
                                        <Button Margin="0,0,6,6" Classes="tiny" Command="{Binding AddCommand}" ToolTip.Tip="Add it as the next bar">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ShareText}" Classes="small" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="2" Text="Reharmonisation ideas" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ListBox Grid.Row="3" ItemsSource="{Binding Ideas}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReharmRow">
                                        <StackPanel Spacing="3" Margin="0,2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Change}" Classes="small" FontFamily="{DynamicResource NumberFont}" TextWrapping="Wrap" TextTrimming="None" />
                                            <TextBlock Text="{Binding Why}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Classes="tiny" Command="{Binding PreviewCommand}" ToolTip.Tip="Hear the idea with it">
                                                    <Panel>
                                                        <TextBlock Text="▶ Hear it" IsVisible="{Binding !IsPlaying}" />
                                                        <TextBlock Text="■ Stop" IsVisible="{Binding IsPlaying}" />
                                                    </Panel>
                                                </Button>
                                                <Button Content="Use it" Classes="tiny accent" Command="{Binding ApplyCommand}" ToolTip.Tip="Change the chords; parts written from them follow. Undo takes it back." />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Song" FontSize="14" ToolTip.Tip="Bring in the parts of one of your songs">
                        <StackPanel Spacing="8">
                            <TextBlock TextWrapping="Wrap" Classes="small" TextTrimming="None"
                                       Text="Bring in every part of one of your songs from a bar, over the highlight (or the whole timeline), to build on. Its other parts are then never suggested here." />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="From bar" Classes="label" />
                                <NumericUpDown Value="{Binding FromBar}" Minimum="1" Maximum="999" Increment="1" FormatString="0" Width="110" />
                            </StackPanel>
                            <TextBox Text="{Binding SongSearch}" PlaceholderText="Search your songs" Classes="clearButton" />
                            <ItemsControl ItemsSource="{Binding SongChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectItem">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2"
                                                Command="{Binding $parent[UserControl].((vm:PlaygroundViewModel)DataContext).BringSongCommand}" CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Daw}" Classes="small" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
