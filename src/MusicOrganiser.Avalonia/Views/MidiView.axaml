<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganiser.ViewModels"
             xmlns:views="using:MusicOrganiser.Avalonia.Views"
             xmlns:core="using:MusicOrganiser.Core.Midi"
             x:Class="MusicOrganiser.Avalonia.Views.MidiView"
             x:DataType="vm:MidiBrowserViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Header: what's here, reading progress, and the MIDI library folders. -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Spacing="6">
                <Border VerticalAlignment="Center" Padding="12,8" CornerRadius="{DynamicResource RadiusM}" Width="280"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        IsVisible="{Binding IsIndexing}">
                    <StackPanel>
                        <TextBlock Text="{Binding IndexText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="4" MinHeight="4" Margin="0,6,0,0" Maximum="100" Value="{Binding IndexPercent}" />
                    </StackPanel>
                </Border>
                <Button Content="Stop" Command="{Binding StopIndexingCommand}" IsVisible="{Binding IsIndexing}" />
                <!-- Projects and MIDI files that couldn't be read: why, and a button to try just those again. -->
                <Button IsVisible="{Binding HasFailures}" ToolTip.Tip="Some files couldn't be read. Click to see why and try them again.">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource MissingBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FailedText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="440" Spacing="8">
                                <TextBlock Text="Couldn't be read" FontWeight="SemiBold" />
                                <TextBlock Text="These were skipped, so their MIDI isn't in the list. Trying again reads only these (and anything new). If one keeps failing, it may be open in your DAW or saved by a version the reader doesn't know yet."
                                           TextWrapping="Wrap" Classes="small" TextTrimming="None" />
                                <ScrollViewer MaxHeight="300">
                                    <ItemsControl ItemsSource="{Binding Failures}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:MidiFailure">
                                                <StackPanel Margin="0,4" ToolTip.Tip="{Binding Path}">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Why}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Content="Try the failed ones again" Classes="accent" Command="{Binding RetryFailedCommand}"
                                        IsEnabled="{Binding !IsIndexing}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Sounds" ToolTip.Tip="What MIDI plays with: General MIDI instruments, or one stand-in tone">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="380" Spacing="8">
                                <TextBlock Text="Sounds to play MIDI with" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SoundsText}" TextWrapping="Wrap" Classes="small" TextTrimming="None" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Get better sounds" Classes="accent" Command="{Binding GetSoundsCommand}" IsVisible="{Binding !HasGoodSounds}" />
                                    <Button Content="Choose a SoundFont…" Command="{Binding ChooseSoundFontCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Read MIDI again" Command="{Binding ReindexCommand}" IsVisible="{Binding !IsIndexing}"
                        ToolTip.Tip="Look for new and changed projects and MIDI files. Only those are read." />
                <Button Content="MIDI folders" Classes="accent"
                        ToolTip.Tip="Your MIDI packs and libraries. Their files are read where they are: never moved, copied or changed.">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="380" Spacing="8">
                                <TextBlock Text="MIDI library folders" FontWeight="SemiBold" />
                                <TextBlock Text="Every .mid file in these folders (and the folders inside them) shows up here. The files stay where they are and are never changed."
                                           TextWrapping="Wrap" Classes="small" TextTrimming="None" />
                                <ItemsControl ItemsSource="{Binding Folders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <DockPanel Margin="0,2">
                                                <Button DockPanel.Dock="Right" Content="Remove" Padding="8,3" FontSize="12"
                                                        Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).RemoveFolderCommand}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Add a MIDI folder…" Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" />
                                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,6" />
                                <TextBlock Text="Your projects" FontWeight="SemiBold" />
                                <CheckBox Content="Include older saves of each song" IsChecked="{Binding IncludeOlderSaves}" />
                                <TextBlock Text="Off: only the newest save of each song is read (Song_36 rather than Song_2 … Song_35), the same songs Projects shows with &quot;One row per song&quot;. Turn it on to read every save too."
                                           TextWrapping="Wrap" Classes="small" TextTrimming="None" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="MIDI" Classes="pageTitle" />
                <TextBlock Text="{Binding Summary}" Classes="pageSubtitle" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8" CornerRadius="{DynamicResource RadiusM}" Background="{StaticResource AccentFaintBrush}"
                IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <!-- Search, kind of part and the list, shared with the Playground; the picked part's card at the side. -->
        <views:MidiListView x:Name="List" Grid.Row="2" Grid.RowSpan="3">
            <views:MidiListView.Side>
                    <!-- The part picked: a bigger look, what it is, and what to do with it. -->
                    <Border Classes="card" Margin="16,0,0,0" VerticalAlignment="Top" IsVisible="{Binding HasSelection}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10" DataContext="{Binding Selected}" x:DataType="vm:MidiRow">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding From}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                            <!-- Fitting: a cut-down Playground, the part and what it's fitted to as lanes, with the Playground's piano
                                 roll, bars, loop and harmony style, so what's added to the Playground turns up here too. -->
                            <views:PlaygroundMiniView DataContext="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).Quick}"
                                                      IsVisible="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).IsPairing}" />
                            <!-- The part's own piano roll, with simple changes a click away and loop points to find parts for some
                                 bars. Folded away under the small playground while fitting. -->
                            <Expander HorizontalAlignment="Stretch" IsExpanded="{Binding !$parent[UserControl].((vm:MidiBrowserViewModel)DataContext).IsPairing, Mode=OneWay}"
                                      Header="This part's piano roll, loop points and quick changes">
                            <StackPanel Spacing="6">
                                <DockPanel IsVisible="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).IsPairing}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                        <ComboBox ItemsSource="{x:Static vm:MidiBrowserViewModel.SoundChoices}" SelectedItem="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).WithSound}"
                                                  FontSize="12" MinWidth="150" ToolTip.Tip="The sound it plays with" />
                                        <Button Content="−" Padding="8,1" Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).WithOctaveDownCommand}" ToolTip.Tip="An octave down, on its own" />
                                        <TextBlock Text="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).WithOctaveText}" Classes="small" VerticalAlignment="Center" MinWidth="90" TextAlignment="Center" />
                                        <Button Content="+" Padding="8,1" Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).WithOctaveUpCommand}" ToolTip.Tip="An octave up, on its own" />
                                        <ToggleButton Classes="chip" FontSize="12" Content="Mute" IsChecked="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).MuteWith}" ToolTip.Tip="Hear this part without it" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource MutedBrush}" Opacity="0.6" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PairText}" Classes="small" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <views:PianoRollEditor Height="300" Notes="{Binding BarNotes}" Guide="{Binding EditorGuide}" Period="{Binding LoopLength}"
                                                       Length="{Binding PairLength}" Position="{Binding PairPosition}"
                                                       PartStart="{Binding PartStart}" PartEnd="{Binding PartEnd}"
                                                       Section="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).Section}"
                                                       SectionCommand="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).SetSectionCommand}"
                                                       EditedCommand="{Binding EditCommand}" SeekCommand="{Binding PairSeekCommand}"
                                                       ToolTip.Tip="Click to add a note, drag a note to move it, drag its end to stretch it, right-click to take it away. Hold Shift to place without snapping. Click the bar numbers to play from there; drag along them to set loop points." />
                                <!-- Loop points: what's looping, parts for just those bars, or how to set them. -->
                                <WrapPanel>
                                    <TextBlock Text="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).SectionHint}" Classes="small"
                                               VerticalAlignment="Center" Margin="0,0,10,6" IsVisible="{Binding !$parent[UserControl].((vm:MidiBrowserViewModel)DataContext).HasSection}" />
                                    <TextBlock Text="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).SectionText}" FontWeight="SemiBold" Classes="small"
                                               VerticalAlignment="Center" Margin="0,0,10,6" IsVisible="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).HasSection}" />
                                    <Button Content="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).FindForSectionText}" Classes="accent" Padding="10,3" FontSize="12" Margin="0,0,6,6"
                                            Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).FindForSectionCommand}"
                                            IsVisible="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).CanFindForSection}"
                                            ToolTip.Tip="Rank every part by how well it fits just these bars. Each one you pick plays in them." />
                                    <Button Content="All bars" Padding="10,3" FontSize="12" Margin="0,0,6,6"
                                            Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).WholeFitCommand}"
                                            IsVisible="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).IsFittingSection}"
                                            ToolTip.Tip="Back to parts that fit all of it" />
                                    <Button Content="Clear loop points" Padding="10,3" FontSize="12" Margin="0,0,6,6"
                                            Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).ClearSectionCommand}"
                                            IsVisible="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).HasSection}"
                                            ToolTip.Tip="Loop all of it again (a right-click on the bar numbers does this too)" />
                                </WrapPanel>
                                <DockPanel IsVisible="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).IsPairing}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                        <ComboBox ItemsSource="{x:Static vm:MidiBrowserViewModel.SoundChoices}" SelectedItem="{Binding Sound}"
                                                  FontSize="12" MinWidth="150" ToolTip.Tip="The sound this kind of part plays with" />
                                        <Button Content="−" Padding="8,1" Command="{Binding OctaveDownCommand}" IsVisible="{Binding CanChangeOctave}" ToolTip.Tip="An octave down (remembered)" />
                                        <TextBlock Text="{Binding OctaveText}" Classes="small" VerticalAlignment="Center" MinWidth="90" TextAlignment="Center"
                                                   IsVisible="{Binding CanChangeOctave}" ToolTip.Tip="{Binding OctaveWhy}" />
                                        <Button Content="+" Padding="8,1" Command="{Binding OctaveUpCommand}" IsVisible="{Binding CanChangeOctave}" ToolTip.Tip="An octave up (remembered)" />
                                        <ToggleButton Classes="chip" FontSize="12" Content="Mute" IsChecked="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).MuteMine}" ToolTip.Tip="Hear what it's fitted to on its own" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title, StringFormat='This part: {0}'}" Classes="small" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                        <Button Content="Undo" Padding="8,2" FontSize="12" Command="{Binding UndoEditCommand}" IsEnabled="{Binding CanUndoEdit}"
                                                ToolTip.Tip="Take back the last edit" />
                                        <Button Content="Back to as it was" Padding="8,2" FontSize="12" Command="{Binding ResetEditsCommand}" IsVisible="{Binding IsEdited}"
                                                ToolTip.Tip="Undo every edit to this part. The file it came from is never changed." />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TogetherText}" Classes="small" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
                                </DockPanel>
                                <!-- One-click changes, each undone like any edit. The file it came from is never changed. -->
                                <WrapPanel>
                                    <TextBlock Text="Change it:" Classes="small" VerticalAlignment="Center" Margin="0,0,8,6" />
                                    <StackPanel Classes="group" Margin="0,0,0,6">
                                        <Button Content="▼ Semitone" Command="{Binding ToolCommand}" CommandParameter="down"
                                                ToolTip.Tip="Every note down a semitone" />
                                        <Button Content="▲ Semitone" Command="{Binding ToolCommand}" CommandParameter="up"
                                                ToolTip.Tip="Every note up a semitone" />
                                        <Button Content="Quantise" Command="{Binding ToolCommand}" CommandParameter="quantise"
                                                ToolTip.Tip="Every note onto the grid, for a tight feel: 16ths, or what Settings › MIDI says" />
                                        <Button Content="Play it twice" Command="{Binding ToolCommand}" CommandParameter="twice"
                                                ToolTip.Tip="The part again straight after itself: twice as long, to change the second time round" />
                                        <Button Content="First half" Command="{Binding ToolCommand}" CommandParameter="half"
                                                ToolTip.Tip="Just its first half: for a part that plays the same idea twice" />
                                        <Button Content="Reverse" Command="{Binding ToolCommand}" CommandParameter="reverse"
                                                ToolTip.Tip="Back to front: the last note first" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                            </Expander>
                            <!-- Listening: on its own or together, looping, at a tempo to try it at. -->
                            <WrapPanel>
                                <!-- Playing it with what it's fitted to: the small playground's Play, above. -->
                                <StackPanel Classes="group" Margin="0,0,6,6">
                                    <Button Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).PlaySelectedAloneCommand}"
                                            ToolTip.Tip="Listen to this part on its own. Click along the notes to jump.">
                                        <Panel>
                                            <TextBlock Text="▶  Play" IsVisible="{Binding !IsPlayingAlone}" />
                                            <TextBlock Text="■  Stop" IsVisible="{Binding IsPlayingAlone}" />
                                        </Panel>
                                    </Button>
                                    <ToggleButton IsChecked="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).Loop}"
                                                  ToolTip.Tip="Play round and round until you stop it">
                                        <TextBlock Text="↻  Loop" />
                                    </ToggleButton>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,10,6" VerticalAlignment="Center"
                                            ToolTip.Tip="The tempo to try it at. Drag files and Bitwig clips take this tempo too.">
                                    <Slider Width="130" Minimum="40" Maximum="240" Value="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).TempoValue}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).TempoText}" Classes="small" VerticalAlignment="Center" MinWidth="78" />
                                    <Button Content="Own" Padding="6,1" FontSize="11" Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).OwnTempoCommand}"
                                            IsVisible="{Binding !$parent[UserControl].((vm:MidiBrowserViewModel)DataContext).HasOwnTempo}" ToolTip.Tip="Back to its own tempo" />
                                </StackPanel>
                                <Border Classes="dragChip" Margin="0,0,6,6" views:FileDrag.Source="{Binding $parent[UserControl].DataContext}"
                                        ToolTip.Tip="Drag into your DAW as a MIDI clip: moved into key and octave, with your edits">
                                    <TextBlock Text="Drag into your DAW" />
                                </Border>
                                <Button Content="To the playground" Margin="0,0,6,6" Classes="accent"
                                        Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).SendToPlaygroundCommand}"
                                        ToolTip.Tip="Add this part, as it plays here (moved, octave and edits), to the section you're building in the playground" />
                                <Button Content="Send to Bitwig" Margin="0,0,6,6" Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).SendBothToBitwigCommand}"
                                        ToolTip.Tip="This part, and what it's fitted to, each on a new track in Bitwig as a clip, to carry on with the idea there" />
                                <Button Content="Get better sounds" Margin="0,0,6,6" Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).GetSoundsCommand}"
                                        IsVisible="{Binding !$parent[UserControl].((vm:MidiBrowserViewModel)DataContext).HasGoodSounds}" ToolTip.Tip="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).SoundsText}" />
                            </WrapPanel>
                            <!-- Octave, when not fitting (fitting has it by the piano roll). -->
                            <WrapPanel IsVisible="{Binding !$parent[UserControl].((vm:MidiBrowserViewModel)DataContext).IsPairing}" ToolTip.Tip="{Binding OctaveWhy}">
                                <ComboBox ItemsSource="{x:Static vm:MidiBrowserViewModel.SoundChoices}" SelectedItem="{Binding Sound}" Margin="0,0,6,6"
                                          FontSize="12" MinWidth="150" ToolTip.Tip="The sound this kind of part plays with" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                <Button Content="−" Padding="10,3" Command="{Binding OctaveDownCommand}" IsVisible="{Binding CanChangeOctave}" ToolTip.Tip="An octave down" />
                                <TextBlock Text="{Binding OctaveText}" VerticalAlignment="Center" MinWidth="96" TextAlignment="Center" IsVisible="{Binding CanChangeOctave}" />
                                <Button Content="+" Padding="10,3" Command="{Binding OctaveUpCommand}" IsVisible="{Binding CanChangeOctave}" ToolTip.Tip="An octave up" />
                                <Button Content="Reset" Padding="8,3" FontSize="12" Command="{Binding ResetOctaveCommand}" IsVisible="{Binding IsYourOctave}"
                                        ToolTip.Tip="Let the app pick the octave again" />
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <Border Classes="pill" Margin="0,0,6,6" IsVisible="{Binding ShowsInstrument}" ToolTip.Tip="{Binding InstrumentWhy}">
                                    <TextBlock Classes="pillText" Text="{Binding InstrumentText}" />
                                </Border>
                                <Border Classes="pill" Margin="0,0,6,6" ToolTip.Tip="{Binding RoleWhy}">
                                    <TextBlock Classes="pillText" Text="{Binding RoleLabel}" />
                                </Border>
                                <Border Classes="pill" Margin="0,0,6,6" IsVisible="{Binding KeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Classes="pillText" Text="{Binding KeyText}" />
                                </Border>
                                <Border Classes="pill" Margin="0,0,6,6">
                                    <TextBlock Classes="pillText" Text="{Binding BarsText}" />
                                </Border>
                                <Border Classes="pill" Margin="0,0,6,6" IsVisible="{Binding IsEdited}" ToolTip.Tip="You've edited it on the piano roll: playing, dragging and saving use your edits">
                                    <TextBlock Classes="pillText" Text="Edited" />
                                </Border>
                                <Border Classes="pill" Margin="0,0,6,6" IsVisible="{Binding HasPhrase}" ToolTip.Tip="{Binding PhraseWhy}">
                                    <TextBlock Classes="pillText" Text="{Binding PhraseText}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding ChordsText, StringFormat='Chords: {0}'}" TextWrapping="Wrap" FontSize="12.5"
                                       IsVisible="{Binding ChordsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding InstrumentWhy, StringFormat='Instrument: {0}'}" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{StaticResource MutedBrush}" IsVisible="{Binding HasInstrument}" />
                            <TextBlock Text="{Binding FitWhy}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                       IsVisible="{Binding HasFit}" />
                            <!-- What kind of part it is: one click puts it right, for every copy. -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="What kind of part is it?" Classes="small" ToolTip.Tip="{Binding RoleWhy}" />
                                <ItemsControl ItemsSource="{Binding RoleOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RoleOption">
                                            <ToggleButton Classes="chip" Margin="0,0,6,6" FontSize="12" Content="{Binding Label}"
                                                          IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                                          Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).SetRoleCommand}"
                                                          CommandParameter="{Binding Role}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <WrapPanel>
                                <Button Content="What goes with this?" Margin="0,0,6,6"
                                        Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).FitToSelectedCommand}"
                                        ToolTip.Tip="Parts whose harmony fits this one: melodies and basslines for chords, chords for a melody or bassline" />
                                <Button Content="Show the whole phrase" Margin="0,0,6,6" IsVisible="{Binding CanShowWholePhrase}"
                                        Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).ShowWholePhraseCommand}"
                                        ToolTip.Tip="The longer phrases this clip is part of in its song, with it lit up" />
                                <Button Content="More like this" Margin="0,0,6,6"
                                        Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).MoreLikeSelectedCommand}"
                                        ToolTip.Tip="Parts with a similar shape (how chordal, busy, low and rhythmic it is), whatever key they're in" />
                                <Button Content="Show where it's from" Margin="0,0,6,6"
                                        Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).ShowSourceCommand}" />
                                <Button Content="Save as…" Margin="0,0,6,6"
                                        Command="{Binding $parent[UserControl].((vm:MidiBrowserViewModel)DataContext).SaveSelectedCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
            </views:MidiListView.Side>
        </views:MidiListView>
    </Grid>
</UserControl>
