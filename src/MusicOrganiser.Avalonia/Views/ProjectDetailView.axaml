<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganiser.ViewModels"
             xmlns:lib="using:MusicOrganiser.Core.Library"
             xmlns:dl="using:MusicOrganiser.Core.DawLink"
             xmlns:sys="using:System"
             xmlns:v="using:MusicOrganiser.Avalonia.Views"
             x:Class="MusicOrganiser.Avalonia.Views.ProjectDetailView"
             x:DataType="vm:ProjectDetailViewModel">
    <UserControl.Styles>
        <!-- The looks are the app's shared ones (Studio.axaml); only what's this page's own is here. -->
        <Style Selector="WrapPanel.actions > Button">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="TextBlock.mark">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.mark.same">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="TextBlock.mark.different">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        </Style>
        <!-- Thin lines between the toolbar's groups that share a line. -->
        <Style Selector="v|ToolbarPanel > Border">
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="11,0,0,0" />
        </Style>
        <Style Selector="v|ToolbarPanel > Border.divided">
            <Setter Property="BorderBrush" Value="{DynamicResource StudioEdgeBrush}" />
        </Style>
        <!-- The slim line of the song's own marks under its name. -->
        <Style Selector="WrapPanel.fieldsLine > :is(Control)">
            <Setter Property="Margin" Value="0,0,18,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The heart: an outline, filled red when it's a favourite. -->
        <Style Selector="ToggleButton.heart Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource FaintBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.heart:checked Path">
            <Setter Property="Fill" Value="{StaticResource MissingBrush}" />
            <Setter Property="Stroke" Value="{StaticResource MissingBrush}" />
        </Style>
        <!-- Overview's line of counts: links to their tabs, with anything missing in red. -->
        <Style Selector="Button.link TextBlock.missing">
            <Setter Property="Foreground" Value="{StaticResource MissingBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.countDot">
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style Selector="Border.fixBadge">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        </Style>
        <Style Selector="Border.fixBadge.relink">
            <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
        </Style>
        <Style Selector="Border.fixBadge.relink TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="Border.fixBadge.suggestion TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        </Style>
        <Style Selector="Border.fixBadge.missing TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MissingBrush}" />
        </Style>
        <Style Selector="Border.fixPanel">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="MatchTemplate" x:DataType="vm:MatchRow">
            <DockPanel Margin="12,3,0,3">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" IsVisible="{Binding CanRecover}">
                    <Button Content="Show" Command="{Binding RevealCommand}" />
                    <Button Content="Use this" Classes="accent" Command="{Binding RecoverCommand}"
                            ToolTip.Tip="Copy this file into the project folder under the name the project expects" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}" Margin="8,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource AccentBrush}" ToolTip.Tip="{Binding Reason}" />
                <TextBlock Text="{Binding Candidate}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding Candidate}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header: what it is and your own marks on it, then one toolbar with every way to open it and everything else. -->
        <StackPanel DockPanel.Dock="Top" Margin="24,20,24,0">
            <WrapPanel>
                <Border Classes="pill" Margin="0,0,8,0" Background="{Binding Item.Daw, Converter={StaticResource DawBrush}}">
                    <TextBlock Text="{Binding Item.Daw}" Classes="pillText" Foreground="{StaticResource InkBrush}" FontWeight="Bold" />
                </Border>
                <Border Classes="pill" Margin="0,0,8,0" Background="{StaticResource OkSoftBrush}" IsVisible="{Binding IsLive}">
                    <TextBlock Text="{Binding LiveText}" Classes="pillText" Foreground="{StaticResource OkBrush}" />
                </Border>
                <TextBlock Text="{Binding HeaderFacts}" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding SavesText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap" IsVisible="{Binding HasOlderSaves}" />
                <TextBlock Text="{Binding LiveText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="8,0,0,0" IsVisible="{Binding OlderSaveOpen}" />
            </WrapPanel>
            <TextBlock Text="{Binding Item.Name}" FontFamily="{DynamicResource TitleFont}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0" />

            <!-- Your own marks on the song, in one slim line: where it's at, stars, favourite and key (tags and notes are on Details). -->
            <WrapPanel Classes="fieldsLine" Margin="0,10,0,0">
                <ComboBox MinWidth="132" HorizontalAlignment="Left" ItemsSource="{x:Static vm:ProjectsViewModel.StatusChoices}"
                          SelectedItem="{Binding Item.Status}" ToolTip.Tip="Where it's at" />
                <v:StarRating Value="{Binding Item.Rating}" />
                <ToggleButton Classes="heart flat" IsChecked="{Binding Item.Favourite}" ToolTip.Tip="Favourite: the Favourites filter shows these">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="M12,20.5 C12,20.5 3,14.6 3,8.6 C3,5.6 5.3,3.5 8.1,3.5 C9.8,3.5 11.2,4.4 12,5.7 C12.8,4.4 14.2,3.5 15.9,3.5 C18.7,3.5 21,5.6 21,8.6 C21,14.6 12,20.5 12,20.5 Z" />
                        <TextBlock Text="Favourite" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="KEY" Classes="filterLabel" VerticalAlignment="Center" Margin="0" />
                    <TextBox Classes="clearButton" Width="150" PlaceholderText="{Binding Item.KeyHint}"
                             ToolTip.Tip="Worked out from the notes (drums left out) until you type one in"
                             Text="{Binding Item.MusicalKey, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </WrapPanel>

            <!-- One toolbar: the ways to open it on the left; file, export and repair on the right (wrapping under when narrow). -->
            <v:ToolbarPanel x:Name="Toolbar" Margin="0,10,0,0">
                <StackPanel Classes="group">
                    <Button Classes="accent" Command="{Binding OpenMainCommand}" ToolTip.Tip="{Binding OpenMainTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="M7,4 L20,12 L7,20 Z" Classes="buttonIcon filled" />
                            <TextBlock Text="{Binding OpenMainText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenInDawCommand}" IsVisible="{Binding IsFlStudio}" ToolTip.Tip="Open the newest save in FL Studio itself">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="M7,4 L20,12 L7,20 Z" Classes="buttonIcon filled" />
                            <TextBlock Text="Open in FL Studio" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OlderSaves" IsVisible="{Binding HasOlderSaves}" ToolTip.Tip="{Binding OlderSavesTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Older saves" />
                            <Path Data="M6,9 L12,15 L18,9" Classes="buttonIcon" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Border>
                    <StackPanel Classes="group">
                        <Button Command="{Binding RevealCommand}" ToolTip.Tip="Show the project file in its folder">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="{StaticResource NavIcon.Projects}" Classes="buttonIcon" />
                                <TextBlock Text="Show in folder" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopyPathCommand}" ToolTip.Tip="Copy where the project file is, to paste somewhere else">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="M9,9 L19,9 L19,19 L9,19 Z M5,15 L5,5 L15,5" Classes="buttonIcon" />
                                <TextBlock Text="Copy path" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel Classes="group">
                        <Button Content="MIDI…" Command="{Binding ShowMidiCommand}" IsEnabled="{Binding CanExtractMidi}" ToolTip.Tip="{Binding MidiNote}" />
                        <Button Content="Presets…" Command="{Binding ShowPresetsCommand}" IsEnabled="{Binding CanExtractPresets}"
                                ToolTip.Tip="See the plugin settings saved in this project and export them as presets" />
                        <Button Content="DAWproject" Command="{Binding ExportToBitwigCommand}" IsVisible="{Binding IsFlStudio}"
                                ToolTip.Tip="Convert this FL Studio project into a DAWproject file, the open format Bitwig and Studio One import" />
                    </StackPanel>
                </Border>
                <Border>
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="CanFix" />
                            <Binding Path="CanCheckWithDaw" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Classes="group">
                        <Button Classes="trouble" Command="{Binding PlanFixCommand}" IsVisible="{Binding CanFix}" ToolTip.Tip="{Binding FixTip}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="M14.7,6.3 a4,4 0 0 0 -5.4,5.4 L4,17 L7,20 L12.3,14.7 a4,4 0 0 0 5.4,-5.4 L15.5,11.5 L12.5,8.5 Z" Classes="buttonIcon" />
                                <TextBlock Text="{Binding FixButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Content="{Binding CheckWithDawText}" Command="{Binding CheckWithDawCommand}" IsVisible="{Binding CanCheckWithDaw}"
                                ToolTip.Tip="Compare what the app read from this file with what the DAW shows for it" />
                    </StackPanel>
                </Border>
            </v:ToolbarPanel>
            <Border Classes="note" Margin="0,10,0,0" Padding="12,8" CornerRadius="{DynamicResource RadiusM}" Background="{StaticResource AccentFaintBrush}"
                    IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
            </Border>
            <!-- A fixed copy waiting for its verdict: open it, then Keep or Delete fixed copy. -->
            <Border Classes="panel" Padding="14,12" Margin="0,10,0,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" IsVisible="{Binding HasPendingFix}">
                <StackPanel Spacing="10">
                    <StackPanel>
                        <TextBlock Text="{Binding PendingFixText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PendingFixDetail}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Classes="actions">
                        <Button Content="{Binding Item.Daw, StringFormat='Open in {0}'}" Command="{Binding OpenFixedCommand}"
                                Classes.accent="{Binding !PendingFixOpened}" />
                        <Button Content="Open fix in Bitwig" Command="{Binding OpenFixedInBitwigCommand}" IsVisible="{Binding IsFlStudio}"
                                ToolTip.Tip="Convert the fixed copy for Bitwig and open it there" />
                        <Button Content="Keep" Classes="accent" Command="{Binding KeepFixedCommand}" IsVisible="{Binding PendingFixOpened}" />
                        <Button Content="Delete fixed copy" Command="{Binding DeleteFixedCommand}" IsVisible="{Binding PendingFixOpened}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <!-- The last check with the DAW: what it shows, against what the app read -->
            <Border Classes="panel" Padding="14,12" Margin="0,6,0,0" IsVisible="{Binding HasCheckLines}">
                <ItemsControl ItemsSource="{Binding CheckLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dl:CheckLine">
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" Width="18" FontSize="12" FontWeight="SemiBold" Classes="mark"
                                           Classes.same="{Binding Result, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dl:CheckResult.Same}}"
                                           Classes.different="{Binding Result, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dl:CheckResult.Different}}" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Warnings about what could be read -->
            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="{DynamicResource RadiusM}" Background="{StaticResource WarningSoftBrush}" IsVisible="{Binding HasWarnings}">
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2" Foreground="{StaticResource WarningBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <TabControl x:Name="Tabs" Margin="12,14,12,0">
            <TabItem Header="Overview" IsSelected="{Binding PreviewShown, Mode=OneWayToSource}">
                <!-- A line of counts, then the arrangement filling the rest. Fix's list opens under it, with a divider to drag between them. -->
                <Grid x:Name="OverviewGrid" Margin="12,10,12,12" RowDefinitions="Auto,*,Auto,Auto">
                    <WrapPanel Margin="-4,0,0,8">
                        <Button Classes="link" Tag="Plugins" Click="OnSeeAll" ToolTip.Tip="See every plugin on the Plugins tab">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding PluginsCountText}" />
                                <TextBlock Classes="missing" Text="{Binding MissingPluginsText, StringFormat='({0})'}"
                                           IsVisible="{Binding MissingPluginsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Classes="countDot" Text="·" />
                        <Button Classes="link" Tag="Samples" Click="OnSeeAll" ToolTip.Tip="See every sample on the Samples tab">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding SamplesCountText}" />
                                <TextBlock Classes="missing" Text="{Binding MissingSamplesText, StringFormat='({0})'}"
                                           IsVisible="{Binding MissingSamplesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Classes="countDot" Text="·" />
                        <Button Classes="link" Tag="Saves" Click="OnSeeAll" ToolTip.Tip="See every save, and change which song they go under, on the Saves tab">
                            <TextBlock Text="{Binding SavesCountText}" />
                        </Button>
                        <TextBlock Classes="countDot" Text="·" />
                        <Button Classes="link" Tag="Details" Click="OnSeeAll" ToolTip.Tip="See the tracks, your tags and notes, and the file's details">
                            <TextBlock Text="{Binding TracksCountText}" />
                        </Button>
                        <TextBlock Classes="countDot" Text="·" />
                        <Button Classes="link" Tag="MIDI that fits" Click="OnSeeAll"
                                ToolTip.Tip="MIDI from your other songs and MIDI folders that fits this one, already in its key">
                            <TextBlock Text="{Binding SongMidi.LinkText}" />
                        </Button>
                    </WrapPanel>

                    <!-- The arrangement. Read when Overview first shows; Full size opens it in its own window. -->
                    <v:ArrangementPanel Grid.Row="1" Margin="-12,-4,-12,0" IsVisible="{Binding CanPreview}" />

                    <GridSplitter x:Name="ArrangementDivider" Grid.Row="2" Height="14" Background="Transparent" ResizeDirection="Rows"
                                  IsVisible="{Binding IsFixOpen}" DragCompleted="OnArrangementDividerMoved"
                                  ToolTip.Tip="Drag to give the arrangement or Fix's list more room" />

                    <!-- Fix's preview: one line per missing thing and the best guess, then save a fixed copy. -->
                    <Border Grid.Row="3" Classes="panel fixPanel" Padding="14,12" IsVisible="{Binding IsFixOpen}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FixSummary}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FixHeading}" Classes="filterLabel" Margin="0" />
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Classes="accent" Content="Save fixed copy" Command="{Binding SaveFixedCommand}" Padding="16,8"
                                        ToolTip.Tip="Write the ticked samples into a copy next to the original" />
                                <Button Content="Cancel" Command="{Binding CloseFixCommand}" Padding="16,8" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding FixFootnote}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <ItemsControl Classes="longList" ItemsSource="{Binding FixRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FixRow">
                                <Border Classes="row" Margin="-10,0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Ticked}" IsVisible="{Binding CanTick}" VerticalAlignment="Top"
                                                  Margin="0,0,6,0" MinWidth="0" ToolTip.Tip="Use this file in the fixed copy" />
                                        <Border DockPanel.Dock="Left" Width="34" IsVisible="{Binding !CanTick}" />
                                        <Border DockPanel.Dock="Right" Classes="pill fixBadge" VerticalAlignment="Top" Margin="10,0,0,0"
                                                Classes.relink="{Binding IsRelink}" Classes.suggestion="{Binding IsSuggestion}" Classes.missing="{Binding IsMissing}">
                                            <TextBlock Text="{Binding ActionText}" Classes="pillText" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding KindText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                <Run Text="  " />
                                                <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <!-- Where the project expected it: a clue to where it went (and selectable, to copy). -->
                                            <SelectableTextBlock Text="{Binding LookedFor}" IsVisible="{Binding HasLookedFor}" FontSize="11.5"
                                                                 Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,1,0,2" />
                                            <TextBlock Text="{Binding Use, StringFormat='→ {0}'}" FontSize="12"
                                                       Foreground="{StaticResource AccentBrush}" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding Use}">
                                                <TextBlock.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="HasUse" />
                                                        <Binding Path="!HasChoices" />
                                                    </MultiBinding>
                                                </TextBlock.IsVisible>
                                            </TextBlock>
                                            <!-- Several copies or close matches: the best is picked, the others are a click away. -->
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Chosen}" IsVisible="{Binding HasChoices}"
                                                      HorizontalAlignment="Stretch" FontSize="12" Margin="0,2,0,2" ToolTip.Tip="{Binding ChoicesTip}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="sys:String">
                                                        <TextBlock Text="{Binding}" FontSize="12" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Plugins">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding PluginHeader}" Classes="sectionHeader" Margin="12,14,12,6" />
                        <Button Classes="link" DockPanel.Dock="Bottom" Content="{Binding SilentToggleText}" Padding="8,4" Margin="4,4,12,12"
                                HorizontalAlignment="Left" FontSize="12"
                                Command="{Binding ToggleSilentCommand}" ToolTip.Tip="Synths on channels that play no notes in the song"
                                IsVisible="{Binding SilentCount, Converter={StaticResource NonZero}}" />
                        <ItemsControl Classes="longList" Padding="12,0,12,8" ItemsSource="{Binding VisiblePlugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginRow">
                                    <Border Classes="row" Margin="-10,0">
                                        <StackPanel>
                                            <StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                        <Border Classes="pill" Background="{StaticResource MissingSoftBrush}" Margin="0,0,6,0"
                                                                IsVisible="{Binding !Installed}">
                                                            <TextBlock Text="Not installed" Classes="pillText" Foreground="{StaticResource MissingBrush}" />
                                                        </Border>
                                                        <Border Classes="pill" Background="{StaticResource OkSoftBrush}"
                                                                IsVisible="{Binding Elektron, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <TextBlock Text="{Binding Elektron, StringFormat='Elektron · {0}'}" Classes="pillText"
                                                                       Foreground="{StaticResource OkBrush}" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding KindText, Mode=OneWay}" />
                                                        <Run Text="{Binding Format, Mode=OneWay}" />
                                                        <Run Text="{Binding Vendor, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding OtherVersion, StringFormat='You have {0} installed'}" FontSize="12"
                                                               Foreground="{StaticResource OkBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               ToolTip.Tip="A different version of this plugin. The project won't load it by itself; swap it in."
                                                               IsVisible="{Binding OtherVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <WrapPanel Classes="rowActions" Margin="0,4,0,0" ItemSpacing="4" LineSpacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !Installed}">
                                                        <Button Content="Find similar" Command="{Binding FindSimilarCommand}" />
                                                        <Button Content="Search online" Command="{Binding SearchOnlineCommand}" />
                                                    </StackPanel>
                                                    <Button Content="Preset"
                                                            ToolTip.Tip="Export this plugin's settings from the project as a preset"
                                                            IsVisible="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).CanExtractPresets}"
                                                            Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).ExportPluginPresetCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Projects" ToolTip.Tip="Show every project that uses this plugin"
                                                            Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).ShowProjectsUsingPluginCommand}"
                                                            CommandParameter="{Binding}" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MatchMessage}" FontSize="12" Margin="12,4,0,0" Foreground="{StaticResource MutedBrush}"
                                                       IsVisible="{Binding MatchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <ItemsControl ItemsSource="{Binding Matches}" ItemTemplate="{StaticResource MatchTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
            </TabItem>

            <TabItem Header="Samples">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SampleHeader}" Classes="sectionHeader" Margin="12,14,12,6" />
                        <ItemsControl Classes="longList" Padding="12,0,12,20" ItemsSource="{Binding Samples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SampleRow">
                                    <Border Classes="row" Margin="-10,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Classes="rowActions">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !Found}">
                                                        <Button Content="Find matches" Command="{Binding FindMatchesCommand}" />
                                                        <Button Content="Search online" Command="{Binding SearchOnlineCommand}" />
                                                    </StackPanel>
                                                    <Button Content="Show" Command="{Binding RevealCommand}" IsVisible="{Binding Found}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                        <Border Classes="pill" Background="{StaticResource MissingSoftBrush}" IsVisible="{Binding !Found}">
                                                            <TextBlock Text="Can't be found" Classes="pillText" Foreground="{StaticResource MissingBrush}" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                               ToolTip.Tip="{Binding Path}" Foreground="{StaticResource FaintBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding MatchMessage}" FontSize="12" Margin="12,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       IsVisible="{Binding MatchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <ItemsControl ItemsSource="{Binding Matches}" ItemTemplate="{StaticResource MatchTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
            </TabItem>

            <TabItem Header="Saves">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,14,12,20" Spacing="6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Reset" IsVisible="{Binding HasSongChanges}"
                                    Command="{Binding ResetSongCommand}"
                                    ToolTip.Tip="Undo your changes to this song: its saves go back to how the app grouped them from their names and folder" />
                            <TextBlock Text="{Binding AllSavesHeader}" Classes="sectionHeader" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SaveRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SaveRow">
                                    <Border Classes="row" Padding="10,4" Margin="-10,0">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Classes="rowActions">
                                                <!-- A save FL Studio didn't finish writing, newest or not, can be fixed from here (Solomon, 27 Oct). -->
                                                <Button Classes="trouble" Content="Fix…" IsVisible="{Binding Damaged}" ToolTip.Tip="{Binding FixTip}"
                                                        Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).FixSaveCommand}"
                                                        CommandParameter="{Binding Save}" />
                                                <Button Content="Open"
                                                        Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).OpenSaveCommand}"
                                                        CommandParameter="{Binding Save}" />
                                                <Button Content="Show"
                                                        Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).RevealSaveCommand}"
                                                        CommandParameter="{Binding Save}" />
                                                <Button Content="Move…" ToolTip.Tip="Move this save to another song (pick it below)"
                                                        IsVisible="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).HasOlderSaves}"
                                                        Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).MoveSaveCommand}"
                                                        CommandParameter="{Binding Save}" />
                                                <Button Content="Own song" ToolTip.Tip="Take this save out of the song, into a song of its own"
                                                        IsVisible="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).HasOlderSaves}"
                                                        Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).SplitOffCommand}"
                                                        CommandParameter="{Binding Save}" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Save.Modified, StringFormat='d MMM yyyy'}" Margin="8,0"
                                                       VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                                            <Border DockPanel.Dock="Right" Classes="pill" Background="{StaticResource MissingSoftBrush}" VerticalAlignment="Center"
                                                    IsVisible="{Binding Damaged}" ToolTip.Tip="{Binding FixTip}">
                                                <TextBlock Text="Damaged" Classes="pillText" Foreground="{StaticResource MissingBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Save.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Save.Path}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,16,0,0">
                            <Button DockPanel.Dock="Right" Content="Cancel" IsVisible="{Binding IsMovingSave}"
                                    Command="{Binding CancelMoveCommand}" ToolTip.Tip="Put the whole song under another instead" />
                            <TextBlock Text="{Binding MoveTitle}" Classes="sectionHeader" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                                   Text="If the app grouped these wrong, pick the song they belong to. Songs in the same folder come first; type to find any other." />
                        <TextBox Classes="clearButton" PlaceholderText="Find a song by name" Text="{Binding SongSearch}" />
                        <ItemsControl ItemsSource="{Binding SongMatches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectItem">
                                    <Border Classes="row" Padding="10,4" Margin="-10,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Put here"
                                                    Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).JoinSongCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Make it a save of this song" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Modified, StringFormat='d MMM yyyy'}" Margin="8,0"
                                                       VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Daw}" /><Run Text=" · " /><Run Text="{Binding FolderName}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding !HasSongMatches}" TextWrapping="Wrap"
                                   Text="No songs found. Type part of a song's name." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- How much room the song takes, and Compact (Solomon, 25 Oct 2026). -->
            <TabItem Header="Space">
                <ContentControl Margin="12,14,12,12" Content="{Binding Space}" />
            </TabItem>

            <!-- MIDI from your other projects and MIDI folders that fits this song's harmony, already in its key. -->
            <TabItem Header="MIDI that fits">
                <ContentControl Margin="12,14,12,12" Content="{Binding SongMidi}" />
            </TabItem>

            <TabItem Header="Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,14,12,20">
                        <TextBlock Text="Your notes" Classes="sectionHeader" Margin="0,0,0,8" />
                        <TextBlock Text="TAGS" Classes="filterLabel" />
                        <TextBox Classes="clearButton" PlaceholderText="techno, live set, collab"
                                 Text="{Binding Item.TagsText, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="NOTES" Classes="filterLabel" Margin="0,12,0,0" />
                        <TextBox MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"
                                 PlaceholderText="Ideas, to-dos, what this needs next…"
                                 Text="{Binding Item.Notes, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="Tracks and channels" Classes="sectionHeader" Margin="0,20,0,8" />
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <Border Margin="0,0,6,6" Padding="10,3" CornerRadius="{DynamicResource RadiusM}" Background="{StaticResource SurfaceRaisedBrush}">
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="File" Classes="sectionHeader" Margin="0,16,0,8" />
                        <Border Classes="panel" Padding="14,12">
                            <ItemsControl ItemsSource="{Binding Facts}">
                                <ItemsControl.ItemTemplate>
                                    <!-- A generic pair, which compiled bindings can't name, so this one binds by reflection. -->
                                    <DataTemplate x:CompileBindings="False">
                                        <Grid Margin="0,3" ColumnDefinitions="130,*">
                                            <TextBlock Text="{Binding Key}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
