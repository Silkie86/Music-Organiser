<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganiser.ViewModels"
             xmlns:lib="using:MusicOrganiser.Core.Library"
             xmlns:dl="using:MusicOrganiser.Core.DawLink"
             xmlns:sys="using:System"
             xmlns:v="using:MusicOrganiser.Avalonia.Views"
             x:Class="MusicOrganiser.Avalonia.Views.ProjectDetailView"
             x:DataType="vm:ProjectDetailViewModel">
    <UserControl.Styles>
        <!-- A list row that lights up under the mouse; its buttons stay quiet until then. -->
        <Style Selector="Border.listRow">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="-10,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.listRow:pointerover">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        </Style>
        <Style Selector=":is(Panel).rowActions">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="StackPanel.rowActions">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <Style Selector="Border.listRow:pointerover :is(Panel).rowActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.row">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="WrapPanel.actions > Button">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="TextBlock.mark">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.mark.same">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="TextBlock.mark.different">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        </Style>
        <Style Selector="Button.bigAction">
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Overview's glance column: plugin chips (missing ones red), each section linking to its full tab. -->
        <Style Selector="Border.glanceChip">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Border.glanceChip TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.glanceChip.missing">
            <Setter Property="Background" Value="{StaticResource MissingSoftBrush}" />
        </Style>
        <Style Selector="Border.glanceChip.missing TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MissingBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.glanceChip.silent">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.seeAll">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.newest">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The song's actions: small labelled groups that wrap onto a second line when the panel is narrow. -->
        <Style Selector="WrapPanel.actionGroups > StackPanel">
            <Setter Property="Margin" Value="0,0,22,8" />
        </Style>
        <Style Selector="WrapPanel.actionGroups > StackPanel > TextBlock.filterLabel">
            <Setter Property="Margin" Value="2,0,0,5" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        </Style>
        <Style Selector="Path.toolIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool.fix Path.toolIcon">
            <Setter Property="Stroke" Value="{StaticResource MissingBrush}" />
        </Style>
        <Style Selector="Border.trouble">
            <Setter Property="Background" Value="{StaticResource MissingSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TroubleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Border.fixBadge">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        </Style>
        <Style Selector="Border.fixBadge.relink">
            <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
        </Style>
        <Style Selector="Border.fixBadge.relink TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="Border.fixBadge.suggestion TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        </Style>
        <Style Selector="Border.fixBadge.missing TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MissingBrush}" />
        </Style>
        <Style Selector="Border.fixPanel">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TabControl.detailTabs TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="MatchTemplate" x:DataType="vm:MatchRow">
            <DockPanel Margin="12,3,0,3">
                <Button DockPanel.Dock="Right" Content="Use this" Classes="row accent" Command="{Binding RecoverCommand}"
                        IsVisible="{Binding CanRecover}"
                        ToolTip.Tip="Copy this file into the project folder under the name the project expects" />
                <Button DockPanel.Dock="Right" Content="Show" Classes="row" Command="{Binding RevealCommand}" IsVisible="{Binding CanRecover}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}" Margin="8,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource AccentBrush}" ToolTip.Tip="{Binding Reason}" />
                <TextBlock Text="{Binding Candidate}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip.Tip="{Binding Candidate}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header: what it is, the one big action, then everything else in tabs. -->
        <StackPanel DockPanel.Dock="Top" Margin="24,22,24,0">
            <WrapPanel>
                <Border Classes="pill" Margin="0,0,8,0" Background="{Binding Item.Daw, Converter={StaticResource DawBrush}}">
                    <TextBlock Text="{Binding Item.Daw}" Classes="pillText" Foreground="{StaticResource InkBrush}" FontWeight="Bold" />
                </Border>
                <Border Classes="pill" Margin="0,0,8,0" Background="{StaticResource OkSoftBrush}" IsVisible="{Binding IsLive}">
                    <TextBlock Text="{Binding LiveText}" Classes="pillText" Foreground="{StaticResource OkBrush}" />
                </Border>
                <TextBlock Text="{Binding DatesText}" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding SavesText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap" IsVisible="{Binding HasOlderSaves}" />
                <TextBlock Text="{Binding LiveText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="8,0,0,0" IsVisible="{Binding OlderSaveOpen}" />
            </WrapPanel>
            <TextBlock Text="{Binding Item.Name}" FontFamily="{DynamicResource TitleFont}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Text="{Binding Item.DetailsLine}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <!-- A split button: the big part opens the newest save; the arrow lists the other ways and older versions. -->
            <Border CornerRadius="{DynamicResource RadiusL}" ClipToBounds="True" Margin="0,18,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Classes="accent bigAction" CornerRadius="0" Command="{Binding OpenMainCommand}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="{Binding OpenMainTip}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M7,4 L20,12 L7,20 Z" Fill="{StaticResource OnAccentBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OpenMainText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="1" Width="1" Background="{StaticResource OnAccentBrush}" Opacity="0.25" IsVisible="{Binding HasOpenChoices}" />
                    <Button Grid.Column="2" x:Name="OpenChoices" Classes="accent bigAction" CornerRadius="0" Width="46" Padding="0"
                            IsVisible="{Binding HasOpenChoices}" ToolTip.Tip="{Binding OpenChoicesTip}">
                        <Path Data="M6,9 L12,15 L18,9" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="2.2" StrokeLineCap="Round"
                              StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight" />
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <!-- Everything else you can do with the song, out in the open in small labelled groups (no ⋯ menu to hunt in). -->
            <WrapPanel Classes="actionGroups" Margin="0,14,0,0">
                <StackPanel IsVisible="{Binding IsFlStudio}">
                    <TextBlock Text="OPEN" Classes="filterLabel" />
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="tool" Command="{Binding OpenInDawCommand}" ToolTip.Tip="Open the newest save in FL Studio itself">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="M7,4 L20,12 L7,20 Z" Classes="toolIcon" />
                                <TextBlock Text="In FL Studio" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="FILE" Classes="filterLabel" />
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="tool" Command="{Binding RevealCommand}" ToolTip.Tip="Show the project file in its folder">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="{StaticResource NavIcon.Projects}" Classes="toolIcon" />
                                <TextBlock Text="Show in folder" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool" Command="{Binding CopyPathCommand}" ToolTip.Tip="Copy where the project file is, to paste somewhere else">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="M9,9 L19,9 L19,19 L9,19 Z M5,15 L5,5 L15,5" Classes="toolIcon" />
                                <TextBlock Text="Copy path" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="EXPORT" Classes="filterLabel" />
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="tool" Content="MIDI…" Command="{Binding ShowMidiCommand}" IsEnabled="{Binding CanExtractMidi}" ToolTip.Tip="{Binding MidiNote}" />
                        <Button Classes="tool" Content="Presets…" Command="{Binding ShowPresetsCommand}" IsEnabled="{Binding CanExtractPresets}"
                                ToolTip.Tip="See the plugin settings saved in this project and export them as presets" />
                        <Button Classes="tool" Content="DAWproject" Command="{Binding ExportToBitwigCommand}" IsVisible="{Binding IsFlStudio}"
                                ToolTip.Tip="Convert this FL Studio project into a DAWproject file, the open format Bitwig and Studio One import" />
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="CanFix" />
                            <Binding Path="CanCheckWithDaw" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <TextBlock Text="REPAIR AND CHECK" Classes="filterLabel" />
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="tool fix" Command="{Binding PlanFixCommand}" IsVisible="{Binding CanFix}"
                                ToolTip.Tip="Find what's missing on your drives and save a fixed copy next to the original">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="M14.7,6.3 a4,4 0 0 0 -5.4,5.4 L4,17 L7,20 L12.3,14.7 a4,4 0 0 0 5.4,-5.4 L15.5,11.5 L12.5,8.5 Z" Classes="toolIcon" />
                                <TextBlock Text="{Binding FixButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="tool" Content="{Binding CheckWithDawText}" Command="{Binding CheckWithDawCommand}" IsVisible="{Binding CanCheckWithDaw}"
                                ToolTip.Tip="Compare what the app read from this file with what the DAW shows for it" />
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
            <Border Classes="note" Margin="0,10,0,0" Padding="12,8" CornerRadius="{DynamicResource RadiusM}" Background="{StaticResource AccentFaintBrush}"
                    IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
            </Border>
            <!-- A fixed copy waiting for its verdict: open it, then Keep or Delete fixed copy. -->
            <Border Classes="panel" Margin="0,10,0,0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" IsVisible="{Binding HasPendingFix}">
                <StackPanel Spacing="10">
                    <StackPanel>
                        <TextBlock Text="{Binding PendingFixText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PendingFixDetail}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Classes="actions">
                        <Button Content="{Binding Item.Daw, StringFormat='Open in {0}'}" Command="{Binding OpenFixedCommand}"
                                Classes.accent="{Binding !PendingFixOpened}" />
                        <Button Content="Keep" Classes="accent" Command="{Binding KeepFixedCommand}" IsVisible="{Binding PendingFixOpened}" />
                        <Button Content="Delete fixed copy" Command="{Binding DeleteFixedCommand}" IsVisible="{Binding PendingFixOpened}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <!-- The last check with the DAW: what it shows, against what the app read -->
            <Border Classes="panel" Margin="0,6,0,0" IsVisible="{Binding HasCheckLines}">
                <ItemsControl ItemsSource="{Binding CheckLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dl:CheckLine">
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Mark}" Width="18" FontSize="12" FontWeight="SemiBold" Classes="mark"
                                           Classes.same="{Binding Result, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dl:CheckResult.Same}}"
                                           Classes.different="{Binding Result, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static dl:CheckResult.Different}}" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Warnings about what could be read -->
            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="{DynamicResource RadiusM}" Background="#1FF2B33D" IsVisible="{Binding HasWarnings}">
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2" Foreground="{StaticResource WarningBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <TabControl x:Name="Tabs" Margin="12,14,12,0" Classes="detailTabs">
            <TabItem Header="Overview" IsSelected="{Binding PreviewShown, Mode=OneWayToSource}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,14,12,20">
                        <!-- Trouble first: what's missing, in one red card. -->
                        <Border Classes="trouble" IsVisible="{Binding Item.HasMissing}" Margin="0,0,0,18">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="{DynamicResource RadiusM}" Background="#33F0616D" Margin="0,0,14,0">
                                    <TextBlock Text="!" FontWeight="Bold" FontSize="16" Foreground="{StaticResource MissingBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button DockPanel.Dock="Right" Classes="accent" Padding="16,8" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Command="{Binding PlanFixCommand}" IsVisible="{Binding CanFix}"
                                        ToolTip.Tip="See what can be found on your drives, then save a fixed copy next to the original">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M14.7,6.3 a4,4 0 0 0 -5.4,5.4 L4,17 L7,20 L12.3,14.7 a4,4 0 0 0 5.4,-5.4 L15.5,11.5 L12.5,8.5 Z"
                                              Stroke="{StaticResource OnAccentBrush}" StrokeThickness="1.8" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                        <TextBlock Text="{Binding FixButtonText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Item.MissingText, StringFormat='{}{0} missing'}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="It will open with gaps. Fix finds what it can and saves a repaired copy." FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Fix's preview: one line per missing thing and the best guess, then save a fixed copy. -->
                        <Border Classes="panel fixPanel" IsVisible="{Binding IsFixOpen}" Margin="0,-6,0,18">
                            <StackPanel Spacing="4">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FixSummary}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="FIX: WHAT IT WILL DO" Classes="filterLabel" Margin="0" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding FixRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FixRow">
                                            <Border Classes="listRow">
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Ticked}" IsVisible="{Binding CanTick}" VerticalAlignment="Top"
                                                              Margin="0,0,6,0" MinWidth="0" ToolTip.Tip="Use this file in the fixed copy" />
                                                    <Border DockPanel.Dock="Left" Width="34" IsVisible="{Binding !CanTick}" />
                                                    <Border DockPanel.Dock="Right" Classes="pill fixBadge" VerticalAlignment="Top" Margin="10,0,0,0"
                                                            Classes.relink="{Binding IsRelink}" Classes.suggestion="{Binding IsSuggestion}" Classes.missing="{Binding IsMissing}">
                                                        <TextBlock Text="{Binding ActionText}" Classes="pillText" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock TextWrapping="Wrap">
                                                            <Run Text="{Binding KindText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                            <Run Text="  " />
                                                            <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                        <!-- Where the project expected it: a clue to where it went (and selectable, to copy). -->
                                                        <SelectableTextBlock Text="{Binding LookedFor}" IsVisible="{Binding HasLookedFor}" FontSize="11.5"
                                                                             Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,1,0,2" />
                                                        <TextBlock Text="{Binding Use, StringFormat='→ {0}'}" FontSize="12"
                                                                   Foreground="{StaticResource AccentBrush}" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding Use}">
                                                            <TextBlock.IsVisible>
                                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                    <Binding Path="HasUse" />
                                                                    <Binding Path="!HasChoices" />
                                                                </MultiBinding>
                                                            </TextBlock.IsVisible>
                                                        </TextBlock>
                                                        <!-- Several copies or close matches: the best is picked, the others are a click away. -->
                                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Chosen}" IsVisible="{Binding HasChoices}"
                                                                  HorizontalAlignment="Stretch" FontSize="12" Margin="0,2,0,2" ToolTip.Tip="{Binding ChoicesTip}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="sys:String">
                                                                    <TextBlock Text="{Binding}" FontSize="12" TextTrimming="PrefixCharacterEllipsis" ToolTip.Tip="{Binding}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding FixFootnote}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <Button Classes="accent" Content="Save fixed copy" Command="{Binding SaveFixedCommand}" Padding="16,8"
                                            ToolTip.Tip="Write the ticked samples into a copy next to the original" />
                                    <Button Content="Cancel" Command="{Binding CloseFixCommand}" Padding="16,8" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- The arrangement, big, the first thing you see. Read when Overview first shows; Full size opens it in its own window. -->
                        <v:ArrangementPanel Height="340" Margin="-12,-12,-12,6" IsVisible="{Binding CanPreview}" />

                        <!-- Below it: your own fields on the left, the song at a glance on the right (stacked when narrow). -->
                        <Grid x:Name="OverviewColumns" ColumnDefinitions="*,28,*" RowDefinitions="Auto,Auto,Auto">
                            <StackPanel x:Name="FieldsColumn">
                                <TextBlock Text="WHERE IT'S AT" Classes="filterLabel" />
                                <ListBox Classes="chips" ItemsSource="{x:Static vm:ProjectsViewModel.StatusChoices}" SelectedItem="{Binding Item.Status}"
                                         Margin="0,2,0,16" AutoScrollToSelectedItem="False">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>

                                <Grid ColumnDefinitions="*,16,*" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="RATING" Classes="filterLabel" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:ProjectsViewModel.RatingChoices}"
                                                  SelectedItem="{Binding Item.Rating}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="sys:Int32">
                                                    <TextBlock Text="{Binding Converter={StaticResource RatingText}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="FAVOURITE" Classes="filterLabel" />
                                        <ToggleSwitch IsChecked="{Binding Item.Favourite}" OnContent="Yes" OffContent="No" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,16,2*" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="KEY" Classes="filterLabel" />
                                        <TextBox Classes="clearButton" PlaceholderText="{Binding Item.KeyHint}"
                                                 ToolTip.Tip="Worked out from the notes (drums left out) until you type one in"
                                                 Text="{Binding Item.MusicalKey, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TAGS" Classes="filterLabel" />
                                        <TextBox Classes="clearButton" PlaceholderText="techno, live set, collab"
                                                 Text="{Binding Item.TagsText, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="NOTES" Classes="filterLabel" />
                                <TextBox MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"
                                         PlaceholderText="Ideas, to-dos, what this needs next…"
                                         Text="{Binding Item.Notes, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>

                            <StackPanel x:Name="GlanceColumn" Grid.Column="2" Spacing="18">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="seeAll" Content="All plugins" Tag="Plugins" Click="OnSeeAll" />
                                        <TextBlock Text="{Binding GlancePluginsLabel}" Classes="filterLabel" VerticalAlignment="Center" Margin="0" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding GlancePlugins}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PluginRow">
                                                <Border Classes="glanceChip" Classes.missing="{Binding !Installed}" Classes.silent="{Binding Silent}"
                                                        ToolTip.Tip="{Binding KindText}">
                                                    <TextBlock Text="{Binding Name}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding GlancePluginsMore}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               IsVisible="{Binding GlancePluginsMore, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="seeAll" Content="All samples" Tag="Samples" Click="OnSeeAll"
                                                IsVisible="{Binding Samples.Count, Converter={StaticResource NonZero}}" />
                                        <TextBlock Text="{Binding Samples.Count, StringFormat='SAMPLES · {0}'}" Classes="filterLabel" VerticalAlignment="Center" Margin="0" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource MissingBrush}"
                                                 IsVisible="{Binding Item.MissingSamples, Converter={StaticResource NonZero}}" />
                                        <TextBlock Text="{Binding GlanceSamples}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="seeAll" Content="All saves" Tag="Saves" Click="OnSeeAll"
                                                IsVisible="{Binding HasOlderSaves}" />
                                        <TextBlock Text="LATEST SAVES" Classes="filterLabel" VerticalAlignment="Center" Margin="0" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding GlanceSaves}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SaveGlance">
                                                <DockPanel Margin="0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding WhenText}" FontSize="12" Margin="10,0,0,0"
                                                               FontFamily="{DynamicResource NumberFont}" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                               Classes.newest="{Binding Newest}" ToolTip.Tip="{Binding Name}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Plugins">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,14,12,20">
                        <TextBlock Text="{Binding PluginHeader}" Classes="sectionHeader" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding VisiblePlugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginRow">
                                    <Border Classes="listRow">
                                        <StackPanel>
                                            <StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                        <Border Classes="pill" Background="{StaticResource MissingSoftBrush}" Margin="0,0,6,0"
                                                                IsVisible="{Binding !Installed}">
                                                            <TextBlock Text="Not installed" Classes="pillText" Foreground="{StaticResource MissingBrush}" />
                                                        </Border>
                                                        <Border Classes="pill" Background="{StaticResource OkSoftBrush}"
                                                                IsVisible="{Binding Elektron, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <TextBlock Text="{Binding Elektron, StringFormat='Elektron · {0}'}" Classes="pillText"
                                                                       Foreground="{StaticResource OkBrush}" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0">
                                                        <Run Text="{Binding KindText, Mode=OneWay}" />
                                                        <Run Text="{Binding Format, Mode=OneWay}" />
                                                        <Run Text="{Binding Vendor, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding OtherVersion, StringFormat='You have {0} installed'}" FontSize="12"
                                                               Foreground="{StaticResource OkBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               ToolTip.Tip="A different version of this plugin. The project won't load it by itself; swap it in."
                                                               IsVisible="{Binding OtherVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <WrapPanel Classes="rowActions" Margin="-4,4,0,0">
                                                    <StackPanel Orientation="Horizontal" IsVisible="{Binding !Installed}">
                                                        <Button Content="Find similar" Classes="row" Command="{Binding FindSimilarCommand}" />
                                                        <Button Content="Search online" Classes="row" Command="{Binding SearchOnlineCommand}" />
                                                    </StackPanel>
                                                    <Button Content="Preset" Classes="row"
                                                            ToolTip.Tip="Export this plugin's settings from the project as a preset"
                                                            IsVisible="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).CanExtractPresets}"
                                                            Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).ExportPluginPresetCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Projects" Classes="row" ToolTip.Tip="Show every project that uses this plugin"
                                                            Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).ShowProjectsUsingPluginCommand}"
                                                            CommandParameter="{Binding}" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MatchMessage}" FontSize="12" Margin="12,4,0,0" Foreground="{StaticResource MutedBrush}"
                                                       IsVisible="{Binding MatchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <ItemsControl ItemsSource="{Binding Matches}" ItemTemplate="{StaticResource MatchTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{Binding SilentToggleText}" Background="Transparent" Padding="8,4" Margin="-8,4,0,0"
                                HorizontalAlignment="Left" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                Command="{Binding ToggleSilentCommand}" ToolTip.Tip="Synths on channels that play no notes in the song"
                                IsVisible="{Binding SilentCount, Converter={StaticResource NonZero}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Samples">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,14,12,20">
                        <TextBlock Text="{Binding SampleHeader}" Classes="sectionHeader" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Samples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SampleRow">
                                    <Border Classes="listRow">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Classes="rowActions">
                                                    <StackPanel Orientation="Horizontal" IsVisible="{Binding !Found}">
                                                        <Button Content="Find matches" Classes="row" Command="{Binding FindMatchesCommand}" />
                                                        <Button Content="Search online" Classes="row" Command="{Binding SearchOnlineCommand}" />
                                                    </StackPanel>
                                                    <Button Content="Show" Classes="row" Command="{Binding RevealCommand}" IsVisible="{Binding Found}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                        <Border Classes="pill" Background="{StaticResource MissingSoftBrush}" IsVisible="{Binding !Found}">
                                                            <TextBlock Text="Can't be found" Classes="pillText" Foreground="{StaticResource MissingBrush}" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                               ToolTip.Tip="{Binding Path}" Foreground="{StaticResource FaintBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding MatchMessage}" FontSize="12" Margin="12,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       IsVisible="{Binding MatchMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <ItemsControl ItemsSource="{Binding Matches}" ItemTemplate="{StaticResource MatchTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Saves" IsVisible="{Binding HasOlderSaves}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,14,12,20">
                        <TextBlock Text="{Binding OlderSavesHeader}" Classes="sectionHeader" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding OlderSaves}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="lib:ProjectSummary">
                                    <Border Classes="listRow" Padding="10,4">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Classes="rowActions">
                                                <Button Content="Open" Classes="row"
                                                        Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).OpenSaveCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Show" Classes="row"
                                                        Command="{Binding $parent[UserControl].((vm:ProjectDetailViewModel)DataContext).RevealSaveCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Modified, StringFormat='d MMM yyyy'}" Margin="8,0"
                                                       VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding Path}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,14,12,20">
                        <TextBlock Text="Tracks and channels" Classes="sectionHeader" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <Border Margin="0,0,6,6" Padding="10,3" CornerRadius="{DynamicResource RadiusM}" Background="{StaticResource SurfaceRaisedBrush}">
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="File" Classes="sectionHeader" Margin="0,16,0,8" />
                        <Border Classes="panel">
                            <ItemsControl ItemsSource="{Binding Facts}">
                                <ItemsControl.ItemTemplate>
                                    <!-- A generic pair, which compiled bindings can't name, so this one binds by reflection. -->
                                    <DataTemplate x:CompileBindings="False">
                                        <Grid Margin="0,3" ColumnDefinitions="130,*">
                                            <TextBlock Text="{Binding Key}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
