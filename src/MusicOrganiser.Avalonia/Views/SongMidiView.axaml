<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganiser.ViewModels"
             xmlns:views="using:MusicOrganiser.Avalonia.Views"
             x:Class="MusicOrganiser.Avalonia.Views.SongMidiView"
             x:DataType="vm:SongMidiViewModel">
    <!-- A song's "MIDI that fits": parts from your other projects and MIDI folders that fit its harmony, already moved into its key. -->
    <UserControl.Styles>
        <!-- A part open in the quick view: the list narrows, so its little rolls make way. -->
        <Style Selector="ListBox.open views|NoteRoll">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel.fitColumn">
            <Setter Property="Width" Value="110" />
        </Style>
        <Style Selector="ListBox.open StackPanel.fitColumn">
            <Setter Property="Width" Value="52" />
        </Style>
        <Style Selector="ListBox.open TextBlock.move">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Open in Playground" Command="{Binding OpenInPlaygroundCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="Work the idea up on the Playground: the picked part on top of the bars of this song it fits, in a new section" />
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Status}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                <ListBox Classes="chips group" ItemsSource="{x:Static vm:SongMidiViewModel.Kinds}" SelectedItem="{Binding Kind}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RoleChip">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- The song's parts: fit to, and play with, just the ones picked. -->
                <DockPanel IsVisible="{Binding HasSongParts}">
                    <TextBlock DockPanel.Dock="Left" Text="Fit to:" Classes="small" VerticalAlignment="Top" Margin="0,5,8,6" />
                    <Button DockPanel.Dock="Right" Content="All parts" Padding="8,2" FontSize="12" Margin="6,0,0,6" VerticalAlignment="Top"
                            Command="{Binding AllSongPartsCommand}" ToolTip.Tip="Fit to every part of the song again" />
                    <ItemsControl ItemsSource="{Binding SongParts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SongPart">
                                <ToggleButton Classes="chip" FontSize="12" Padding="10,3" Margin="0,0,6,6" Content="{Binding Name}" IsChecked="{Binding IsOn}"
                                              ToolTip.Tip="{Binding Tip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </StackPanel>
        </DockPanel>

        <!-- The list, and a part opened from it beside it, two thirds wide. -->
        <Grid x:Name="Body" ColumnDefinitions="*,0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding IsLoading}">
                <Arc Classes="spinner" Width="22" Height="22" HorizontalAlignment="Center" />
                <TextBlock Text="Finding MIDI that fits…" Classes="small" HorizontalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Nothing to show yet." Classes="small" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsEmpty}" />
            <ListBox x:Name="Parts" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" views:FileDrag.Source="{Binding}"
                     Tapped="OnTapped" DoubleTapped="OnDoubleTapped" KeyDown="OnKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MidiRow">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                            <Button Command="{Binding PlayCommand}" Padding="9,5" Margin="0,0,10,0" VerticalAlignment="Center"
                                    ToolTip.Tip="Listen, already moved into this song's key (with a stand-in sound)">
                                <Panel>
                                    <TextBlock Text="▶" IsVisible="{Binding !IsPlaying}" />
                                    <TextBlock Text="■" IsVisible="{Binding IsPlaying}" />
                                </Panel>
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                <TextBlock Text="{Binding From}" Classes="small" ToolTip.Tip="{Binding Entry.Phrase.Source.Path}" />
                                <TextBlock Text="{Binding Details}" Classes="small" ToolTip.Tip="{Binding ChordsText}" />
                            </StackPanel>
                            <views:NoteRoll Grid.Column="2" Height="40" Width="160" Channel="{Binding Channel}" Position="{Binding Position}"
                                            SeekCommand="{Binding SeekCommand}" />
                            <StackPanel Grid.Column="3" Classes="fitColumn" Margin="10,0,4,0" VerticalAlignment="Center" ToolTip.Tip="{Binding FitWhy}">
                                <TextBlock Classes="fitScore" Text="{Binding FitText}" />
                                <TextBlock Classes="small move" HorizontalAlignment="Right" Text="{Binding MoveText}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- The quick view: a slim mini playground to try a part with the song before dragging it out. The Playground
                 (the button at the top) is for working an idea up further. -->
            <Border Grid.Column="1" Classes="card" Margin="14,0,0,0" VerticalAlignment="Top" IsVisible="{Binding IsOpen}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" DataContext="{Binding Open}" x:DataType="vm:MidiRow">
                    <DockPanel>
                        <Button Classes="flat" DockPanel.Dock="Right" Content="✕" Padding="8,2" VerticalAlignment="Top"
                                Command="{Binding $parent[UserControl].((vm:SongMidiViewModel)DataContext).CloseCommand}" ToolTip.Tip="Close (Esc)" />
                        <StackPanel DockPanel.Dock="Right" Margin="10,0" VerticalAlignment="Top" ToolTip.Tip="{Binding FitWhy}">
                            <TextBlock Classes="fitScore" Text="{Binding FitText}" />
                            <TextBlock Classes="small" HorizontalAlignment="Right" Text="{Binding MoveText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding From}" Classes="small" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </DockPanel>
                    <!-- A cut-down Playground: this part layered with the song's own parts, to work on here. Fit to's chips
                         mute and unmute the song's lanes. -->
                    <views:PlaygroundMiniView DataContext="{Binding $parent[UserControl].((vm:SongMidiViewModel)DataContext).Quick}"
                                              IsVisible="{Binding $parent[UserControl].((vm:SongMidiViewModel)DataContext).HasQuick}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Start again" Padding="8,2" FontSize="12"
                                Command="{Binding $parent[UserControl].((vm:SongMidiViewModel)DataContext).StartAgainCommand}"
                                ToolTip.Tip="This part as it first came, with every one of the song's parts" />
                        <Separator />
                    </DockPanel>
                    <!-- The part on its own: its piano roll, quick changes, listening and dragging out. -->
                    <Expander HorizontalAlignment="Stretch" Header="This part on its own: piano roll, quick changes and dragging out">
                    <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding CanPlayTogether}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource MutedBrush}" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PairText}" Classes="small" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="This part" Classes="small" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <views:PianoRollEditor Height="240" Notes="{Binding BarNotes}" Guide="{Binding EditorGuide}" Period="{Binding LoopLength}"
                                           Length="{Binding PairLength}" Position="{Binding PairPosition}"
                                           PartStart="{Binding PartStart}" PartEnd="{Binding PartEnd}"
                                           EditedCommand="{Binding EditCommand}" SeekCommand="{Binding PairSeekCommand}"
                                           ToolTip.Tip="Click to add a note, drag a note to move it, drag its end to stretch it, right-click to take it away. Hold Shift to place without snapping. Click the bar numbers to play from there." />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <Button Content="Undo" Padding="8,2" FontSize="12" Command="{Binding UndoEditCommand}" IsEnabled="{Binding CanUndoEdit}"
                                    ToolTip.Tip="Take back the last edit" />
                            <Button Content="Back to as it was" Padding="8,2" FontSize="12" Command="{Binding ResetEditsCommand}" IsVisible="{Binding IsEdited}"
                                    ToolTip.Tip="Undo every edit to this part. The file it came from is never changed." />
                        </StackPanel>
                        <TextBlock Text="{Binding TogetherText}" Classes="small" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- One-click changes, each undone like any edit. The file it came from is never changed. -->
                    <WrapPanel>
                        <TextBlock Text="Change it:" Classes="small" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <StackPanel Classes="group" Margin="0,0,0,6">
                            <Button Content="▼ Semitone" Command="{Binding ToolCommand}" CommandParameter="down"
                                    ToolTip.Tip="Every note down a semitone" />
                            <Button Content="▲ Semitone" Command="{Binding ToolCommand}" CommandParameter="up"
                                    ToolTip.Tip="Every note up a semitone" />
                            <Button Content="Quantise" Command="{Binding ToolCommand}" CommandParameter="quantise"
                                    ToolTip.Tip="Every note onto the grid, for a tight feel: 16ths, or what Settings › MIDI says" />
                            <Button Content="Play it twice" Command="{Binding ToolCommand}" CommandParameter="twice"
                                    ToolTip.Tip="The part again straight after itself: twice as long, to change the second time round" />
                            <Button Content="First half" Command="{Binding ToolCommand}" CommandParameter="half"
                                    ToolTip.Tip="Just its first half: for a part that plays the same idea twice" />
                            <Button Content="Reverse" Command="{Binding ToolCommand}" CommandParameter="reverse"
                                    ToolTip.Tip="Back to front: the last note first" />
                        </StackPanel>
                    </WrapPanel>
                    <!-- Listening, its sound and octave, and taking it out to the DAW. -->
                    <WrapPanel>
                        <Button Command="{Binding PlayTogetherCommand}" Margin="0,0,6,6" Padding="12,6" Classes="accent" IsVisible="{Binding CanPlayTogether}"
                                ToolTip.Tip="This part on top of the song's own MIDI, so you can hear if they go together">
                            <Panel>
                                <TextBlock Text="▶  Play with the song" IsVisible="{Binding !IsPlayingTogether}" />
                                <TextBlock Text="■  Stop" IsVisible="{Binding IsPlayingTogether}" />
                            </Panel>
                        </Button>
                        <Button Command="{Binding PlayAloneCommand}" Margin="0,0,6,6" Padding="12,6" ToolTip.Tip="This part on its own">
                            <Panel>
                                <TextBlock Text="▶  On its own" IsVisible="{Binding !IsPlayingAlone}" />
                                <TextBlock Text="■  Stop" IsVisible="{Binding IsPlayingAlone}" />
                            </Panel>
                        </Button>
                        <ToggleButton Classes="chip" Margin="0,0,6,6" VerticalAlignment="Center"
                                      IsChecked="{Binding $parent[UserControl].((vm:SongMidiViewModel)DataContext).Midi.Loop}"
                                      ToolTip.Tip="Play round and round until you stop it">
                            <TextBlock Text="↻  Loop" />
                        </ToggleButton>
                        <Border Classes="dragChip" Margin="0,0,6,6" views:FileDrag.Source="{Binding $parent[UserControl].DataContext}"
                                ToolTip.Tip="Drag into your DAW as a MIDI clip: in this song's key and octave, with your edits">
                            <TextBlock Text="Drag into your DAW" />
                        </Border>
                    </WrapPanel>
                    <WrapPanel ToolTip.Tip="{Binding OctaveWhy}">
                        <ComboBox ItemsSource="{x:Static vm:MidiBrowserViewModel.SoundChoices}" SelectedItem="{Binding Sound}" Margin="0,0,6,6"
                                  FontSize="12" MinWidth="150" ToolTip.Tip="The sound this kind of part plays with" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" IsVisible="{Binding CanChangeOctave}">
                            <Button Content="−" Padding="10,3" Command="{Binding OctaveDownCommand}" ToolTip.Tip="An octave down (remembered)" />
                            <TextBlock Text="{Binding OctaveText}" Classes="small" VerticalAlignment="Center" MinWidth="96" TextAlignment="Center" />
                            <Button Content="+" Padding="10,3" Command="{Binding OctaveUpCommand}" ToolTip.Tip="An octave up (remembered)" />
                            <Button Content="Reset" Padding="8,3" FontSize="12" Command="{Binding ResetOctaveCommand}" IsVisible="{Binding IsYourOctave}"
                                    ToolTip.Tip="Let the app pick the octave again" />
                        </StackPanel>
                    </WrapPanel>
                    </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
