<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganiser.ViewModels"
             x:Class="MusicOrganiser.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.cardIntro">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Border.settingsCard">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="20,18" />
        </Style>
        <Style Selector="ListBox.folders">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MaxHeight" Value="190" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="WrapPanel.buttons > Button">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="TextBlock.live">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.live.ok">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left" Margin="0,0,16,16">
            <TextBlock Text="Settings" Classes="pageTitle" />
            <TextBlock Text="Where your projects, samples and plugins live, and how projects open."
                       Classes="pageSubtitle" Margin="0,2,0,20" />

            <Border Classes="card settingsCard">
                <StackPanel>
                    <TextBlock Text="Project folders" Classes="sectionHeader" />
                    <TextBlock Classes="cardIntro"
                               Text="Folders to search for Bitwig (.bwproject), FL Studio (.flp) and Studio One (.song) projects. Subfolders are included. DAW autosave and backup folders are skipped, and so are the demo songs, tutorials and templates that came with the DAW (folders named Cool stuff, Demo songs, Product demos, Templates or Tutorial)." />
                    <ListBox ItemsSource="{Binding ProjectFolders}" SelectedItem="{Binding SelectedProjectFolder}" Classes="folders" />
                    <WrapPanel Classes="buttons" Margin="0,10,0,0">
                        <Button Content="Add folder" Classes="accent" Command="{Binding AddProjectFolderCommand}" />
                        <Button Content="Remove" Command="{Binding RemoveProjectFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card settingsCard">
                <StackPanel>
                    <TextBlock Text="Sample folders" Classes="sectionHeader" />
                    <TextBlock Classes="cardIntro"
                               Text="Your sample libraries (Splice, packs, recordings). These are indexed so missing samples can be matched by name, and they're what the Sound Lab browses." />
                    <ListBox ItemsSource="{Binding SampleFolders}" SelectedItem="{Binding SelectedSampleFolder}" Classes="folders" />
                    <WrapPanel Classes="buttons" Margin="0,10,0,0">
                        <Button Content="Add folder" Command="{Binding AddSampleFolderCommand}" />
                        <Button Content="Remove" Command="{Binding RemoveSampleFolderCommand}" />
                        <Button Content="Re-index samples" Command="{Binding IndexSamplesCommand}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding SampleIndexText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card settingsCard">
                <StackPanel>
                    <TextBlock Text="Plugin folders" Classes="sectionHeader" />
                    <TextBlock Classes="cardIntro"
                               Text="Where your VST3, CLAP, VST2 and (on a Mac) Audio Unit plugins are installed. Used to tell which plugins in a project are missing on this computer, and to recognise plugin names inside Bitwig projects." />
                    <ListBox ItemsSource="{Binding PluginFolders}" SelectedItem="{Binding SelectedPluginFolder}" Classes="folders" />
                    <WrapPanel Classes="buttons" Margin="0,10,0,0">
                        <Button Content="Add folder" Command="{Binding AddPluginFolderCommand}" />
                        <Button Content="Remove" Command="{Binding RemovePluginFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card settingsCard">
                <StackPanel>
                    <TextBlock Text="Opening projects" Classes="sectionHeader" />
                    <TextBlock Classes="cardIntro"
                               Text="By default projects open in whatever program your computer uses for that file type. Pick a program here to override it, e.g. if you have more than one version installed." />
                    <ItemsControl ItemsSource="{Binding Daws}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DawSetting">
                                <Grid Margin="0,0,0,10" ColumnDefinitions="180,*,Auto,Auto">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Fill="{Binding Daw, Converter={StaticResource DawBrush}}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Daw}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Extensions}" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ExePath, Mode=OneWay}" IsReadOnly="True" PlaceholderText="Default program" />
                                    <Button Grid.Column="2" Content="Choose…" Command="{Binding ChooseCommand}" Margin="6,0,0,0" />
                                    <Button Grid.Column="3" Content="Reset" Background="Transparent" Command="{Binding ClearCommand}" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card settingsCard">
                <StackPanel>
                    <TextBlock Text="Exports" Classes="sectionHeader" />
                    <TextBlock Classes="cardIntro" Text="Where MIDI, presets and kits are saved. Each project gets its own folder inside." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding ChooseExportFolderCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding ExportFolder, Mode=OneWay}" IsReadOnly="True" PlaceholderText="Documents/Music Organiser Exports" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Classes="card settingsCard">
                <StackPanel>
                    <TextBlock Text="FL Studio to Bitwig" Classes="sectionHeader" />
                    <TextBlock Classes="cardIntro"
                               Text="Open in Bitwig builds each converted song from a template: a project saved in Bitwig with a Sampler track, a VST3 synth with a Note Transpose before it and a clip of notes, a VST2 synth, and an audio track with an audio clip on it (not in a group) for FL Studio's audio clips. Its tracks are copied and filled in, and its own tracks are left out. The app keeps its own copy of the template, so it always knows where it is. To change it, use Edit in Bitwig and save." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Replace…" Command="{Binding ChooseBitwigTemplateCommand}" Margin="6,0,0,0"
                                ToolTip.Tip="Copy another Bitwig project in as the template" />
                        <Button DockPanel.Dock="Right" Content="Show file" Command="{Binding ShowBitwigTemplateCommand}" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Edit in Bitwig" Command="{Binding EditBitwigTemplateCommand}" Margin="6,0,0,0"
                                ToolTip.Tip="Open the app's copy of the template in Bitwig, to change it and save" />
                        <TextBox Text="{Binding BitwigTemplate, Mode=OneWay}" IsReadOnly="True" PlaceholderText="Asked for the first time you convert" />
                    </DockPanel>
                    <TextBlock Text="{Binding BitwigTemplateNote}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                               IsVisible="{Binding BitwigTemplateNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <CheckBox Content="Steps play until the next note or the end of the clip" IsChecked="{Binding StepsUntilNextNote}" Margin="0,12,0,0" />
                    <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Notes from FL's step sequencer have no length. Plugin tracks always play them until the next note on the same key or the end of the clip. On a Sampler they also stop where the sample ends, unless this is ticked." />
                </StackPanel>
            </Border>

            <Border Classes="card settingsCard">
                <StackPanel>
                    <TextBlock Text="DAW links" Classes="sectionHeader" />
                    <TextBlock Classes="cardIntro"
                               Text="Small scripts the app installs in Bitwig and FL Studio, so it can ask them what they show for the open project. The Check with Bitwig and Check with FL Studio buttons on a project then compare that with what the app read from its file." />
                    <Button Content="Set up both" Classes="accent" Command="{Binding SetUpBothCommand}" Margin="0,0,0,8"
                            ToolTip.Tip="Installs the script for each DAW on this computer, makes FL Studio's MIDI port the way chosen below, then checks each link" />
                    <TextBlock Text="{Binding SetUpResult}" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,14"
                               IsVisible="{Binding SetUpResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DawLinkSetting">
                                <StackPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Fill="{Binding Daw, Converter={StaticResource DawBrush}}" />
                                        <TextBlock Text="{Binding Daw}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" Margin="18,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Live}" Classes="live" Classes.ok="{Binding IsAnswering}" Margin="18,2,0,0"
                                               TextWrapping="Wrap" FontSize="12.5"
                                               IsVisible="{Binding Live, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding Steps}" Margin="18,4,0,0" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Margin="18,10,0,0" IsVisible="{Binding CanChoosePort}">
                                        <TextBlock Text="The MIDI port for the script" FontSize="12.5" Margin="0,0,0,6" />
                                        <RadioButton Margin="0,0,0,4"
                                                     IsChecked="{Binding MidiPort.Choice, Converter={StaticResource IndexToBool}, ConverterParameter=0}">
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                                       Text="loopMIDI: a free app you install, then make the port in. Works on any Windows." />
                                        </RadioButton>
                                        <RadioButton IsChecked="{Binding MidiPort.Choice, Converter={StaticResource IndexToBool}, ConverterParameter=1}">
                                            <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                                       Text="Windows' own MIDI system: Install makes the port, with nothing else to install. Needs Windows 11 25H2 or later, fully updated." />
                                        </RadioButton>
                                        <TextBlock Text="{Binding MidiPort.Note}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                                                   IsVisible="{Binding MidiPort.Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <WrapPanel Classes="buttons" Margin="18,10,0,0">
                                        <Button Content="Install" Command="{Binding InstallCommand}" />
                                        <Button Content="Get loopMIDI" Command="{Binding MidiPort.GetLoopMidiCommand}" IsVisible="{Binding ShowGetLoopMidi}"
                                                ToolTip.Tip="Opens loopMIDI's page in your browser, to download it" />
                                        <Button Content="Choose folder…" Command="{Binding ChooseFolderCommand}" IsVisible="{Binding CanChooseFolder}"
                                                ToolTip.Tip="{Binding ChooseFolderTip}" />
                                        <Button Content="Check connection" Command="{Binding CheckCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Result}" Margin="18,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                                               IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel Margin="18,14,0,0" IsVisible="{Binding HasLiveTests}">
                                        <TextBlock Text="Live tests" FontSize="12.5" Margin="0,0,0,4" />
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                                   Text="Tries out what the app does with Bitwig, in the Bitwig open now, and writes a report. It only reads, unless Bitwig lets the app make changes and the open project's name starts with “MO Live Test”: then it adds a few tracks to that project and saves it, so your own projects are never touched." />
                                        <WrapPanel Classes="buttons" Margin="0,10,0,0">
                                            <Button Content="Run live tests" Command="{Binding LiveTests.RunCommand}"
                                                    ToolTip.Tip="Runs the live tests while Bitwig is answering. They take about a minute, a few more with MO Probe installed." />
                                            <Button Content="Stop" Command="{Binding LiveTests.StopCommand}" IsVisible="{Binding LiveTests.Running}"
                                                    ToolTip.Tip="Stops after the test running now, which puts back anything it was in the middle of. The report is still written." />
                                            <Button Content="Open report" Command="{Binding LiveTests.OpenReportCommand}"
                                                    ToolTip.Tip="Opens the newest run's report. The reports are kept in reports/live in the app's data folder." />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding LiveTests.ProgressLine}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   IsVisible="{Binding LiveTests.ProgressLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding LiveTests.Summary}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                                                   IsVisible="{Binding LiveTests.Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="card settingsCard" DataContext="{Binding Probe}">
                <StackPanel x:DataType="vm:ProbeReportsViewModel">
                    <TextBlock Text="MO Probe" Classes="sectionHeader" />
                    <TextBlock Classes="cardIntro"
                               Text="A test plugin for learning how each DAW saves things. Put it on a track and use it: it reports what the DAW tells it, and Format Lab finds its knobs and saved settings in the project file." />
                    <TextBlock Text="Running now" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding RunningNote}" Classes="muted" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,8"
                               IsVisible="{Binding RunningNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl ItemsSource="{Binding Running}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RunningProbeRow">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" ToolTip.Tip="{Binding Tip}" />
                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding Knobs}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                    <WrapPanel Classes="buttons" Margin="0,8,0,0">
                                        <Button Content="Beep" Padding="9,3" FontSize="12" Command="{Binding BeepCommand}"
                                                ToolTip.Tip="Plays a short tone on its track, so you can hear which one it's on" />
                                        <Button Content="Ping" Padding="9,3" FontSize="12" Command="{Binding PingCommand}"
                                                ToolTip.Tip="Checks that it answers the app, and how quickly" />
                                        <Button Content="Check knobs through Bitwig" Padding="9,3" FontSize="12" Command="{Binding CheckKnobsCommand}"
                                                IsVisible="{Binding CanCheckKnobs}"
                                                ToolTip.Tip="Turns each knob through Bitwig and reads what the probe got, then the other way round, and puts them back as they were. It takes about half a minute." />
                                        <Button Content="Stop the check" Padding="9,3" FontSize="12" Command="{Binding StopCheckCommand}"
                                                IsVisible="{Binding Checking}" ToolTip.Tip="Stops the check, and puts the knobs back as they were" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Reply}" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0"
                                               IsVisible="{Binding Reply, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding CheckResult}" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0"
                                               IsVisible="{Binding CheckResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,8" />
                    <ItemsControl ItemsSource="{Binding Reports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProbeReportRow">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Show" Padding="9,3" FontSize="12" VerticalAlignment="Center"
                                            Command="{Binding RevealCommand}" ToolTip.Tip="Shows the report file" />
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock>
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Classes="buttons" Margin="0,6,0,0">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                        <Button Content="Open reports folder" Command="{Binding OpenFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Sound output: where the app's sounds play. Hidden where the app can't choose (the WPF app). -->
            <Border Classes="card settingsCard" DataContext="{Binding SoundOutput}" IsVisible="{Binding IsAvailable}">
                <StackPanel x:DataType="vm:SoundOutputSetting" Spacing="8">
                    <TextBlock Text="Sound output" Classes="sectionHeader" />
                    <TextBlock Classes="cardIntro" Margin="0"
                               Text="Where the app plays sounds. Choose your audio interface to hear them through it, or keep the computer's default output and the app follows it when it changes." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" MinWidth="340" MaxWidth="560"
                                  ToolTip.Tip="Sounds move here at once, even one that's playing" />
                        <Button Content="Look again" Command="{Binding RefreshCommand}"
                                ToolTip.Tip="Lists the outputs again, after plugging something in or switching it on" />
                    </StackPanel>
                    <TextBlock Text="{Binding Note}" Classes="live" TextWrapping="Wrap" FontSize="12.5"
                               IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Classes="card settingsCard">
                <StackPanel>
                    <TextBlock Text="Your library" Classes="sectionHeader" />
                    <TextBlock Classes="muted" FontSize="12.5">
                        <Run Text="Your tags, ratings and notes are stored on this computer in" />
                        <Run Text="{Binding LibraryLocation, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                        <Run Text=". Nothing is uploaded; online search only opens your browser when you ask it to." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
