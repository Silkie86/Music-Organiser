<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicOrganiser.ViewModels"
        xmlns:views="using:MusicOrganiser.Avalonia.Views"
        x:Class="MusicOrganiser.Avalonia.Views.MidiWindow"
        x:DataType="vm:MidiPreviewViewModel"
        Title="{Binding Title, StringFormat='MIDI in {0}'}" Width="760" Height="620" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
            <Button DockPanel.Dock="Right" Content="Export all channels" Classes="accent"
                    Command="{Binding ExportAllCommand}" IsEnabled="{Binding HasChannels}" />
            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="60" Margin="0,0,8,0" IsVisible="{Binding IsPreparing}" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Foreground="{StaticResource MutedBrush}" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Margin="16,12,16,8" Foreground="{StaticResource MutedBrush}" />

        <!-- Listen to the whole song. Dragging channels out into a DAW isn't on this version yet. -->
        <WrapPanel DockPanel.Dock="Top" Margin="16,0,16,10" IsVisible="{Binding HasChannels}">
            <Button Command="{Binding PlayAllCommand}" Margin="0,0,12,0" Padding="10,5"
                    ToolTip.Tip="Hear every channel together. Click along any channel to jump.">
                <Panel>
                    <TextBlock Text="▶  Play all" IsVisible="{Binding !IsPlayingAll}" />
                    <TextBlock Text="■  Stop" IsVisible="{Binding IsPlayingAll}" />
                </Panel>
            </Button>
        </WrapPanel>

        <ListBox ItemsSource="{Binding Channels}" SelectionMode="Multiple" Margin="12,0,8,0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MidiChannelRow">
                    <Grid ColumnDefinitions="Auto,190,*,Auto">
                        <Button Command="{Binding PlayCommand}" Padding="9,5" Margin="2,0,10,0" VerticalAlignment="Center"
                                ToolTip.Tip="Listen to this channel">
                            <Panel>
                                <TextBlock Text="▶" IsVisible="{Binding !IsPlaying}" />
                                <TextBlock Text="■" IsVisible="{Binding IsPlaying}" />
                            </Panel>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                            <TextBlock Text="{Binding Source}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Source}"
                                       Foreground="{StaticResource MutedBrush}"
                                       IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <views:NoteRoll Grid.Column="2" Height="48" Channel="{Binding Channel}" SongEnd="{Binding SongEnd}"
                                        Position="{Binding Position}" SeekCommand="{Binding SeekCommand}" />
                        <Button Grid.Column="3" Content="Export" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding ExportCommand}" ToolTip.Tip="Save just this channel as a MIDI file" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
