<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicOrganiser.ViewModels"
             xmlns:lib="using:MusicOrganiser.Core.Library"
             xmlns:plugins="using:MusicOrganiser.Core.Plugins"
             xmlns:space="using:MusicOrganiser.Core.Space"
             xmlns:views="using:MusicOrganiser.Avalonia.Views"
             x:Class="MusicOrganiser.Avalonia.Views.PluginsView"
             x:DataType="vm:PluginsViewModel">
    <UserControl.Styles>
        <!-- A quiet selection, so the faint ID and path stay readable. -->
        <Style Selector="ListBox.copies ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        </Style>
        <Style Selector="ListBox.copies ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        </Style>
        <Style Selector="ListBox.copies ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentFaintBrush}" />
        </Style>
        <!-- An "install this" tile: a big number, the plugin, and ways to find it. -->
        <Style Selector="Border.tile.needed">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.projects ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Styles>
    <Panel>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBox DockPanel.Dock="Right" Classes="clearButton pageSearch" Width="360" VerticalAlignment="Center"
                     PlaceholderText="Search plugins or vendors…" Text="{Binding SearchText}" />
            <StackPanel>
                <TextBlock Text="Plugins" Classes="pageTitle" />
                <TextBlock Text="{Binding Summary}" Classes="pageSubtitle" />
            </StackPanel>
        </DockPanel>

        <!-- The list, and the picked plugin's panel: the divider between them drags (Solomon's F12 note, 25 Oct). -->
        <Grid x:Name="Body" ColumnDefinitions="*,12,380">
        <!-- The picked plugin: the projects using it, and its installed copies as the plugin scanner read them. -->
        <Border Grid.Column="2" Classes="card">
            <Panel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                            IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="Pick a plugin" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" TextAlignment="Center" MaxWidth="260" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="The songs using it show here, newest first. Click one to open it on the Projects page." />
                </StackPanel>
                <DockPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Classes="pill" Background="{StaticResource OkSoftBrush}" VerticalAlignment="Top"
                                    IsVisible="{Binding Selected.Installed, FallbackValue=False}">
                                <TextBlock Text="Installed" Classes="pillText" Foreground="{StaticResource OkBrush}" />
                            </Border>
                            <Border DockPanel.Dock="Right" Classes="pill" Background="{StaticResource MissingSoftBrush}" VerticalAlignment="Top"
                                    IsVisible="{Binding !Selected.Installed, FallbackValue=False}">
                                <TextBlock Text="Missing" Classes="pillText" Foreground="{StaticResource MissingBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Selected.Name, FallbackValue=''}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedDetails}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                            <Button Content="Show in Projects" Command="{Binding ShowProjectsCommand}"
                                    ToolTip.Tip="The Projects page, showing only the projects that use this plugin" />
                            <Button Content="Search online" Command="{Binding SearchOnlineCommand}"
                                    IsVisible="{Binding !Selected.Installed, FallbackValue=False}" />
                        </StackPanel>
                    </StackPanel>
                    <TabControl SelectedIndex="{Binding SideTab}">
                        <TabItem Header="{Binding ProjectsTitle}">
                            <DockPanel>
                                <!-- Which DAW's songs, and songs or every save: Solomon's 18 Oct notes. -->
                                <ListBox DockPanel.Dock="Top" x:Name="ProjectDawChips" Classes="chips group" ItemsSource="{Binding ProjectDaws}"
                                         SelectedItem="{Binding ProjectsDaw}" IsVisible="{Binding HasProjectDaws}" Margin="0,8,0,0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Converter={StaticResource DawBrush}}"
                                                         IsVisible="{Binding Converter={StaticResource NotAny}}" />
                                                <TextBlock Text="{Binding Converter={StaticResource DawChipText}}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                                    <CheckBox DockPanel.Dock="Right" Content="Every save" IsChecked="{Binding EverySave}" FontSize="12"
                                              VerticalAlignment="Top" Margin="10,-4,0,0"
                                              ToolTip.Tip="List every save that uses it, not just each song's newest" />
                                    <TextBlock Text="{Binding ProjectsNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                </DockPanel>
                                <ListBox Classes="projects" x:Name="PluginSongs" ItemsSource="{Binding Projects}" SelectedItem="{Binding PickedProject}"
                                         Background="Transparent" Margin="-4,4,-4,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="lib:SongUse">
                                            <DockPanel ToolTip.Tip="{Binding Latest.Name}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Latest.Saved, StringFormat={}{0:d MMM yyyy}}" FontSize="11.5"
                                                           FontFamily="{DynamicResource NumberFont}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SavesText}" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center"
                                                         Fill="{Binding Latest.Daw, Converter={StaticResource DawBrush}}" ToolTip.Tip="{Binding Latest.Daw}" />
                                                <TextBlock Text="{Binding Song}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                        <!-- Where its room on disk goes, with Clean up and Uninstall (Solomon, 25 Oct 2026). -->
                        <TabItem Header="Space">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding SpaceSummary}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                                    <StackPanel Spacing="8" IsVisible="{Binding HasSpace}">
                                        <views:ShareBar Parts="{Binding SpaceParts}" />
                                        <ItemsControl ItemsSource="{Binding SpaceParts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SpacePart">
                                                    <DockPanel Margin="0,1">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontFamily="{DynamicResource NumberFont}" FontSize="12"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                        <Border DockPanel.Dock="Left" Width="9" Height="9" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                Background="{Binding Colour, Converter={StaticResource HexBrush}}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding SharedText}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"
                                                   IsVisible="{Binding SharedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <WrapPanel Margin="0,2,0,0">
                                            <Button Content="Clean up…" Margin="0,0,6,6" Command="{Binding CleanUpCommand}" CommandParameter="{x:Null}"
                                                    ToolTip.Tip="Remove its presets or sounds to the Recycle Bin. You see what goes first." />
                                            <Button Content="Uninstall…" Classes="trouble" Margin="0,0,6,6" Command="{Binding UninstallCommand}" CommandParameter="{x:Null}"
                                                    ToolTip.Tip="Run its own uninstaller, as Windows Settings › Apps does. You're asked first." />
                                            <Button Content="Add a folder…" Margin="0,0,6,6" Command="{Binding AddSpaceFolderCommand}"
                                                    ToolTip.Tip="A folder of its sounds or presets the app didn't find, like a sound library on another drive" />
                                        </WrapPanel>
                                        <!-- Folders moved to another drive: their old copy, and Move back. -->
                                        <StackPanel Spacing="4" IsVisible="{Binding HasMoved}">
                                            <TextBlock Text="ON ANOTHER DRIVE" Classes="filterLabel" Margin="0,4,0,0" />
                                            <ItemsControl ItemsSource="{Binding MovedFolders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MovedFolderItem">
                                                        <Border Classes="row" Padding="8,5" Margin="-8,0">
                                                            <StackPanel Spacing="3">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontFamily="{DynamicResource NumberFont}" FontSize="12"
                                                                               Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Where}" />
                                                                <TextBlock Text="{Binding OldCopyText}" FontSize="11" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                                                                           IsVisible="{Binding HasOldCopy}" />
                                                                <WrapPanel>
                                                                    <Button Content="Delete old copy…" Margin="0,0,6,0" Command="{Binding DeleteOldCopyCommand}" IsVisible="{Binding HasOldCopy}"
                                                                            ToolTip.Tip="Once the plugin opens fine: the copy left here goes to the Recycle Bin" />
                                                                    <Button Content="Move back…" Margin="0,0,6,0" Command="{Binding MoveBackCommand}"
                                                                            ToolTip.Tip="Bring the folder back to where it was" />
                                                                    <Button Content="Show" Command="{Binding ShowCommand}" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <TextBlock Text="FILES AND FOLDERS" Classes="filterLabel" Margin="0,4,0,0" />
                                        <ItemsControl ItemsSource="{Binding SpaceFolders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SpaceFolderItem">
                                                    <Border Classes="row" Padding="8,5" Margin="-8,0">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Classes="rowActions">
                                                                <Button Content="Show" Command="{Binding ShowCommand}" />
                                                                <Button Content="Move…" Command="{Binding MoveCommand}" IsVisible="{Binding CanMove}"
                                                                        ToolTip.Tip="Move it to another drive. The plugin and your projects still find it where it was." />
                                                                <Button Content="Not its" Command="{Binding NotThisCommand}" IsVisible="{Binding CanRuleOut}"
                                                                        ToolTip.Tip="This folder isn't this plugin's: leave it out from now on" />
                                                            </StackPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontFamily="{DynamicResource NumberFont}" FontSize="12"
                                                                       Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding KindText}" FontSize="12.5" />
                                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                                <TextBlock Text="{Binding SharedText}" FontSize="11" Foreground="{StaticResource WarningBrush}"
                                                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding IsShared}" ToolTip.Tip="{Binding SharedText}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Installed copies">
                            <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding InstalledNote}" Classes="muted" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                           IsVisible="{Binding InstalledNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Installed}" SelectedItem="{Binding ShownCopy}" Classes="copies"
                                 Background="Transparent" MaxHeight="230" Margin="-4,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstalledPluginItem">
                                    <StackPanel Margin="0,2">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Classes="pill" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Format}" Classes="pillText" Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" ToolTip.Tip="{Binding Title}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Details}" FontSize="12" Classes="muted" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding IdText}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="The ID DAW projects save this plugin under" />
                                        <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Panel DockPanel.Dock="Top" Margin="0,12,0,6"
                               IsVisible="{Binding ShownCopy, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Panel DataContext="{Binding ShownCopy}">
                                <StackPanel x:DataType="vm:InstalledPluginItem">
                                    <TextBlock Text="PARAMETERS" Classes="filterLabel" />
                                    <TextBlock Text="{Binding ParametersNote}" Classes="muted" FontSize="12"
                                               IsVisible="{Binding ParametersNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel IsVisible="{Binding CanRead}">
                                        <Button Content="Read parameters" Margin="0,4,0,4" Command="{Binding ReadParametersCommand}" />
                                        <TextBlock Text="Loads the plugin in the scanner. Some plugins show a licence window when they load."
                                                   Classes="muted" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Panel>
                        </Panel>

                        <DataGrid ItemsSource="{Binding ShownCopy.Parameters, FallbackValue={x:Null}}" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="None" Background="Transparent"
                                  CanUserSortColumns="True"
                                  IsVisible="{Binding ShownCopy.HasParameters, FallbackValue=False}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Parameter" Width="*" Binding="{Binding Name}" x:DataType="plugins:ScannedParam" />
                                <DataGridTemplateColumn Header="Starts at" Width="120" SortMemberPath="Text">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="plugins:ScannedParam">
                                            <TextBlock Text="{Binding Display}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Range}" Foreground="{StaticResource MutedBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Panel>
        </Border>

        <GridSplitter Grid.Column="1" Width="12" Background="Transparent" ResizeDirection="Columns"
                      DragCompleted="OnSplitterMoved" ToolTip.Tip="Drag to give the list or the plugin more room" />

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- Big plugins no project has used for years: what Clean up and Uninstall could free. -->
            <Border Classes="card" Padding="16,12,6,4" Margin="0,0,0,12" IsVisible="{Binding HasCandidates}">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <StackPanel Margin="0,0,18,8" VerticalAlignment="Top" Spacing="2">
                        <TextBlock Text="You could free up" Classes="muted" FontSize="12" />
                        <TextBlock Text="{Binding FreeableText}" FontSize="24" FontWeight="SemiBold" FontFamily="{DynamicResource NumberFont}"
                                   Foreground="{StaticResource OkBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="Unused for" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{x:Static vm:PluginsViewModel.UnusedYearsChoices}" SelectedItem="{Binding UnusedYears}"
                                      ToolTip.Tip="How long since a project last used a plugin before it counts as unused">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:Int32">
                                        <TextBlock Text="{Binding StringFormat='{}{0} yr'}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Candidates}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpaceCandidate">
                                <Border Classes="tile needed" PointerPressed="OnCandidatePressed">
                                    <StackPanel Spacing="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="15" FontWeight="SemiBold" FontFamily="{DynamicResource NumberFont}"
                                                       Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Line}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                            <Button Content="Clean up…" Command="{Binding CleanUpCommand}" />
                                            <Button Content="Uninstall…" Command="{Binding UninstallCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding FreeableNote}" Classes="muted" FontSize="12" Margin="0,0,10,8" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Spare copies: plugin files in formats none of your projects use (AAX without Pro Tools, an unused VST2). -->
            <Border Classes="card" Padding="16,10,10,10" Margin="0,0,0,12" IsVisible="{Binding HasSpares}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Review…" Command="{Binding ReviewSparesCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="See each spare copy, then remove the ticked ones to the Recycle Bin" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding SpareSizeText}" FontSize="18" FontWeight="SemiBold" FontFamily="{DynamicResource NumberFont}"
                               Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SpareTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SpareNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Moved folders that need a look: their folder on the other drive went somewhere, or an update replaced the link. -->
            <Border Classes="card" Padding="16,10,10,10" Margin="0,0,0,12" IsVisible="{Binding HasLost}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Find it…" Command="{Binding FindLostCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Show where the folder is now, and the links are pointed there" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding LostText}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="The plugins can't open those sounds until the links point at the folder's new place." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Classes="card" Padding="16,10,10,10" Margin="0,0,0,12" IsVisible="{Binding HasReplaced}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Link again…" Command="{Binding LinkAgainCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Copy the new files to the other drive, then put the link back" />
                    <TextBlock Text="{Binding ReplacedText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" />
                </DockPanel>
            </Border>

            <!-- Old copies left beside folders moved to another drive, all in one place. -->
            <Border Classes="card" Padding="16,10,10,10" Margin="0,0,0,12" IsVisible="{Binding HasOldCopies}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Review…" Command="{Binding ReviewOldCopiesCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="See each old copy, then remove the ticked ones to the Recycle Bin" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding OldCopiesSizeText}" FontSize="18" FontWeight="SemiBold" FontFamily="{DynamicResource NumberFont}"
                               Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding OldCopiesTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="The folders live on another drive now. Delete these once the plugins open fine." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- What to install to open more of your old projects. -->
            <Border Classes="card" Padding="16,14,6,6" Margin="0,0,0,12" IsVisible="{Binding HasNeeded}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding HideNeededCommand}" Margin="0,0,8,0" VerticalAlignment="Top"
                                ToolTip.Tip="Hide these cards (Settings › Plugins brings them back)" />
                        <TextBlock Text="Install these to open more of your old projects" FontSize="15" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{Binding NeededSummary}" Classes="muted" FontSize="12.5" Margin="0,3,10,12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Needed}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NeededPlugin">
                                <Border Classes="tile needed" PointerPressed="OnNeededPressed">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Count}" FontSize="26" FontWeight="SemiBold" FontFamily="{DynamicResource NumberFont}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{Binding CountLabel}" Classes="muted" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Text="{Binding Details}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding OtherVersion}" Foreground="{StaticResource OkBrush}" FontSize="11.5" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasOtherVersion}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                            <Button Content="Find similar" Command="{Binding FindSimilarCommand}"
                                                    ToolTip.Tip="Installed plugins with a close name: a newer version, or the same plugin renamed" />
                                            <Button Content="Search online" Command="{Binding SearchOnlineCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SimilarNote}" Classes="muted" FontSize="11.5" Margin="0,4,0,0"
                                                   IsVisible="{Binding SimilarNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <ItemsControl ItemsSource="{Binding Similar}" IsVisible="{Binding HasSimilar}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock FontSize="11.5" TextTrimming="CharacterEllipsis">
                                                        <Run Text="Installed: " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding AllInstalled}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="✓" Foreground="{StaticResource OkBrush}" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="Every plugin your projects use is installed on this PC." VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            </StackPanel>
            </ScrollViewer>

            <ListBox Grid.Row="1" Classes="chips group" ItemsSource="{x:Static vm:PluginsViewModel.FilterChoices}" SelectedItem="{Binding Filter}" Margin="0,0,0,10">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>

            <Border Grid.Row="2" Classes="card" Padding="8,10,8,8">
                <DataGrid x:Name="PluginGrid" Classes="pageList" ItemsSource="{Binding View, Converter={StaticResource ItemsViewSource}}" views:GridSelection.Item="{Binding Selected}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserSortColumns="True"
                          GridLinesVisibility="None" Background="Transparent" DoubleTapped="OnDoubleTapped" RowHeight="46">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Plugin" Width="2*" MinWidth="180" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="lib:PluginUsage">
                                    <StackPanel Margin="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Vendor}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Vendor, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Format" Width="80" Binding="{Binding Format}" x:DataType="lib:PluginUsage" />
                        <DataGridTextColumn Header="Kind" Width="100" Binding="{Binding Kind}" x:DataType="lib:PluginUsage" />
                        <DataGridTextColumn Header="Projects" Width="80" Binding="{Binding Projects}" x:DataType="lib:PluginUsage" />
                        <DataGridTextColumn Header="Used in" Width="*" Binding="{Binding Daws}" x:DataType="lib:PluginUsage" />
                        <DataGridTextColumn Header="Last used" Width="100" Binding="{Binding LastUsedText}" SortMemberPath="LastUsed" x:DataType="lib:PluginUsage" />
                        <DataGridTemplateColumn Header="Size" Width="90" SortMemberPath="Bytes">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="lib:PluginUsage">
                                    <TextBlock Text="{Binding SizeText}" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource NumberFont}" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="90" SortMemberPath="SharedBytes">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Shared" ToolTip.Tip="Folders it shares with other plugins from its maker (a sound library several of them use). Not counted in Size." />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="lib:PluginUsage">
                                    <TextBlock Text="{Binding SharedText}" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               FontFamily="{DynamicResource NumberFont}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="150" SortMemberPath="Installed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="lib:PluginUsage">
                                    <Panel Margin="8,0" VerticalAlignment="Center">
                                        <Border Classes="pill" Background="{StaticResource OkSoftBrush}" IsVisible="{Binding InstalledInUse}">
                                            <TextBlock Text="Installed" Classes="pillText" Foreground="{StaticResource OkBrush}" />
                                        </Border>
                                        <Border Classes="pill" Background="{StaticResource WarningSoftBrush}" IsVisible="{Binding NeverUsed}"
                                                ToolTip.Tip="Installed, but not one of your projects uses it: the safest kind to clean up or uninstall">
                                            <TextBlock Text="Never used" Classes="pillText" Foreground="{StaticResource WarningBrush}" />
                                        </Border>
                                        <Border Classes="pill" Background="{StaticResource WarningSoftBrush}" IsVisible="{Binding UnusedLately}"
                                                ToolTip.Tip="No project has used it for a while, but older ones do: they'd open with it missing if it went">
                                            <TextBlock Text="Not used lately" Classes="pillText" Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !Installed}">
                                            <Border Classes="pill" Background="{StaticResource MissingSoftBrush}">
                                                <TextBlock Text="Missing" Classes="pillText" Foreground="{StaticResource MissingBrush}" />
                                            </Border>
                                            <Button Content="Search" ToolTip.Tip="Search online for it"
                                                    Command="{Binding $parent[UserControl].((vm:PluginsViewModel)DataContext).SearchOnlineCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock FontSize="12" Classes="muted" TextWrapping="Wrap" Text="{Binding ScannerNote}" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Left" Content="Measure sizes again" Command="{Binding MeasureAgainCommand}"
                            ToolTip.Tip="Measure every plugin's files, presets and sounds now. It runs in the background." />
                    <Button DockPanel.Dock="Left" Margin="6,0,0,0" Content="Recycle Bin" Command="{Binding OpenRecycleBinCommand}"
                            ToolTip.Tip="Open the Recycle Bin, where everything Clean up and Uninstall remove goes (Ctrl+Shift+Delete)" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Classes="muted" TextWrapping="Wrap" Text="{Binding SpaceNote}" />
                </DockPanel>
                <DockPanel Margin="0,8,0,0" IsVisible="{Binding CanReadAll}">
                    <Button DockPanel.Dock="Left" Content="Read all parameters" Command="{Binding ReadAllParametersCommand}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Classes="muted" TextWrapping="Wrap"
                               Text="Loads each plugin whose parameters haven't been read, four at a time. Some show a licence window as they load. Stop in the sidebar pauses it, and it carries on from there next time." />
                </DockPanel>
            </StackPanel>
        </Grid>
        </Grid>
    </DockPanel>

    <!-- The Keep or Delete card: nothing is removed until Delete (or Uninstall) is pressed here. -->
    <Border Background="#99000000" IsVisible="{Binding HasCard}">
        <Border Classes="card" MaxWidth="520" Padding="18,16" HorizontalAlignment="Center" VerticalAlignment="Center"
                DataContext="{Binding Card}" x:DataType="vm:SpaceCard">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Intro}" Classes="muted" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding Uninstallers}" SelectedItem="{Binding PickedUninstaller}" HorizontalAlignment="Stretch"
                          IsVisible="{Binding HasUninstallers}" IsEnabled="{Binding HasChoice}"
                          ToolTip.Tip="The programs Windows lists that look like this plugin's. Pick the right one if the first isn't.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="space:Uninstaller">
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding Publisher}" Foreground="{StaticResource MutedBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CleanupItem">
                            <Border Classes="row" Padding="10,8" Margin="0,0,0,6" Background="{StaticResource SurfaceRaisedBrush}"
                                    CornerRadius="{DynamicResource RadiusM}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsTicked}" IsEnabled="{Binding CanTick}" VerticalAlignment="Top" Margin="0,0,6,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontFamily="{DynamicResource NumberFont}" Margin="10,0,0,0"
                                               Foreground="{StaticResource OkBrush}" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Path}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                                        <TextBlock Text="{Binding Why}" FontSize="11.5" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                                                   IsVisible="{Binding !CanTick}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding Empty}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasEmpty}" />
                <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasWarning}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="Keep" Command="{Binding KeepCommand}" IsDefault="True" IsCancel="True" />
                    <Button Content="{Binding ConfirmText}" Classes="trouble" Command="{Binding RunCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</UserControl>
