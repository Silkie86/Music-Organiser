<!--
    Feedback that always shows, whatever Settings › Appearance › Less motion says: busy buttons, spinners, the activity
    cards and the scan ring. The movement around them is in Motion.axaml.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MusicOrganiser.Avalonia.Views">

    <!-- Every button tracks its job: while the job runs, the button dims under a spinner (Views/BusyButton.cs). -->
    <Style Selector="Button">
        <Setter Property="(views:BusyButton.Track)" Value="True" />
    </Style>
    <Style Selector="Button.busy">
        <Setter Property="Cursor" Value="Wait" />
    </Style>
    <Style Selector="Button.busy /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    </Style>

    <!-- The spinner: a turning arc, wherever the app is waiting on something. It only turns while it shows. -->
    <Style Selector="Arc.spinner">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="2.2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StartAngle" Value="0" />
        <Setter Property="SweepAngle" Value="100" />
    </Style>
    <Style Selector="Arc.spinner[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Activity cards (bottom right of the window). -->
    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusL}" />
        <Setter Property="Padding" Value="14,12,10,12" />
        <Setter Property="BoxShadow" Value="0 10 30 0 #80000000" />
    </Style>
    <Style Selector="Button.toastButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.toastButton.primary">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- The rail's scan button while scanning: a progress ring with a stop square inside. -->
    <Style Selector="Arc.ringTrack">
        <Setter Property="Stroke" Value="{DynamicResource StrokeBrush}" />
        <Setter Property="StrokeThickness" Value="2.5" />
        <Setter Property="StartAngle" Value="0" />
        <Setter Property="SweepAngle" Value="360" />
    </Style>
    <Style Selector="Arc.ring">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="2.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StartAngle" Value="-90" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="SweepAngle" Duration="0:0:0.3" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
</Styles>
