<Project Sdk="Microsoft.NET.Sdk">

  <!-- The screens' logic, with no UI framework in it, so the Windows (WPF) app and a Mac/Linux (Avalonia) app can share it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicOrganiser.Core\MusicOrganiser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MusicOrganiser" />
    <InternalsVisibleTo Include="MusicOrganiser.Avalonia" />
  </ItemGroup>

</Project>
