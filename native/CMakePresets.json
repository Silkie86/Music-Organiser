{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "description": "Scanner and CLAP probe. Builds offline.",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "release-wrappers",
      "displayName": "Release, with the VST3 and AU probe",
      "description": "Also builds the probe as VST3 (and AU on macOS). Downloads clap-wrapper and the VST3 SDK.",
      "inherits": "release",
      "cacheVariables": { "MO_PROBE_WRAPPERS": "ON" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "release-wrappers", "configurePreset": "release-wrappers", "configuration": "Release" },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "release-wrappers", "configurePreset": "release-wrappers", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
