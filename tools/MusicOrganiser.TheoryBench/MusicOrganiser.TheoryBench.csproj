<Project Sdk="Microsoft.NET.Sdk">

  <!-- Theory bench: measures the app's key finder, chord readers, fit scores and red marks on the POP909 songs, to
       check a harmony change before shipping it. See tools/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>theorybench</AssemblyName>
    <RootNamespace>MusicOrganiser.TheoryBench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MusicOrganiser.Core\MusicOrganiser.Core.csproj" />
  </ItemGroup>

</Project>
