<Project Sdk="Microsoft.NET.Sdk">

  <!-- Format Lab: a command for looking inside Bitwig and FL Studio files while working out their formats.
       See tools/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>formatlab</AssemblyName>
    <RootNamespace>MusicOrganiser.FormatLab</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MusicOrganiser.Core\MusicOrganiser.Core.csproj" />
  </ItemGroup>

</Project>
